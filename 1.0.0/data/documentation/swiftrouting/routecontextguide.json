{"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Route-Context","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ContextModel"],"title":"Route Context"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting"]]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiftRouting"}],"title":"Route Context"},"abstract":[{"text":"Learn how to pass data between routes using RouteContext.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"},{"text":" enables communication from child routes back to parent routes. Use it to pass selection results, form data, or completion signals up the navigation hierarchy.","type":"text"}]},{"text":"What is RouteContext?","level":2,"type":"heading","anchor":"What-is-RouteContext"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"RouteContext","type":"codeVoice"},{"type":"text","text":" is any type conforming to "},{"code":"Hashable & Sendable","type":"codeVoice"},{"type":"text","text":". It acts as a message that can be sent from a child route and received by any ancestor route that registered an observer."}]},{"code":["struct UserSelectionContext: RouteContext {","    let selectedUser: User","}","","struct FormCompletionContext: RouteContext {","    let formData: FormData","    let success: Bool","}"],"type":"codeListing","syntax":"swift"},{"text":"Registering Context Observers","level":2,"type":"heading","anchor":"Registering-Context-Observers"},{"text":"Using the View Modifier","level":3,"type":"heading","anchor":"Using-the-View-Modifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to observe contexts is with the "},{"type":"codeVoice","code":"routerContext"},{"type":"text","text":" modifier:"}]},{"code":["struct ParentView: View {","    @State private var selectedUser: User?","    ","    var body: some View {","        ContentView()","            .routerContext(UserSelectionContext.self) { context in","                selectedUser = context.selectedUser","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Using Router Directly","level":3,"type":"heading","anchor":"Using-Router-Directly"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For ViewModel-driven architectures, register observers via "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":":"}]},{"code":["@MainActor","final class ParentViewModel: ObservableObject {","    private let router: any RouterModel","","    init(router: any RouterModel) {","        self.router = router","    }","","    func startObservingContext() {","        router.add(context: UserSelectionContext.self) { [weak self] context in","            self?.selectedUser = context.selectedUser","        }","    }","","    func stopObservingContext() {","        router.remove(context: UserSelectionContext.self)","    }","","    deinit {","        stopObservingContext()","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In views, prefer "},{"type":"codeVoice","code":".routerContext(...)"},{"type":"text","text":" for simple cases."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" in ViewModels when context handling belongs to presentation\/business logic."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Warning: Use weak captures for class references (for example view models) to prevent retain cycles."}]}]},{"text":"Sending Context","level":2,"type":"heading","anchor":"Sending-Context"},{"type":"paragraph","inlineContent":[{"text":"From a child route, send context using ","type":"text"},{"code":"context(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"terminate(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"text":"context(_:) - Send Without Navigation","level":3,"type":"heading","anchor":"context-Send-Without-Navigation"},{"type":"paragraph","inlineContent":[{"text":"Sends the context to all observers without affecting navigation:","type":"text"}]},{"code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context but stay on this screen","                router.context(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"terminate(_:) - Send and Complete Navigation","level":3,"type":"heading","anchor":"terminate-Send-and-Complete-Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sends the context, then completes navigation based on router state:"}]},{"code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context and complete the current flow","                router.terminate(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"terminate(_:)"},{"text":" will:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Execute all matching context observers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a matching local context anchor is found, pop back to that point in the current stack"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Otherwise, close the modal if the router is presented"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise, go back one step"}]}]}],"type":"orderedList"},{"text":"Context Hierarchy","level":2,"type":"heading","anchor":"Context-Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Contexts propagate up through the entire router hierarchy:"}]},{"code":["App Router","    └── Tab Router","            └── Home Router (observer registered here)","                    └── List Router","                            └── Detail Router (context sent from here)"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"When context is sent from Detail Router, it reaches the observer in Home Router.","type":"text"}]},{"text":"Checking for Observers Before Terminating","level":2,"type":"heading","anchor":"Checking-for-Observers-Before-Terminating"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" always performs a navigation action (pop to context, close, or back), even if"},{"type":"text","text":" "},{"type":"text","text":"nobody actually observes the context — it can’t tell you in advance whether the payload will"},{"type":"text","text":" "},{"type":"text","text":"reach a listener. Use "},{"type":"codeVoice","code":"canTerminate(_:)"},{"type":"text","text":" to check first, for example to disable a “Confirm”"},{"type":"text","text":" "},{"type":"text","text":"button when no parent screen registered an observer:"}]},{"code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","","    var body: some View {","        List(users) { user in","            Button(user.name) {","                router.terminate(UserSelectionContext(selectedUser: user))","            }","            .disabled(!router.canTerminate(UserSelectionContext.self))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"canTerminate(_:)"},{"text":" searches the same hierarchy as ","type":"text"},{"type":"codeVoice","code":"context(_:)"},{"text":" — the current router and every","type":"text"},{"text":" ","type":"text"},{"text":"ancestor — without executing anything.","type":"text"}]},{"text":"Removing Observers","level":2,"type":"heading","anchor":"Removing-Observers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observers are automatically removed when their route is popped. You can also remove them manually:"}]},{"code":["router.remove(context: UserSelectionContext.self)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(context:)"},{"type":"text","text":" removes observers for that context type "},{"type":"strong","inlineContent":[{"type":"text","text":"only on the current route"}]},{"type":"text","text":"."}]},{"text":"Common Patterns","level":2,"type":"heading","anchor":"Common-Patterns"},{"text":"Selection Flow","level":3,"type":"heading","anchor":"Selection-Flow"},{"code":["\/\/ Parent: Start selection","router.push(HomeRoute.userPicker)","","\/\/ Parent: Receive selection",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child: Complete selection","router.terminate(UserSelectionContext(selectedUser: user))"],"type":"codeListing","syntax":"swift"},{"text":"Form Completion","level":3,"type":"heading","anchor":"Form-Completion"},{"code":["\/\/ Parent",".routerContext(FormCompletionContext.self) { context in","    if context.success {","        showSuccessMessage()","    }","}","","\/\/ Child (form view)","func submitForm() async {","    let success = await api.submit(formData)","    router.terminate(FormCompletionContext(formData: formData, success: success))","}"],"type":"codeListing","syntax":"swift"},{"text":"Multi-Step Wizard","level":3,"type":"heading","anchor":"Multi-Step-Wizard"},{"code":["struct WizardContext: RouteContext {","    let step: Int","    let data: WizardData","}","","\/\/ Each step sends progress","router.context(WizardContext(step: currentStep, data: collectedData))","","\/\/ Final step terminates","router.terminate(WizardContext(step: finalStep, data: completeData))"],"type":"codeListing","syntax":"swift"},{"text":"Memory Management","level":2,"type":"heading","anchor":"Memory-Management"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Context closures can cause retain cycles. Always use weak references:"}]},{"code":["\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handleContext(context)","}","","\/\/ ✅ Correct with view model",".routerContext(MyContext.self) { [weak viewModel] context in","    viewModel?.process(context)","}","","\/\/ ❌ Wrong for class references - causes retain cycle","router.add(context: MyContext.self) { context in","    self.handleContext(context)  \/\/ Strong reference to self","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/routecontextguide"]}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"url":"\/documentation\/swiftrouting\/faq","title":"FAQ","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","type":"topic","abstract":[{"type":"text","text":"Answers to common questions about SwiftRouting usage and design decisions."}],"role":"collectionGroup","kind":"article"},"doc://SwiftRouting/documentation/SwiftRouting/ContextModel":{"navigatorTitle":[{"kind":"identifier","text":"ContextModel"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ContextModel","abstract":[{"text":"Defines context observation capabilities for router types.","type":"text"}],"kind":"symbol","type":"topic","title":"ContextModel","role":"symbol","url":"\/documentation\/swiftrouting\/contextmodel","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContextModel"}]},"doc://SwiftRouting/documentation/SwiftRouting/RouteContext":{"type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","kind":"symbol","abstract":[{"text":"A type that can be used to pass data between routes and trigger navigation flow completions.","type":"text"}],"role":"symbol","title":"RouteContext","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouteContext"}],"url":"\/documentation\/swiftrouting\/routecontext","navigatorTitle":[{"kind":"identifier","text":"RouteContext"}]},"doc://SwiftRouting/documentation/SwiftRouting/Troubleshooting":{"kind":"article","role":"collectionGroup","abstract":[{"text":"Diagnose and fix common issues encountered when using SwiftRouting.","type":"text"}],"url":"\/documentation\/swiftrouting\/troubleshooting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting","type":"topic","title":"Troubleshooting"},"doc://SwiftRouting/documentation/SwiftRouting":{"title":"SwiftRouting","role":"collection","url":"\/documentation\/swiftrouting","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","abstract":[{"type":"text","text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI."}]}}}