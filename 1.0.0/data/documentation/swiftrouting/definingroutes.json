{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Routes are the foundation of SwiftRouting. They define all possible navigation destinations in your app as type-safe Swift enums."}],"type":"paragraph"},{"level":2,"anchor":"Creating-a-Route-Enum","type":"heading","text":"Creating a Route Enum"},{"inlineContent":[{"text":"A route is any enum that conforms to the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route"},{"text":" protocol. Each case represents a distinct screen or destination.","type":"text"}],"type":"paragraph"},{"code":["enum HomeRoute: Route {","    case home","    case profile(userId: String)","    case settings","    case detail(item: Item)","    ","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let userId): \"profile(\\(userId))\"","        case .settings: \"settings\"","        case .detail(let item): \"detail(\\(item.id))\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"The-name-Property","type":"heading","text":"The name Property"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" property provides a human-readable identifier used for:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Logging and debugging"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Router identification","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Analytics tracking","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Include relevant associated values in the name to make logs more informative."}],"type":"paragraph"},{"level":2,"anchor":"Mapping-Routes-to-Views","type":"heading","text":"Mapping Routes to Views"},{"inlineContent":[{"text":"Conform your route to ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","isActive":true,"type":"reference"},{"text":" to define which view each route displays:","type":"text"}],"type":"paragraph"},{"code":["extension HomeRoute: RouteDestination {","    static func view(for route: HomeRoute) -> some View {","        switch route {","        case .home:","            HomeView()","        case .profile(let userId):","            ProfileView(userId: userId)","        case .settings:","            SettingsView()","        case .detail(let item):","            DetailView(item: item)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Nested-Routes-and-Nested-Destinations","type":"heading","text":"Nested Routes and Nested Destinations"},{"inlineContent":[{"type":"text","text":"For larger apps, you can model feature subflows as nested routes."},{"type":"text","text":" "},{"type":"text","text":"Keep the top-level route as the destination entry point, and render child routes through dedicated destination views."}],"type":"paragraph"},{"code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home:","            \"home\"","        case .profile(let child):","            \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview:","            \"overview\"","        case .edit(let userId):","            \"edit(\\(userId))\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Map from the top-level destination:","type":"text"}],"type":"paragraph"},{"code":["extension AppRoute: RouteDestination {","    static func view(for route: AppRoute) -> some View {","        switch route {","        case .home:","  