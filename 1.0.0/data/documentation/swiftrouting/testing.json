{"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"],"title":"Related","anchor":"Related"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftRouting is designed with testability in mind. The protocol-based architecture allows you to mock routers and verify navigation behavior without running UI tests."}],"type":"paragraph"},{"text":"Testing Strategies","anchor":"Testing-Strategies","level":2,"type":"heading"},{"text":"Strategy 1: RouterSpy","anchor":"Strategy-1-RouterSpy","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" has grown a fair amount of surface (push, present, cover, context handling, split selections…), so hand-rolling a mock for every test is tedious and easy to let drift out of sync with the protocol. Add the companion package instead:"}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"1.0.0\"))","]"],"type":"codeListing"},{"syntax":"swift","code":[".product(name: \"SwiftRoutingTestSupport\", package: \"swift-routing\")"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"RouterSpy"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"RouterModel"},{"text":" and records every call instead of performing real navigation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftRoutingTestSupport","","let spy = RouterSpy(root: AppRoute.home)","spy.push(AppRoute.profile(userId: \"123\"))","","#expect(spy.pushedRoutes.count == 1)","#expect((spy.pushedRoutes.first as? AppRoute) == .profile(userId: \"123\"))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"routedDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"popCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeChildrenCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"terminatedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"dispatchedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"addedContextTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"removedContextTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"detailSelections"},{"type":"text","text":", "},{"type":"codeVoice","code":"contentSelections"},{"type":"text","text":" — plus live "},{"type":"codeVoice","code":"currentRoute"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"pathCount"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"detailSelection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"contentSelection"},{"type":"text","text":" that update as calls happen."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tabRouter(for:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"findRouterInTabRouter(for:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"deepestRouter()"},{"text":" always return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"RouterSpy"},{"text":" — there’s no real router hierarchy behind it. Test code that depends on those against a real ","type":"text"},{"type":"codeVoice","code":"Router"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Strategy 2: Test ViewModel Navigation","anchor":"Strategy-2-Test-ViewModel-Navigation","level":3,"type":"heading"},{"inlineContent":[{"text":"Inject the spy into your ViewModel:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","final class ProfileViewModel {","    private let router: any RouterModel","    private let userId: String","    ","    init(router: any RouterModel, userId: String) {","        self.router = router","        self.userId = userId","    }","    ","    func editProfile() {","        router.push(ProfileRoute.edit(userId: userId))","    }","    ","    func openSettings() {","        router.present(ProfileRoute.settings)","    }","    ","    func logout() {","        router.popToRoot()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Test the navigation behavior:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Testing","","@Suite(\"ProfileViewModel Navigation\")","struct ProfileViewModelTests {","    ","    @Test","    @MainActor","    func editProfile_pushesEditRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.editProfile()","        ","        #expect(spy.pushedRoutes.count == 1)","        let pushedRoute = spy.pushedRoutes.first as? ProfileRoute","        #expect(pushedRoute == .edit(userId: \"123\"))","    }","    ","    @Test","    @MainActor","    func openSettings_presentsSettingsRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.openSettings()","        ","        #expect(spy.presentedRoutes.count == 1)","        let presentedRoute = spy.presentedRoutes.first?.route as? ProfileRoute","        #expect(presentedRoute == .settings)","    }","    ","    @Test","    @MainActor","    func logout_popsToRoot() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.logout()","        ","        #expect(spy.popToRootCallCount == 1)","    }","}"],"type":"codeListing"},{"text":"Testing RouteContext","anchor":"Testing-RouteContext","level":2,"type":"heading"},{"text":"Testing Context Sending","anchor":"Testing-Context-Sending","level":3,"type":"heading"},{"syntax":"swift","code":["@Test","@MainActor","func selectUser_terminatesWithContext() {","    let spy = RouterSpy(root: AppRoute.userPicker)","    let viewModel = UserPickerViewModel(router: spy)","    let user = User(id: \"1\", name: \"John\")","    ","    viewModel.selectUser(user)","    ","    #expect(spy.terminatedContexts.count == 1)","    let context = spy.terminatedContexts.first as? UserSelectionContext","    #expect(context?.selectedUser.id == \"1\")","}"],"type":"codeListing"},{"text":"Testing Context Reception","anchor":"Testing-Context-Reception","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For testing context handlers, use a real "},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"syntax":"swift","code":["@Test","@MainActor","func contextHandler_receivesContext() async {","    let router = Router(configuration: .default)","    var receivedUser: User?","    ","    router.add(context: UserSelectionContext.self) { context in","        receivedUser = context.selectedUser","    }","    ","    let user = User(id: \"1\", name: \"John\")","    router.context(UserSelectionContext(selectedUser: user))","    ","    #expect(receivedUser?.id == \"1\")","}"],"type":"codeListing"},{"text":"Testing Deep Links","anchor":"Testing-Deep-Links","level":2,"type":"heading"},{"text":"Testing DeeplinkHandler","anchor":"Testing-DeeplinkHandler","level":3,"type":"heading"},{"syntax":"swift","code":["struct TestDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias D = AppRoute","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let userId):","            return .push(.profile(userId: userId))","        case .settings:","            return .present(.settings)","        default:","            return nil","        }","    }","}","","@Suite(\"DeeplinkHandler\")","struct DeeplinkHandlerTests {","    ","    @Test","    func homeIdentifier_returnsPushHome() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .home)","        ","        #expect(deeplink?.route == .home)","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func profileIdentifier_returnsPushWithUserId() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .profile(userId: \"123\"))","        ","        #expect(deeplink?.route == .profile(userId: \"123\"))","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func settingsIdentifier_returnsPresent() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .settings)","        ","        #expect(deeplink?.route == .settings)","        #expect(deeplink?.type == .sheet(withStack: true))","    }","    ","    @Test","    func unknownIdentifier_returnsNil() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .unknown)","        ","        #expect(deeplink == nil)","    }","}"],"type":"codeListing"},{"text":"Testing DeeplinkRoute Factories","anchor":"Testing-DeeplinkRoute-Factories","level":3,"type":"heading"},{"syntax":"swift","code":["@Suite(\"DeeplinkRoute Factories\")","struct DeeplinkRouteFactoryTests {","    ","    @Test","    func push_createsCorrectDeeplink() {","        let deeplink: DeeplinkRoute<AppRoute> = .push(.home, path: [.list])","        ","        #expect(deeplink.route == .home)","        #expect(deeplink.type == .push)","        #expect(deeplink.path.count == 1)","    }","    ","    @Test","    func popToRoot_hasNilRoute() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot()","        ","        #expect(deeplink.route == nil)","    }","    ","    @Test","    func popToRootWithRoot_setsRoot() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot(root: .dashboard)","        ","        #expect(deeplink.root == .dashboard)","        #expect(deeplink.route == nil)","    }","}"],"type":"codeListing"},{"text":"Testing TabRouter Navigation","anchor":"Testing-TabRouter-Navigation","level":2,"type":"heading"},{"inlineContent":[{"code":"TabRouterSpy","type":"codeVoice"},{"text":", from the same ","type":"text"},{"code":"SwiftRoutingTestSupport","type":"codeVoice"},{"text":" package, conforms to ","type":"text"},{"code":"TabRouterModel","type":"codeVoice"},{"text":" the same way:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftRoutingTestSupport","","@Test","@MainActor","func crossTabNavigation_pushesToCorrectTab() {","    let spy = TabRouterSpy(root: AppRoute.home)","    let viewModel = HomeViewModel(tabRouter: spy)","    ","    viewModel.goToProfile(userId: \"123\")","    ","    #expect(spy.pushedRoutes.count == 1)","    let call = spy.pushedRoutes.first","    #expect((call?.route as? AppRoute) == .profile(userId: \"123\"))","    #expect((call?.tab as? AppTab) == .profile)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"changedTabs"},{"type":"text","text":", "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootTabs"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Best Practices","anchor":"Best-Practices","level":2,"type":"heading"},{"text":"Use Protocol Types","anchor":"Use-Protocol-Types","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Always inject "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" or "},{"type":"codeVoice","code":"any TabRouterModel"},{"type":"text","text":" instead of concrete types:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Good: Protocol type enables mocking","init(router: any RouterModel) { ... }","","\/\/ Avoid: Concrete type is harder to test","init(router: Router) { ... }"],"type":"codeListing"},{"text":"Test Navigation Intent, Not Implementation","anchor":"Test-Navigation-Intent-Not-Implementation","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Focus on "},{"type":"emphasis","inlineContent":[{"type":"text","text":"what"}]},{"type":"text","text":" navigation should happen, not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"how"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Good: Tests the intent","#expect(spy.pushedRoutes.contains { ($0 as? AppRoute) == .profile(userId: \"123\") })","","\/\/ Avoid: Testing implementation details","#expect(spy.pathCount == 2)"],"type":"codeListing"},{"text":"Prefer RouterSpy Over Hand-Rolled Mocks","anchor":"Prefer-RouterSpy-Over-Hand-Rolled-Mocks","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"TabRouterModel"},{"type":"text","text":" have grown a fair amount of surface, and a hand-rolled mock silently drifts out of sync every time the protocol changes. "},{"type":"codeVoice","code":"RouterSpy"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"TabRouterSpy"},{"type":"text","text":" are tested against the real protocols, so use them instead of writing your own unless a test needs custom behavior a spy can’t express."}],"type":"paragraph"},{"text":"Test Async Handlers","anchor":"Test-Async-Handlers","level":3,"type":"heading"},{"inlineContent":[{"text":"Deep link handlers are async. Use Swift Testing’s async support:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Test","func asyncDeeplinkHandler() async throws {","    let handler = MyDeeplinkHandler()","    let result = try await handler.deeplink(from: .someIdentifier)","    #expect(result != nil)","}"],"type":"codeListing"}],"kind":"content"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftRouting"}],"title":"Testing Navigation"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/testing"]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Testing","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"sections":[],"abstract":[{"type":"text","text":"Learn how to write unit tests for your navigation logic."}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/DeeplinkHandler":{"title":"DeeplinkHandler","url":"\/documentation\/swiftrouting\/deeplinkhandler","navigatorTitle":[{"text":"DeeplinkHandler","kind":"identifier"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","role":"symbol","fragments":[{"text":"protocol",