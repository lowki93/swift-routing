 id)","        default:","            return nil","        }","    }","}","","struct HomeDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkIdentifier","    typealias D = HomeRoute","","    func deeplink(from route: AppDeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","        switch route {","        case .detail(let id):","            return .push(.detail(id: id))","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Parse the URL into the identifier inside "},{"type":"codeVoice","code":".onOpenURL"},{"type":"text","text":", then pass it to the handler:"}]},{"syntax":"swift","code":["struct HomeRootView: View {","    @Environment(\\.router) private var router","    let handler = HomeDeeplinkHandler()","","    var body: some View {","        HomeView()","            .onOpenURL { url in","                Task {","                    guard let identifier = AppDeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try? await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks"},{"type":"text","text":" for advanced patterns including path building, async data fetching, and tab-aware deep linking."}]},{"text":"Dismissing Modals","type":"heading","level":2,"anchor":"Dismissing-Modals"},{"text":"Before","type":"heading","level":3,"anchor":"Before"},{"syntax":"swift","code":["@Environment(\\.dismiss) private var dismiss","","Button(\"Close\") {","    dismiss()","}"],"type":"codeListing"},{"text":"After","type":"heading","level":3,"anchor":"After"},{"syntax":"swift","code":["@Environment(\\.router) private var router","","Button(\"Close\") {","    router.close