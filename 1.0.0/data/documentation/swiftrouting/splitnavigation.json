{"abstract":[{"text":"Learn how to implement sidebar-based split navigation with SwiftRouting.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitNavigation","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"metadata":{"title":"Split Navigation","role":"article","roleHeading":"Article","modules":[{"name":"SwiftRouting"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"],"generated":true,"anchor":"Split-Navigation","title":"Split Navigation"}],"variants":[{"paths":["\/documentation\/swiftrouting\/splitnavigation"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"},{"type":"text","text":". All three columns (sidebar, content, detail) share the same split-type "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" — column selection is driven by typed, "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values, and only the detail column has a navigation stack, bound directly to that shared router’s "},{"type":"codeVoice","code":"path"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A split-type ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"text":" is created automatically and injected into the environment via ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.router)"},{"text":". It conforms to ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel","type":"reference","isActive":true},{"text":", giving you typed bindings and programmatic selection alongside the regular ","type":"text"},{"type":"codeVoice","code":"push"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"present"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"cover"},{"text":" API.","type":"text"}],"type":"paragraph"},{"level":2,"text":"2-Column Layout (Sidebar + Detail)","anchor":"2-Column-Layout-Sidebar-+-Detail","type":"heading"},{"inlineContent":[{"text":"The sidebar shows a fixed route; the detail column is derived from a typed selection:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","}"]},{"level":2,"text":"3-Column Layout (Sidebar + Content + Detail)","anchor":"3-Column-Layout-Sidebar-+-Content-+-Detail","type":"heading"},{"inlineContent":[{"type":"text","text":"Add a "},{"code":"content:","type":"codeVoice"},{"type":"text","text":" closure to introduce a middle column. The sidebar drives the content column, and the content column drives the detail column:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","} detail: { (player: Player) in","    AppRoute.player(player)","}"]},{"level":2,"text":"Driving Selections","anchor":"Driving-Selections","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/detailBinding(as:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/contentBinding(as:)","isActive":true},{"type":"text","text":" to wire a "},{"type":"codeVoice","code":"List"},{"type":"text","text":" selection directly, or call "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(content:)","isActive":true},{"type":"text","text":" programmatically. Both paths behave identically – the binding calls "},{"type":"codeVoice","code":"select(detail:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"select(content:)"},{"type":"text","text":" internally, so a selection made by tapping a "},{"type":"codeVoice","code":"List"},{"type":"text","text":" row logs a "},{"type":"codeVoice","code":".navigation"},{"type":"text","text":" event just like a programmatic call would."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SidebarScreen: View {","    @Environment(\\.router) var router","    let items: [PlayerType] = PlayerType.allCases","","    var body: some View {","        List(items, selection: router.detailBinding(as: PlayerType.self)) { item in","            NavigationLink(item.label, value: item)","        }","        .onFirstAppear {","            guard !router.isCompact else { return }","            router.select(detail: items.first)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/hasContentColumn"},{"type":"text","text":" to branch between driving the content or the detail column from the same sidebar code path:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if router.hasContentColumn {","    router.select(content: playerType)","} else {","    router.select(detail: playerType)","}"]},{"level":2,"text":"Compact Mode (iPhone)","type":"heading","anchor":"Compact-Mode-iPhone"},{"inlineContent":[{"text":"On iPhone, ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" collapses into a single-column stack. Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/isCompact","type":"reference","isActive":true},{"text":" to skip auto-selection and let the user tap to navigate instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onFirstAppear {","    guard !router.isCompact else { return }","    router.select(detail: items.first)","}"]},{"inlineContent":[{"type":"codeVoice","code":"isCompact"},{"text":" reflects ","type":"text"},{"type":"codeVoice","code":"horizontalSizeClass"},{"text":", so it also updates during iPad multitasking.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Navigating Within a Column","type":"heading","anchor":"Navigating-Within-a-Column"},{"inlineContent":[{"type":"codeVoice","code":"router.push(_:)"},{"type":"text","text":" works like everywhere else in SwiftRouting, but since all columns share the same split "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":", it always pushes onto the one navigation stack — rendered only in the detail column. Pushing from the sidebar or content column doesn’t open a stack there; it appears in the detail column instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"router.present(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".cover(_:)"},{"type":"text","text":" are also router-wide, not per-column: calling them from any column presents the same sheet\/cover over the whole "},{"type":"codeVoice","code":"RoutingSplitView"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Deep-Linking","text":"Deep Linking","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplinkHandler","isActive":true},{"type":"text","text":" to convert an external input into a "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplink","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/handle(splitDeeplink:)","isActive":true},{"type":"text","text":" to apply it:"}]},{"syntax":"swift","type":"codeListing","code":["struct PlayerSplitDeeplinkHandler: SplitDeeplinkHandler {","    func deeplink(from route: DeeplinkIdentifier) async throws -> SplitDeeplink<PlayerType, Player, AppRoute>? {","        switch route {","        case .player(let player):","            SplitDeeplink(content: player.type, detail: player)","        default:","            nil","        }","    }","}","","router.handle(splitDeeplink: splitDeeplink)"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handle(splitDeeplink:)"},{"type":"text","text":" selects "},{"type":"codeVoice","code":"content"},{"type":"text","text":" (3-column layout only), then "},{"type":"codeVoice","code":"detail"},{"type":"text","text":", then applies the optional "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" within the detail column’s own navigation stack — the content column has no stack of its own, so "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" can only push into "},{"type":"codeVoice","code":"detail"},{"type":"text","text":"."}]},{"anchor":"SplitModel-Reference","text":"SplitModel Reference","type":"heading","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text"