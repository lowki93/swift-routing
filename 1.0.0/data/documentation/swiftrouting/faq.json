{"abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"topicSections":[{"title":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics"],"anchor":"Related"}],"variants":[{"paths":["\/documentation\/swiftrouting\/faq"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftRouting"}],"roleHeading":"API Collection","title":"FAQ","role":"collectionGroup"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This article addresses frequently asked questions about routing patterns, API choices, and known limitations."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"anchor":"When-should-I-use-sheet-vs-cover","text":"When should I use sheet vs cover?","type":"heading"},{"inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"present(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cover(_:)"},{"text":" create a child router and present a modal, but they differ in appearance and dismissal behavior:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"present(_:)"}]}],[{"type":"paragraph","inlineContent":[{"code":"cover(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"SwiftUI modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":".sheet","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".fullScreenCover","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Appearance"}]}],[{"type":"paragraph","inlineContent":[{"text":"Partial screen, card style","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full screen","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss gesture"}]}],[{"type":"paragraph","inlineContent":[{"text":"Swipe down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not dismissable by gesture"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Use case","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quick actions, pickers, forms"}]}],[{"type":"paragraph","inlineContent":[{"text":"Onboarding, auth, immersive flows","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"present(_:)"},{"text":" when:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The user needs to stay aware of the context behind (e.g. selecting an item from a list)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow is short and dismissable (form, picker, confirmation)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"cover(_:)"},{"type":"text","text":" when:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow takes over the full experience (onboarding, login, camera)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"You want to prevent accidental swipe-to-dismiss"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both support navigation stacks inside them via the "},{"code":"withStack","type":"codeVoice"},{"type":"text","text":" parameter on "},{"code":"present(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Sheet with its own NavigationStack (default)","router.present(AppRoute.form)","","\/\/ Sheet without a NavigationStack (single view only)","router.present(AppRoute.form, withStack: false)","","\/\/ Full-screen cover (always has its own stack)","router.cover(AppRoute.onboarding)"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"anchor":"How-do-I-share-a-router-between-views","text":"How do I share a router between views?","type":"heading"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","type":"reference"},{"text":" for accessing the router via ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.router)"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DefiningRoutes","type":"reference"},{"text":" for injecting it into ViewModels via a ","type":"text"},{"type":"codeVoice","code":"RouteDestination"},{"text":" wrapper.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"anchor":"Why-use-RouteContext-instead-of-callbacks","text":"Why use RouteContext instead of callbacks?","type":"heading"},{"inlineContent":[{"type":"text","text":"Callbacks (closures passed as parameters) are a common pattern for passing data back from a child view, but they come with drawbacks in a deep navigation hierarchy:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Callbacks:"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Every layer must forward the closure manually","router.push(AppRoute.picker(onSelect: { user in","    self.selectedUser = user","}))"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Couples the route to the callback signature"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Must be threaded through every intermediate view"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hard to refactor when the hierarchy changes"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"RouteContext:"}]}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Parent registers once",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child sends when done, regardless of depth","router.terminate(UserSelectionContext(selectedUser: user))"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Decoupled: sender and receiver don’t reference each other"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Propagates up through the entire router hierarchy automatically"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Works the same whether the child is one or five levels deep","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" to handle both data passing and navigation in one call"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use callbacks for simple, same-level communication. Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","isActive":true,"type":"reference"},{"text":" when data needs to travel up multiple levels or when the navigation flow should complete on context delivery.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"anchor":"Known-Limitations-and-Unsupported-Cases","text":"Known Limitations and Unsupported Cases","type":"heading"},{"level":3,"anchor":"Multiple-simultaneous-modals","text":"Multiple simultaneous modals","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftRouting supports one sheet or cover at a time per router. Presenting a second modal while one is already active is not supported and will replace the current presentation."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ ❌ Unsupported — only one modal per router at a time","router.present(AppRoute.sheet1)","router.present(AppRoute.sheet2) \/\/ replaces sheet1"],"type":"codeListing"},{"level":3,"anchor":"Mixing-route-types-across-RoutingView-boundaries","text":"Mixing route types across RoutingView boundaries","type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference","isActive":true},{"type":"text","text":" is bound to a single "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","type":"reference","isActive":true},{"type":"text","text":" type. You cannot push a route from one enum into a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":" configured for another."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ ❌ Wrong — SettingsRoute pushed into a HomeRoute RoutingView","router.push(SettingsRoute.profile)"],"type":"codeListing"},{"level":3,"anchor":"Back-navigation-with-a-count-greater-than-the-stack-size","text":"Back navigation with a count greater than the stack size","type":"heading"},{"inlineContent":[{"type":"text","text":"Calling "},{"type":"codeVoice","code":"pop()"},{"type":"text","text":" on an empty stack or with a count exceeding the current path length has no effect. SwiftRouting does not crash in this case, but the navigation state is unchanged."}],"type":"paragraph"},{"level":3,"anchor":"RouteContext-across-router-instances","text":"RouteContext across router instances","type":"heading"},{"inlineContent":[{"code":"RouteContext","type":"codeVoice"},{"type":"text","text":" propagates up through the "},{"inlineContent":[{"type":"text","text":"parent router hierarchy"}],"type":"strong"},{"type":"text","text":" only. It cannot