:"SwiftRouting","role":"collection","url":"\/documentation\/swiftrouting","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","abstract":[{"type":"text","text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI."}]}}}