{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftRouting provides a flexible deep linking system through "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","isActive":true},{"type":"text","text":"."}]},{"anchor":"Creating-a-Deeplink-Handler","type":"heading","level":2,"text":"Creating a Deeplink Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler"},{"type":"text","text":" to convert incoming URLs or identifiers into navigation routes:"}]},{"syntax":"swift","type":"codeListing","code":["struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier  \/\/ Your input type","    typealias D = HomeRoute           \/\/ Your route type","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","        switch route {","        case .home:","            return .push(.home)","            ","        case .userProfile(let userId):","            return .push(.profile(userId: userId))","            ","        case .settings:","            return .present(.settings)","            ","        case .reset:","            return .popToRoot()","            ","        default:","            return nil","        }","    }","}"]},{"anchor":"Choosing-the-Right-Factory","type":"heading","level":3,"text":"Choosing the Right Factory"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Scenario","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Factory"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Navigate to a screen in the stack","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".push(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Show a modal sheet"}],"type":"paragraph"}],[{"inlineContent":[{"code":".present(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Show a full-screen modal","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".cover(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Reset navigation (logout, clear state)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".popToRoot()","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Change root without clearing stack","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".updateRoot(_:)"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"DeeplinkRoute-Structure","type":"heading","level":2,"text":"DeeplinkRoute Structure"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"type":"text","text":" defines how to navigate to a destination. Use factory methods for common scenarios:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Push a route onto the navigation stack",".push(.detail(id: 1))","","\/\/ Push with intermediate routes (builds navigation hierarchy)",".push(.detail(id: 1), path: [.list, .category(id: 5)])","","\/\/ Push with a new root",".push(.detail(id: 1), root: .home, path: [.list])","","\/\/ Present as a sheet",".present(.settings)",".present(.settings, withStack: false)  \/\/ Without navigation stack","","\/\/ Present as a full-screen cover",".cover(.onboarding)","","\/\/ Reset navigation without navigating to a new route",".popToRoot()",".popToRoot(root: .home)  \/\/ Reset and update root","","\/\/ Update root without additional navigation",".updateRoot(.dashboard)"]},{"anchor":"Factory-Methods","type":"heading","level":3,"text":"Factory Methods"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push(_:root:path:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Push a route onto the navigation stack"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".present(_:withStack:root:path:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present as a sheet"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".cover(_:root:path:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present as a full-screen cover"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popToRoot(root:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset navigation to root (no final route)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".updateRoot(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace the root route only"}]}]]],"header":"row"},{"anchor":"Parameters","type":"heading","level":3,"text":"Parameters"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"root"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optional route to set as the new root (default: ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Presentation type for the final route: ","type":"text"},{"type":"codeVoice","code":".push"},{"text":", ","type":"text"},{"type":"codeVoice","code":".sheet(withStack:)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".cover"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"route"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optional final destination route (default: ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for reset scenarios)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"path","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Array of intermediate routes to push first (default: "},{"type":"codeVoice","code":"[]"},{"type":"text","text":")"}]}]]],"header":"row"},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (e.g., with ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":"), the final navigation step is skipped. The ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" parameter is set automatically by factory methods.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"Handling-Deep-Links","type":"heading","level":2,"text":"Handling Deep Links"},{"type":"paragraph","inlineContent":[{"text":"Use the router’s ","type":"text"},{"code":"handle(deeplink:)","type":"codeVoice"},{"text":" method:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    var body: some View {","        RoutingView(destination: HomeRoute.self, root: .home) {","            HomeRootView()","        }","    }","}","","struct HomeRootView: View {","    @Environment(\\.router) private var router","    let handler = AppDeeplinkHandler()","","    var body: some View {","        HomeView()","            .onOpenURL { url in","                Task {","                    guard let identifier = DeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"The route type returned by ","type":"text"},{"code":"DeeplinkHandler","type":"codeVoice"},{"text":" (","type":"text"},{"code":"D","type":"codeVoice"},{"text":") must match the route type used by ","type":"text"},{"code":"RoutingView(destination:root:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"What-handledeeplink-Does","type":"heading","level":3,"text":"What handle(deeplink:) Does"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Closes all presented modals (","type":"text"},{"code":"closeChildren()","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pops to the root (","type":"text"},{"code":"popToRoot()","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optionally updates the root route (if ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" is set)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pushes intermediate routes from "},{"type":"codeVoice","code":"path"}]}]},{"content":[{"inlineContent":[{"text":"Navigates to the final route with the specified type (only if ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Step 5 is skipped when "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", making "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" and "},{"type":"codeVoice","code":".updateRoot(_:)"},{"type":"text","text":" useful for reset scenarios without a final destination."}]}],"style":"note","type":"aside","name":"Note"},{"anchor":"Complete-Example","type":"heading","level":3,"text":"Complete Example"},{"syntax":"swift","type":"codeListing","code":["\/\/ Deep link: reset to dashboard, build path, then push detail as sheet",".present(","    .orderDetail(id: orderId),","    root: .dashboard,","    path: [.orders, .orderList]",")"]},{"type":"paragraph","inlineContent":[{"text":"This will:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Close any presented modals"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pop to root"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":".dashboard"},{"type":"text","text":" as the new root"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Push "},{"type":"codeVoice","code":".orders"},{"type":"text","text":" then "},{"type":"codeVoice","code":".orderList"},{"type":"text","text":" onto the stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present ","type":"text"},{"code":".orderDetail(id:)","type":"codeVoice"},{"text":" as a sheet","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Async-Deep-Link-Handling","type":"heading","level":2,"text":"Async Deep Link Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"deeplink(from:)"},{"type":"text","text":" method is "},{"type":"codeVoice","code":"async"},{"type":"text","text":", allowing you to fetch data before navigation:"}]},{"syntax":"swift","type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    switch route {","    case .product(let productId):","        \/\/ Fetch product details before navigating","        let product = try await productService.fetch(id: productId)","        return .push(.productDetail(product))","        ","    case .user(let userId):","        \/\/ Validate user exists","        guard await userService.exists(id: userId) else {","            return nil  \/\/ Return nil to ignore invalid deep links","        }","        return .push(.profile(userId: userId))","        ","    default:","        return nil","    }","}"]},{"anchor":"Composing-Deeplink-Handlers-Nested-Route-Logic","type":"heading","level":2,"text":"Composing Deeplink Handlers (Nested Route Logic)"},{"type":"paragraph","inlineContent":[{"text":"For larger apps, compose deep link handling by feature instead of keeping all cases in one switch.","type":"text"},{"text":" ","type":"text"},{"text":"This works well with nested route structures.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let child): \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview: \"overview\"","        case .edit(let userId): \"edit(\\(userId))\"","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create feature-level handlers:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["enum ProfileDeeplinkID: Hashable, Sendable {","    case profile(userId: String)","    case editProfile(userId: String)","}","","struct ProfileDeeplinkHandler: DeeplinkHandler {","    typealias R = ProfileDeeplinkID","    typealias D = AppRoute","","    func deeplink(from route: ProfileDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .profile(let userId):","            return .push(.profile(.overview), path: [.home])","        case .editProfile(let userId):","            return .push(.profile(.edit(userId: userId)))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Then compose at the app level:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["enum AppDeeplinkID: Hashable, Sendable {","    case home","    case profile(ProfileDeeplinkID)","    case reset","}","","struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkID","    typealias D = AppRoute","","    private let profileHandler = ProfileDeeplinkHandler()","","    func deeplink(from route: AppDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let profileID):","            return try await profileHandler.deeplink(from: profileID)","        case .reset:","            return .popToRoot()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Benefits:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"keeps handlers small and feature-focused","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"mirrors your nested route architecture"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"makes deeplink behavior easier to test","type":"text"}]}]}]},{"anchor":"Tab-Based-Deep-Links","type":"heading","level":2,"text":"Tab-Based Deep Links"},{"type":"paragraph","inlineContent":[{"text":"For apps with tab navigation, implement ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler"},{"text":" and return a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"deeplink"},{"text":" property accepts any ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"text":", including reset scenarios with ","type":"text"},{"type":"codeVoice","code":".popToRoot()"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct AppTabDeeplinkHandler: TabDeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias T = HomeTab","    typealias D = HomeRoute","","    func deeplink(from route: DeeplinkIdentifier) async throws -> TabDeeplink<HomeTab, HomeRoute>? {","        switch route {","        case .profile(let userId):","            return TabDeeplink(","                tab: .profile,","                deeplink: .push(.profile(userId: userId))","            )","            ","        case .search(let query):","            return TabDeeplink(","                tab: .search,","                deeplink: .push(.searchResults(query: query), path: [.search])","            )","            ","        case .resetHome:","            return TabDeeplink(tab: .home, deeplink: .popToRoot())","            ","        default:","            return nil","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"handle(tabDeeplink:)","type":"codeVoice"},{"type":"text","text":" method switches to the specified tab, then delegates to "},{"code":"handle(deeplink:)","type":"codeVoice"},{"type":"text","text":" on that tab’s router. This means all "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"type":"text","text":" factories work seamlessly within tabs, including "},{"code":".popToRoot()","type":"codeVoice"},{"type":"text","text":" for resetting a specific tab’s navigation."}]},{"type":"paragraph","inlineContent":[{"text":"Handle with TabRouter:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.router) private var router","","func handleDeeplink(_ url: URL) async throws {","    guard let identifier = DeeplinkIdentifier(url: url) else { return }","    guard let tabDeeplink = try await handler.deeplink(from: identifier) else { return }","    router.tabRouter?.handle(tabDeeplink: tabDeeplink)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"codeVoice","code":"tabRouter"},{"type":"text","text":" is injected inside "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":" descendants."},{"type":"text","text":" "},{"type":"text","text":"If deeplink handling is implemented in a parent container that owns "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"router.tabRouter"},{"type":"text","text":" to access the tab router."}]}],"style":"note","type":"aside","name":"Note"},{"anchor":"Building-Navigation-Paths","type":"heading","level":2,"text":"Building Navigation Paths"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For complex deep links, build a path of intermediate routes:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Deep link to: Home → Category → Subcategory → Product",".push(","    .product(id: productId),","    path: [","        .category(id: categoryId),","        .subcategory(id: subcategoryId)","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the back button works correctly through the entire hierarchy."}]},{"anchor":"Resetting-Navigation","type":"heading","level":2,"text":"Resetting Navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":" to reset navigation without navigating to a specific route:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Simply reset to root",".popToRoot()","","\/\/ Reset and change the root route",".popToRoot(root: .dashboard)","","\/\/ Update root only (no popToRoot, no path navigation)",".updateRoot(.newHome)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are useful for logout flows, session resets, or returning users to a clean state."}]},{"anchor":"Error-Handling","type":"heading","level":2,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"deeplink(from:)","type":"codeVoice"},{"text":" to ignore invalid deep links:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    guard isValidRoute(route) else {","        return nil  \/\/ Silently ignore","    }","    ","    \/\/ Or throw for error handling","    guard let data = try await fetchData(for: route) else {","        throw DeeplinkError.notFound","    }","    ","    return .push(.detail(data))","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"abstract":[{"type":"text","text":"Learn how to handle deep links and navigate to specific routes."}],"kind":"article","topicSections":[{"anchor":"Related","title":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRouteGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/Swi