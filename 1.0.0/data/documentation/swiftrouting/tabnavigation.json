{"metadata":{"title":"Tab Navigation","roleHeading":"Article","role":"article","modules":[{"name":"SwiftRouting"}]},"seeAlsoSections":[{"title":"Tab Navigation","anchor":"Tab-Navigation","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/AnyTabRoute"],"generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/tabnavigation"]}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabNavigation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Learn how to implement tab-based navigation with SwiftRouting."}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for tab-based navigation through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView"},{"type":"text","text":"."}]},{"anchor":"Defining-Tabs","type":"heading","level":2,"text":"Defining Tabs"},{"type":"paragraph","inlineContent":[{"text":"Create an enum conforming to ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","code":["enum HomeTab: TabRoute {","    case home","    case search","    case profile","    ","    var name: String {","        switch self {","        case .home: \"Home\"","        case .search: \"Search\"","        case .profile: \"Profile\"","        }","    }","}"],"type":"codeListing"},{"anchor":"Option-1-Using-RoutingTabView","type":"heading","level":2,"text":"Option 1: Using RoutingTabView"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","isActive":true},{"type":"text","text":" provides a "},{"type":"codeVoice","code":"TabRouter"},{"type":"text","text":" for programmatic tab control:"}]},{"syntax":"swift","code":["struct ContentView: View {","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        RoutingTabView(tab: $selectedTab, destination: HomeRoute.self) { destination in","            RoutingView(tab: HomeTab.home, destination: destination, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: destination, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: destination, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"type":"codeListing"},{"anchor":"Option-2-Using-Native-TabView","type":"heading","level":2,"text":"Option 2: Using Native TabView"},{"type":"paragraph","inlineContent":[{"text":"For simpler cases, use SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":".tabToRoot"},{"text":" binding:","type":"text"}]},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(\\.router) private var router","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        TabView(selection: .tabToRoot(for: $selectedTab, in: router)) {","            RoutingView(tab: HomeTab.home, destination: HomeRoute.self, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: HomeRoute.self, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: HomeRoute.self, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":".tabToRoot"},{"text":" binding automatically pops to root when the user taps the already-selected tab.","type":"text"}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"This native "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" approach does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" provide a "},{"type":"codeVoice","code":"TabRouter"},{"type":"text","text":" in the environment."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":" when you need "},{"type":"codeVoice","code":"@Environment(\\.tabRouter)"},{"type":"text","text":" and cross-tab programmatic actions."}],"type":"paragraph"}]},{"anchor":"Using-TabRouter","type":"heading","level":2,"text":"Using TabRouter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Access the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter"},{"type":"text","text":" from the environment to navigate across tabs:"}]},{"syntax":"swift","code":["struct SomeView: View {","    @Environment(\\.tabRouter) private var tabRouter","    ","    var body: some View {","        Button(\"Go to Profile\") {","            \/\/ Switch to profile tab and push a route","            tabRouter?.push(HomeRoute.settings, in: HomeTab.profile)","        }","    }","}"],"type":"codeListing"},{"anchor":"App-Level-Convenience-Overloads-Optional","type":"heading","level":3,"text":"App-Level Convenience Overloads (Optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses one main route enum with nested feature routes, you can add"},{"type":"text","text":" "},{"type":"codeVoice","code":"TabRouterModel"},{"type":"text","text":" overloads to improve call-site ergonomics (for example using"},{"type":"text","text":" "},{"type":"codeVoice","code":".profile(...)"},{"type":"text","text":" directly at call sites)."}]},{"syntax":"swift","code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute, in: nil)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute, in: nil)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before:"}]},{"syntax":"swift","code":["tabRouter.push(HomeRoute.profile, in: nil)","tabRouter.present(HomeRoute.settings, in: nil)","tabRouter.update(root: HomeRoute.home, in: nil)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After:"}]},{"syntax":"swift","code":["tabRouter.push(.profile)","tabRouter.present(.settings)","tabRouter.update(root: .home)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}]},{"type":"paragraph","inlineContent":[{"text":"You can apply the same pattern for your main tab enum as well:","type":"text"}]},{"syntax":"swift","code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute, in tab: HomeTab?) {","        push(homeRoute, in: tab as (any TabRoute)?)","    }","","    @_disfavoredOverload","    func popToRoot(in tab: HomeTab?) {","        popToRoot(in: tab as (any TabRoute)?)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Before:","type":"text"}]},{"syntax":"swift","code":["tabRouter.push(HomeRoute.profile, in: HomeTab.profile)","tabRouter.popToRoot(in: HomeTab.profile)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"After:","type":"text"}]},{"syntax":"swift","code":["tabRouter.push(.profile, in: .profile)","tabRouter.popToRoot(in: .profile)"],"type":"codeListing"},{"anchor":"TabRouter-Methods","type":"heading","level":3,"text":"TabRouter Methods"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"change(tab:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Switch to a different tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"push(_:in:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Push a route in a specific tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"present(_:in:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a sheet in a specific tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cover(_:in:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a cover in a specific tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"update(root:in:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the root of a specific tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"popToRoot(in