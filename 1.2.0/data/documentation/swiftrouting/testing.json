{"metadata":{"modules":[{"name":"SwiftRouting"}],"role":"collectionGroup","title":"Testing Navigation","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Testing"},"abstract":[{"text":"Learn how to write unit tests for your navigation logic.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"SwiftRouting is designed with testability in mind. The protocol-based architecture allows you to mock routers and verify navigation behavior without running UI tests.","type":"text"}]},{"type":"heading","text":"Testing Strategies","level":2,"anchor":"Testing-Strategies"},{"type":"heading","text":"Strategy 1: RouterSpy","level":3,"anchor":"Strategy-1-RouterSpy"},{"type":"paragraph","inlineContent":[{"code":"RouterModel","type":"codeVoice"},{"text":" has grown a fair amount of surface (push, present, cover, context handling, split selections…), so hand-rolling a mock for every test is tedious and easy to let drift out of sync with the protocol. Add the companion package instead:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"1.0.0\"))","]"]},{"type":"codeListing","syntax":"swift","code":[".product(name: \"SwiftRoutingTestSupport\", package: \"swift-routing\")"]},{"type":"paragraph","inlineContent":[{"code":"RouterSpy","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"RouterModel","type":"codeVoice"},{"text":" and records every call instead of performing real navigation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftRoutingTestSupport","","let spy = RouterSpy(root: AppRoute.home)","spy.push(AppRoute.profile(userId: \"123\"))","","#expect(spy.pushedRoutes.count == 1)","#expect((spy.pushedRoutes.first as? AppRoute) == .profile(userId: \"123\"))"]},{"type":"paragraph","inlineContent":[{"text":"Available recorded state: ","type":"text"},{"code":"pushedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"presentedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"coveredRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"updatedRoots","type":"codeVoice"},{"text":", ","type":"text"},{"code":"routedDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popToRootCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"closeCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"closeChildrenCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"terminatedContexts","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dispatchedContexts","type":"codeVoice"},{"text":", ","type":"text"},{"code":"addedContextTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"removedContextTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"detailSelections","type":"codeVoice"},{"text":", ","type":"text"},{"code":"contentSelections","type":"codeVoice"},{"text":" — plus live ","type":"text"},{"code":"currentRoute","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"pathCount","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"detailSelection","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"contentSelection","type":"codeVoice"},{"text":" that update as calls happen.","type":"text"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"code":"tabRouter(for:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"findRouterInTabRouter(for:)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"deepestRouter()","type":"codeVoice"},{"type":"text","text":" always return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on "},{"code":"RouterSpy","type":"codeVoice"},{"type":"text","text":" — there’s no real router hierarchy behind it. Test code that depends on those against a real "},{"type":"codeVoice","code":"Router"},{"type":"text","text":" instead."}]}]},{"type":"heading","text":"Strategy 2: Test ViewModel Navigation","level":3,"anchor":"Strategy-2-Test-ViewModel-Navigation"},{"type":"paragraph","inlineContent":[{"text":"Inject the spy into your ViewModel:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","final class ProfileViewModel {","    private let router: any RouterModel","    private let userId: String","    ","    init(router: any RouterModel, userId: String) {","        self.router = router","        self.userId = userId","    }","    ","    func editProfile() {","        router.push(ProfileRoute.edit(userId: userId))","    }","    ","    func openSettings() {","        router.present(ProfileRoute.settings)","    }","    ","    func logout() {","        router.popToRoot()","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Test the navigation behavior:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Testing","","@Suite(\"ProfileViewModel Navigation\")","struct ProfileViewModelTests {","    ","    @Test","    @MainActor","    func editProfile_pushesEditRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.editProfile()","        ","        #expect(spy.pushedRoutes.count == 1)","        let pushedRoute = spy.pushedRoutes.first as? ProfileRoute","        #expect(pushedRoute == .edit(userId: \"123\"))","    }","    ","    @Test","    @MainActor","    func openSettings_presentsSettingsRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.openSettings()","        ","        #expect(spy.presentedRoutes.count == 1)","        let presentedRoute = spy.presentedRoutes.first?.route as? ProfileRoute","        #expect(presentedRoute == .settings)","    }","    ","    @Test","    @MainActor","    func logout_popsToRoot() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.logout()","        ","        #expect(spy.popToRootCallCount == 1)","    }","}"]},{"type":"heading","text":"Testing RouteContext","level":2,"anchor":"Testing-RouteContext"},{"type":"heading","text":"Testing Context Sending","level":3,"anchor":"Testing-Context-Sending"},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func selectUser_terminatesWithContext() {","    let spy = RouterSpy(root: AppRoute.userPicker)","    let viewModel = UserPickerViewModel(router: spy)","    let user = User(id: \"1\", name: \"John\")","    ","    viewModel.selectUser(user)","    ","    #expect(spy.terminatedContexts.count == 1)","    let context = spy.terminatedContexts.first as? UserSelectionContext","    #expect(context?.selectedUser.id == \"1\")","}"]},{"type":"heading","text":"Testing Context Reception","level":3,"anchor":"Testing-Context-Reception"},{"type":"paragraph","inlineContent":[{"text":"For testing context handlers, use a real ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"text":" instance:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func contextHandler_receivesContext() async {","    let router = Router(configuration: .default)","    var receivedUser: User?","    ","    router.add(context: UserSelectionContext.self) { context in","        receivedUser = context.selectedUser","    }","    ","    let user = User(id: \"1\", name: \"John\")","    router.context(UserSelectionContext(selectedUser: user))","    ","    #expect(receivedUser?.id == \"1\")","}"]},{"type":"heading","text":"Testing Deep Links","level":2,"anchor":"Testing-Deep-Links"},{"type":"heading","text":"Testing DeeplinkHandler","level":3,"anchor":"Testing-DeeplinkHandler"},{"type":"codeListing","syntax":"swift","code":["struct TestDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias D = AppRoute","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let userId):","            return .push(.profile(userId: userId))","        case .settings:","            return .present(.settings)","        default:","            return nil","        }","    }","}","","@Suite(\"DeeplinkHandler\")","struct DeeplinkHandlerTests {","    ","    @Test","    func homeIdentifier_returnsPushHome() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .home)","        ","        #expect(deeplink?.route == .home)","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func profileIdentifier_returnsPushWithUserId() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .profile(userId: \"123\"))","        ","        #expect(deeplink?.route == .profile(userId: \"123\"))","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func settingsIdentifier_returnsPresent() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .settings)","        ","        #expect(deeplink?.route == .settings)","        #expect(deeplink?.type == .sheet(withStack: true))","    }","    ","    @Test","    func unknownIdentifier_returnsNil() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .unknown)","        ","        #expect(deeplink == nil)","    }","}"]},{"type":"heading","text":"Testing DeeplinkRoute Factories","level":3,"anchor":"Testing-DeeplinkRoute-Factories"},{"type":"codeListing","syntax":"swift","code":["@Suite(\"DeeplinkRoute Factories\")","struct DeeplinkRouteFactoryTests {","    ","    @Test","    func push_createsCorrectDeeplink() {","        let deeplink: DeeplinkRoute<AppRoute> = .push(.home, path: [.list])","        ","        #expect(deeplink.route == .home)","        #expect(deeplink.type == .push)","        #expect(deeplink.path.count == 1)","    }","    ","    @Test","    func popToRoot_hasNilRoute() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot()","        ","        #expect(deeplink.route == nil)","    }","    ","    @Test","    func popToRootWithRoot_setsRoot() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot(root: .dashboard)","        ","        #expect(deeplink.root == .dashboard)","        #expect(deeplink.route == nil)","    }","}"]},{"type":"heading","text":"Testing TabRouter Navigation","level":2,"anchor":"Testing-TabRouter-Navigation"},{"type":"paragraph","inlineContent":[{"code":"TabRouterSpy","type":"codeVoice"},{"type":"text","text":", from the same "},{"code":"SwiftRoutingTestSupport","type":"codeVoice"},{"type":"text","text":" package, conforms to "},{"code":"TabRouterModel","type":"codeVoice"},{"type":"text","text":" the same way:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftRoutingTestSupport","","@Test","@MainActor","func crossTabNavigation_pushesToCorrectTab() {","    let spy = TabRouterSpy(root: AppRoute.home)","    let viewModel = HomeViewModel(tabRouter: spy)","    ","    viewModel.goToProfile(userId: \"123\")","    ","    #expect(spy.pushedRoutes.count == 1)","    let call = spy.pushedRoutes.first","    #expect((call?.route as? AppRoute) == .profile(userId: \"123\"))","    #expect((call?.tab as? AppTab) == .profile)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available recorded state: "},{"code":"changedTabs","type":"codeVoice"},{"type":"text","text":", "},{"code":"pushedRoutes","type":"codeVoice"},{"type":"text","text":", "},{"code":"presentedRoutes","type":"codeVoice"},{"type":"text","text":", "},{"code":"coveredRoutes","type":"codeVoice"},{"type":"text","text":", "},{"code":"updatedRoots","type":"codeVoice"},{"type":"text","text":", "},{"code":"popToRootTabs","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Best Practices","level":2,"anchor":"Best-Practices"},{"type":"heading","text":"Use Protocol Types","level":3,"anchor":"Use-Protocol-Types"},{"type":"paragraph","inlineContent":[{"text":"Always inject ","type":"text"},{"code":"any RouterModel","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"any TabRouterModel","type":"codeVoice"},{"text":" instead of concrete types:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Good: Protocol type enables mocking","init(router: any RouterModel) { ... }","","\/\/ Avoid: Concrete type is harder to test","init(router: Router) { ... }"]},{"type":"heading","text":"Test Navigation Intent, Not Implementation","level":3,"anchor":"Test-Navigation-Intent-Not-Implementation"},{"type":"paragraph","inlineContent":[{"text":"Focus on ","type":"text"},{"inlineContent":[{"text":"what","type":"text"}],"type":"emphasis"},{"text":" navigation should happen, not ","type":"text"},{"inlineContent":[{"type":"text","text":"how"}],"type":"emphasis"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Good: Tests the intent","#expect(spy.pushedRoutes.contains { ($0 as? AppRoute) == .profile(userId: \"123\") })","","\/\/ Avoid: Testing implementation details","#expect(spy.pathCount == 2)"]},{"type":"heading","text":"Prefer RouterSpy Over Hand-Rolled Mocks","level":3,"anchor":"Prefer-RouterSpy-Over-Hand-Rolled-Mocks"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"TabRouterModel"},{"type":"text","text":" have grown a fair amount of surface, and a hand-rolled mock silently drifts out of sync every time the protocol changes. "},{"type":"codeVoice","code":"RouterSpy"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"TabRouterSpy"},{"type":"text","text":" are tested against the real protocols, so use them instead of writing your own unless a test needs custom behavior a spy can’t express."}]},{"type":"heading","text":"Test Async Handlers","level":3,"anchor":"Test-Async-Handlers"},{"type":"paragraph","inlineContent":[{"text":"Deep link handlers are async. Use Swift Testing’s async support:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test","func asyncDeeplinkHandler() async throws {","    let handler = MyDeeplinkHandler()","    let result = try await handler.deeplink(from: .someIdentifier)","    #expect(result != nil)","}"]}]}],"variants":[{"paths":["\/documentation\/swiftrouting\/testing"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"],"anchor":"Related","title":"Related"}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/Router":{"abstract":[{"text":"Manages programmatic navigation for both stack-based and split-view contexts.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Router","kind":"identifier"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftR