{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"text":" is your primary interface for programmatic navigation. Every ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","isActive":true,"type":"reference"},{"text":" creates its own router, accessible via the SwiftUI environment.","type":"text"}],"type":"paragraph"},{"anchor":"Accessing-the-Router","level":2,"text":"Accessing the Router","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" property wrapper to access the router:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        Button(\"Navigate\") {","            router.push(HomeRoute.detail(id: 42))","        }","    }","}"],"type":"codeListing"},{"anchor":"Push-Navigation","level":2,"text":"Push Navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Push adds a route to the navigation stack with a standard slide animation:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Push a new route","router.push(HomeRoute.detail(id: 42))","","\/\/ Using NavigationLink","NavigationLink(route: HomeRoute.detail(id: 42)) {","    Text(\"View Details\")","}"],"type":"codeListing"},{"anchor":"NavigationLink-Behavior","level":3,"text":"NavigationLink Behavior","type":"heading"},{"inlineContent":[{"code":"NavigationLink(route:)","type":"codeVoice"},{"text":" is push-only (stack navigation), because it uses","type":"text"},{"text":" ","type":"text"},{"code":"NavigationLink(value:)","type":"codeVoice"},{"text":" with route values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Important notes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"It must be used inside a "},{"code":"RoutingView","type":"codeVoice"},{"type":"text","text":" configured with a matching "},{"code":"RouteDestination","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It does not perform modal presentation, even if the route has a modal "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For modal flows, prefer "},{"type":"codeVoice","code":"router.present(...)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"router.cover(...)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Modal-Presentations","level":2,"text":"Modal Presentations","type":"heading"},{"anchor":"Sheet","level":3,"text":"Sheet","type":"heading"},{"inlineContent":[{"text":"Present a route as a modal sheet:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ With navigation stack (default)","router.present(HomeRoute.settings)","","\/\/ Without navigation stack","router.present(HomeRoute.settings, withStack: false)"],"type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"withStack: false","type":"codeVoice"},{"text":" when the presented destination needs direct sheet modifiers such as:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".presentationDetents([.medium])",".presentationDragIndicator(.visible)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"withStack: true"},{"type":"text","text":" (default), the route is wrapped in a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":", which can make these modifiers less predictable on the final destination view."}],"type":"paragraph"},{"anchor":"Full-Screen-Cover","level":3,"text":"Full-Screen Cover","type":"heading"},{"inlineContent":[{"text":"Present a route as a full-screen cover:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.cover(HomeRoute.onboarding)"],"type":"codeListing"},{"anchor":"Navigating-Back","level":2,"text":"Navigating Back","type":"heading"},{"anchor":"Back-One-Step","level":3,"text":"Back One Step","type":"heading"},{"inlineContent":[{"text":"Remove the top route from the stack:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.pop()"],"type":"codeListing"},{"anchor":"Pop-to-Root","level":3,"text":"Pop to Root","type":"heading"},{"inlineContent":[{"text":"Return to the root of the navigation stack:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.popToRoot()"],"type":"codeListing"},{"anchor":"Close-Modal","level":3,"text":"Close Modal","type":"heading"},{"inlineContent":[{"type":"text","text":"Dismiss a presented sheet or cover:"}],"type":"paragraph"},{"syntax":"swift","code":["router.close()"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"close()"},{"type":"text","text":" only works on routers that are presented (sheets or covers)."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"anchor":"Updating-the-Root","level":2,"text":"Updating the Root","type":"heading"},{"inlineContent":[{"type":"text","text":"Replace the current root route:"}],"type":"paragraph"},{"syntax":"swift","code":["router.update(root: HomeRoute.dashboard)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is useful for scenarios like switching between logged-in and logged-out states."}],"type":"paragraph"},{"anchor":"Using-routingType","level":2,"text":"Using routingType","type":"heading"},{"inlineContent":[{"text":"Instead of calling specific methods, you can use ","type":"text"},{"code":"route(_:)","type":"codeVoice"},{"text":" which respects the route’s ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ This will use the route's defined routingType","router.route(HomeRoute.settings)","","\/\/ Equivalent to checking routingType and calling the appropriate method","switch route.routingType {","case .push: router.push(route)","case .sheet: router.present(route)","case .cover: router.cover(route)","case .root: router.update(root: route)","}"],"type":"codeListing"},{"inlineContent":[{"text":"For routes that require sheet presentation customizations (","type":"text"},{"code":"presentationDetents","type":"codeVoice"},{"text":", ","type":"text"},{"code":"presentationDragIndicator","type":"codeVoice"},{"text":"), prefer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var routingType: RoutingType { .sheet(withStack: false) }"],"type":"codeListing"},{"anchor":"Router-Properties","level":2,"text":"Router Properties","type":"heading"},{"inlineContent":[{"text":"The router provides useful properties for UI decisions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Check if this router is presented as a modal","if router.isPresented {","    Button(\"Close\") { router.close() }","}","","\/\/ Get the current route","let current = router.currentRoute","","\/\/ Check navigation depth","if router.routeCount > 1 {","    Button(\"Back\") { router.pop() }","}"],"type":"codeListing"},{"anchor":"Injecting-Router-into-ViewModels","level":2,"text":"Injecting Router into ViewModels","type":"heading"},{"inlineContent":[{"text":"For MVVM architectures, inject the router using ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class DetailViewModel: ObservableObject {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","    ","    func goToSettings() {","        router.present(HomeRoute.settings)","    }","}","","struct DetailView: View {","    @Environment(\\.router) private var router","    @StateObject private var viewModel: DetailViewModel","    ","    init() {","        \/\/ Note: Initialize in onAppear or use a factory","    }","    ","    var body: some View {","        \/\/ ...","    }","}"],"type":"codeListing"},{"anchor":"App-Level-Convenience-Overloads-Optional","level":2,"text":"App-Level Convenience Overloads (Optional)","type":"heading"},{"inlineContent":[{"type":"text","text":"If your app uses one main route enum (for example "},{"type":"codeVoice","code":"HomeRoute"},{"type":"text","text":"), you can add"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" overloads to improve call-site ergonomics:"}],"type":"paragraph"},{"syntax":"swift","code":["public extension RouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Before:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.push(HomeRoute.profile)","router.update(root: HomeRoute.home)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"After:"}],"type":"paragraph"},{"syntax":"swift","code":["router.push(.profile)","router.update(root: .home)"],"type":"codeListing"},{"inlineContent":[{"text":"Use this pattern for your main route type only, to keep overload resolution predictable.","type":"text"}],"type":"paragraph"},{"anchor":"Closing-Child-Routers","level":2,"text":"Closing Child Routers","type":"heading"},{"inlineContent":[{"type":"text","text":"When handling deep links or resetting navigation, close all presented modals:"}],"type":"paragraph"},{"syntax":"swift","code":["router.closeChildren()"],"type":"codeListing"},{"inlineContent":[{"text":"This dismisses any sheets or covers presented from this router.","type":"text"}],"type":"paragraph"},{"anchor":"Targeting-the-Frontmost-Router","level":2,"text":"Targeting the Frontmost Router","type":"heading"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":" always gives you the router for that view."},{"type":"text","text":" "},{"type":"text","text":"But at the "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" App level — where no environment is available — you hold a reference to"},{"type":"text","text":" "},{"type":"text","text":"the root router directly. In that case, use "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestPresentedRouter()","type":"reference","isActive":true},{"type":"text","text":" to target the"},{"type":"text","text":" "},{"type":"text","text":"router that is actually on screen at the moment the action fires:"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","  @State var rootRouter = Router(configuration: .default)","","  var body: some Scene {","    WindowGroup {","      ContentView()","        .environment(rootRouter)","        .onOpenURL { url in","          Task { @MainActor in","            rootRouter.deepestPresentedRouter()?.terminate(MyContext())","          }","        }","    }","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"deepestPresentedRouter()"},{"type":"text","text":" descends the router tree through the selected tab and through the"},{"type":"text","text":" "},{"type":"text","text":"presented child that matches the sheet or cover its parent currently shows. A router left over from"},{"type":"text","text":" "},{"type":"text","text":"a modal that is already dismissed (still alive during its dismiss animation) is ignored. If no modal"},{"type":"text","text":" "},{"type":"text","text":"is on screen, it returns the receiver itself."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()","isActive":true,"type":"reference"},{"text":" follows the last live child at each level instead. Children are kept","type":"text"},{"text":" ","type":"text"},{"text":"in a dictionary with no defined order, so it can return a stale router when several are alive.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"code":"deepestPresentedRouter()","type":"codeVoice"},{"text":" to target what the user sees.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"deepestPresentedRouter()"},{"text":" at dispatch time, not at setup time.","type":"text"},{"text":" ","type":"text"},{"text":"If a modal is on screen when the action fires, it returns that modal’s router","type":"text"},{"text":" ","type":"text"},{"text":"so ","type":"text"},{"type":"codeVoice","code":"terminate(_:)"},{"text":" unwinds through the correct presenter.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","title":"Navigation Basics","modules":[{"name":"SwiftRouting"}]},"sections":[],"kind":"article","abstract":[{"text":"Learn how to navigate between routes using the Router.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics"},"seeAlsoSections":[{"anchor":"Navigation","generated":true,"title":"Navigation","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/PresentationModel"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/navigationbasics"]}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/BaseRouter/deepestPresentedRouter()":{"abstract":[{"type":"text","text":"Returns the "},{"type":"codeVoice","code":"Router"},{"type":"text","text":" that is actually on screen, following only presented modals."}],"type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestPresentedRouter()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deepestPresentedRouter","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12SwiftRouting6RouterC","text":"Router","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/swiftrouting\/baserouter\/deepestpresentedrouter()","kind":"symbol","title":"deepestPresentedRouter()"},"doc://SwiftRouting/documentation/SwiftRouting/Migration":{"type":"topic","role":"collectionGroup","abstract":[{"text":"Adopt SwiftRouting in an existing SwiftUI app with minimal disruption.","type":"text"}],"url":"\/documentation\/swiftrouting\/migration","kind":"article","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration","title":"Migrating from NavigationStack"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouter":{"url":"\/documentation\/swiftrouting\/baserouter","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter","role":"symbol","abstract":[{"type":"text","text":"A base class for all router types, including "},{"type":"codeVoice","code":"Router"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TabRouter"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"BaseRouter"}],"type":"topic","kind":"symbol","title":"BaseRouter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseRouter"}]},"doc://SwiftRouting/documentation/SwiftRouting/Router":{"abstract":[{"text":"Manages programmatic navigation for both stack-based and split-view contexts.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Router","kind":"identifier"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"topic","url":"\/documentation\/swiftrouting\/router","kind":"symbol","role":"symbol","title":"Router","navigatorTitle":[{"text":"Router","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting":{"role":"collection","kind":"symbol","title":"SwiftRouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","url":"\/documentation\/swiftrouting","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}],"type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouterModel":{"type":"topic","abstract":[{"text":"Defines the base navigation capabilities shared by all router types.","type":"text"}],"title":"BaseRouterModel","url":"\/documentation\/swiftrouting\/baseroutermodel","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseRouterModel"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel","navigatorTitle":[{"kind":"identifier","text":"BaseRouterModel"}],"kind":"symbol","role":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","title":"RouterModel","kind":"symbol","type":"topic","url":"\/documentation\/swiftrouting\/routermodel","navigatorTitle":[{"text":"RouterModel","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"role":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/PresentationModel":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresentationModel"}],"kind":"symbol","abstract":[{"text":"Defines modal and sheet presentation capabilities for router types.","type":"text"}],"url":"\/documentation\/swiftrouting\/presentationmodel","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PresentationModel"}],"title":"PresentationModel","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/PresentationModel"},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","kind":"article","type":"topic","title":"FAQ","abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"url":"\/documentation\/swiftrouting\/faq","role":"collectionGroup"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouter/deepestRouter()":{"type":"topic","title":"deepestRouter()","abstract":[],"kind":"symbol","role":"symbol","url":"\/documentation\/swiftrouting\/baserouter\/deepestrouter()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deepestRouter","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12SwiftRouting6RouterC","text":"Router","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()"},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"role":"symbol","url":"\/documentation\/swiftrouting\/routingview","title":"RoutingView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoutingView","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Creates a navigation container with its own "},{"type":"codeVoice","code":"Router"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"}}}