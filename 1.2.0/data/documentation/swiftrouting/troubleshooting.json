{"variants":[{"paths":["\/documentation\/swiftrouting\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Configuration","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel"],"title":"Related","anchor":"Related"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftRouting"}],"title":"Troubleshooting","role":"collectionGroup"},"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],"title":"Support","anchor":"Support"}],"abstract":[{"text":"Diagnose and fix common issues encountered when using SwiftRouting.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article covers the most common errors and unexpected behaviors you may encounter, along with their causes and solutions."}]},{"type":"heading","level":2,"text":"Route Not Found","anchor":"Route-Not-Found"},{"type":"heading","level":3,"text":"Symptom","anchor":"Symptom"},{"type":"paragraph","inlineContent":[{"text":"A route is pushed but no view appears, or an error message is displayed:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Route 'DetailRoute' are not define in 'HomeRoute'"]},{"type":"heading","level":3,"text":"Cause","anchor":"Cause"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftRouting renders an error view when the resolved route cannot be cast to the expected "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","type":"reference","isActive":true},{"type":"text","text":" type. This typically happens when a route from one enum is pushed into a "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference","isActive":true},{"type":"text","text":" configured for a different destination."}]},{"type":"heading","level":3,"text":"Solution","anchor":"Solution"},{"type":"paragraph","inlineContent":[{"text":"Ensure the pushed route matches the destination type of the ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference","isActive":true},{"text":" it targets:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ✅ Correct — route and destination match","router.push(HomeRoute.detail(id: 42))","","\/\/ ❌ Wrong — route type doesn't match the active RoutingView","router.push(SettingsRoute.profile)"]},{"type":"heading","level":2,"text":"ErrorView Behavior","anchor":"ErrorView-Behavior"},{"type":"paragraph","inlineContent":[{"text":"When a route cannot be resolved, an error view is rendered. Its behavior depends on ","type":"text"},{"code":"Configuration.shouldCrashOnRouteNotFound","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldCrashOnRouteNotFound"}]}],[{"inlineContent":[{"type":"text","text":"Behavior"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Displays the error message inline as ","type":"text"},{"type":"codeVoice","code":"Text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"true","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Crashes the app with "},{"type":"codeVoice","code":"fatalError"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" during development to catch routing mismatches immediately. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide"},{"text":" for setup details.","type":"text"}]},{"type":"heading","level":2,"text":"onAppear Fires Before the Root When Pushing Into an Unvisited Tab","anchor":"onAppear-Fires-Before-the-Root-When-Pushing-Into-an-Unvisited-Tab"},{"type":"heading","level":3,"text":"Symptom","anchor":"Symptom"},{"type":"paragraph","inlineContent":[{"code":"tabRouter.push(_:in:)","type":"codeVoice"},{"text":" (and similarly ","type":"text"},{"code":"present","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"cover","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"popToRoot","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"update(root:in:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"handle(tabDeeplink:)","type":"codeVoice"},{"text":") switches to the target tab and acts on it in the same call. If that tab’s stack was never shown before, the pushed route’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":" can fire ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" the tab’s root ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":" – the opposite of what a real, incremental push does.","type":"text"}]},{"type":"heading","level":3,"text":"Cause","anchor":"Cause"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tab change and the push both happen synchronously, before SwiftUI re-renders. If the target tab was never selected before, its "},{"type":"codeVoice","code":"NavigationStack(path:)"},{"type":"text","text":" is being shown for the very first time – with "},{"type":"codeVoice","code":"path"},{"type":"text","text":" already non-empty. SwiftUI never gets a frame where that stack shows just the root; it materializes the whole stack (root + pushed route) at once instead of running a normal push transition, and doesn’t guarantee "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":" fires root-first in that situation."}]},{"type":"paragraph","inlineContent":[{"text":"This is a SwiftUI rendering-order quirk, not a SwiftRouting bug – there’s no fix on our side to guarantee ordering here. It isn’t specific to ","type":"text"},{"code":"push(_:in:)","type":"codeVoice"},{"text":" either: the same applies to any router method that changes tab and acts in the same call, and to deep links that land on a not-yet-visited tab.","type":"text"}]},{"type":"heading","level":3,"text":"Solution","anchor":"Solution"},{"type":"paragraph","inlineContent":[{"text":"Don’t rely on ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"onDisappear","type":"codeVoice"},{"text":" ordering after a cross-tab push\/present\/deeplink into a tab that hasn’t been shown yet. If you need reliable ordering (for logging, analytics, etc.), key off ","type":"text"},{"code":"Configuration.logger","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"Configuration.events","type":"codeVoice"},{"text":" instead (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide"},{"text":") – ","type":"text"},{"code":".action(.changeTab(_:))","type":"codeVoice"},{"type":"text","text":" and "},{"code":".navigation(...)","type":"codeVoice"},{"type":"text","text":" are logged synchronously, in the correct causal order, at the moment the router methods are called, regardless of when SwiftUI actually renders each view."}]},{"type":"heading","level":2,"text":"Context Not Received","anchor":"Context-Not-Received"},{"type":"paragraph","inlineContent":[{"text":"If a context is sent but no observer is triggered, check:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The observer is registered ","type":"text"},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"text":" the context is sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The observer is registered on the "},{"type":"strong","inlineContent":[{"type":"text","text":"parent"}]},{"type":"text","text":" router, not the child."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The context type matches exactly on both the sender and the observer side."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["\/\/ Parent — register before navigation","router.add(context: UserSelectionContext.self) { [weak self] context in","    self?.selectedUser = context.selectedUser","}","","\/\/ Child — send context","router.context(UserSelectionContext(selectedUser: user))"]},{"type":"heading","level":2,"text":"Memory Leaks with Contexts","anchor":"Memory-Leaks-with-Contexts"},{"type":"paragraph","inlineContent":[{"text":"Retain cycles occur when closures capture ","type":"text"},{"type":"codeVoice","code":"self"},{"text":" strongly. Always use ","type":"text"},{"type":"codeVoice","code":"[weak self]"},{"text":" when referencing class instances:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ❌ Retain cycle","router.add(context: MyContext.self) { context in","    self.handle(context)","}","","\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handle(context)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observers registered outside of a view lifecycle (e.g., in a ViewModel) must be removed explicitly. See "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","isActive":true},{"type":"text","text":" for the full memory management guide."}]},{"type":"heading","level":2,"text":"Visualizing the Router Hierarchy","anchor":"Visualizing-the-Router-Hierarchy"},{"type":"paragraph","inlineContent":[{"text":"When it’s unclear which router owns which tab\/sheet\/cover, what the full navigation stack looks like, or which ","type":"text"},{"code":"RouteContext","type":"codeVoice"},{"text":" observers are registered on which router, print the whole hierarchy to the console. Both variants are only available in ","type":"text"},{"code":"DEBUG","type":"codeVoice"},{"text":" builds – calls are compiled out entirely in release, so there’s no need to remove them before shipping.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"printRouter(trigger:)"},{"type":"text","text":" to print the tree on appear and again whenever a value changes, for example the current route:"}]},{"type":"codeListing","syntax":"swift","code":["content.printRouter(trigger: router.currentRoute)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This prints the tree starting from the top-most router, for example. Every stack-based router gets a "},{"type":"codeVoice","code":"root:"},{"type":"text","text":" line, and a "},{"type":"codeVoice","code":"path:"},{"type":"text","text":" line for anything pushed on top of it (omitted when nothing has been pushed) – so you’re not just seeing the current route in isolation. A split router also gets "},{"type":"codeVoice","code":"content:"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"detail:"},{"type":"text","text":" lines for its column selections, since "},{"type":"codeVoice","code":"current:"},{"type":"text","text":" alone only shows whichever one currently “wins” (an explicit push, then detail, then content):"}]},{"type":"codeListing","syntax":null,"code":["router(app) — current: home","   root: home","├─ tabRouter(hometab) — current: home","│  ├─ router(tab(home)) — current: profile(userId: \"42\")","│  │     root: home","│  │     path: [profile(userId: \"42\")]","│  │     contexts: [UserSelectionContext(profile(userId: \"42\"))]","│  └─ router(tab(settings)) — current: settings","│        root: settings","├─ router(split(sidebar)) — current: player(id: \"42\")","│     root: sidebar","│     content: players(type: .forward)","│     detail: player(id: \"42\")","└─ router(presented(sheet)) — current: onboarding","      root: onboarding"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"printRouterOnChange()"},{"type":"text","text":" to re-print whenever a router in the hierarchy logs a meaningful event (push, present, tab change, router creation\/destruction…), without picking a specific value to watch — including at the very top of the app, before any child router exists yet. This is the noisier of the two variants; routine or redundant events (view appearance, going back, context execution…) are filtered out to keep it from firing multiple times for the same conceptual change:"}]},{"type":"codeListing","syntax":"swift","code":["content.printRouterOnChange()"]},{"type":"heading","level":3,"text":"Placement relative to `.environment(\\.router, ...)`","anchor":"Placement-relative-to-environmentrouter-"},{"type":"paragraph","inlineContent":[{"text":"Like any modifier reading ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.router)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"printRouter*()"},{"text":" only sees the router injected by an ","type":"text"},{"type":"codeVoice","code":".environment(\\.router, ...)"},{"text":" call that comes ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"strong"},{"text":" it in the modifier chain (i.e. applied further out). If ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":" comes first, the modifier is outside its reach and silently falls back to the disconnected default router — it never crashes, it just never prints anything meaningful:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ❌ Wrong — .environment() is \"inside\" printRouterOnChange(); the modifier","\/\/ never sees the real router and instead observes the inert default one.","ChoiceScreen()","    .environment(\\.router, Router(configuration: .default))","    .printRouterOnChange()","","\/\/ ✅ Correct — .environment() is the outermost modifier, so it covers","\/\/ printRouterOnChange() too.","ChoiceScreen()","    .printRouterOnChange()","    .environment(\\.router, Router(configuration: .default))"]}]}],"kind":"article","references":{"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","kind":"article","type":"topic","title":"FAQ","abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"url":"\/documentation\/swiftrouting\/faq","role":"collectionGroup"},"doc://SwiftRouting/documentation/SwiftRouting/RouteDestination":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","abstract":[{"text":"Protocol that associates a ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" with its corresponding ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouteDestination","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/swiftrouting\/routedestination","title":"RouteDestination","navigatorTitle":[{"text":"RouteDestination","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"role":"symbol","url":"\/documentation\/swiftrouting\/routingview","title":"RoutingView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoutingView","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Creates a navigation container with its own "},{"type":"codeVoice","code":"Router"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","title":"RouterModel","kind":"symbol","type":"topic","url":"\/documentation\/swiftrouting\/routermodel","navigatorTitle":[{"text":"RouterModel","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"role":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/RouteContextGuide":{"role":"article","abstract":[{"text":"Learn how to pass data between routes using RouteContext.","type":"text"}],"url":"\/documentation\/swiftrouting\/routecontextguide","type":"topic","kind":"article","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","title":"Route Context"},"doc://SwiftRouting/documentation/SwiftRouting/Configuration":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Configuration","kind":"symbol","abstract":[{"type":"text","text":"A configuration structure used to initialize the app router."}],"navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"type":"topic","url":"\/documentation\/swiftrouting\/configuration","title":"Configuration"},"doc://SwiftRouting/documentation/SwiftRouting/RouteContext":{"role":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","title":"RouteContext","kind":"symbol","abstract":[{"type":"text","text":"A type that can be used to pass data between routes and trigger navigation flow completions."}],"type":"topic","url":"\/documentation\/swiftrouting\/routecontext","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouteContext","kind":"identifier"}],"navigatorTitle":[{"text":"RouteContext","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting":{"role":"collection","kind":"symbol","title":"SwiftRouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","url":"\/documentation\/swiftrouting","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}],"type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting/ConfigurationGuide":{"title":"Configuration and Logging","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","type":"topic","kind":"article","url":"\/documentation\/swiftrouting\/configurationguide","role":"collectionGroup","abstract":[{"text":"Learn how to configure SwiftRouting and customize logging behavior.","type":"text"}]}}}