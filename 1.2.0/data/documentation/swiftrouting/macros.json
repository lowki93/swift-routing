 "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","isActive":true},{"type":"text","text":" default ("},{"type":"codeVoice","code":"false"},{"type":"text","text":") applies"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"some"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" with "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for marked cases and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for the others"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"all"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"a constant "},{"type":"codeVoice","code":"true"}]}]]],"header":"row","type":"table"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A marker on a case declaring several elements (","type":"text"},{"code":"@HideTabBarOnPush case a, b","type":"codeVoice"},{"text":") applies to every element.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@TabRoutable"},{"text":" never generates ","type":"text"},{"type":"codeVoice","code":"routingType"},{"text":": tabs are selected, never presented. ","type":"text"},{"type":"codeVoice","code":"@Sheet"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Cover"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"@TabRoutable"},{"text":" enum are errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@HideTabBarOnPush"},{"text":" is an error anywhere other than a case of a ","type":"text"},{"type":"codeVoice","code":"@TabRoutable"},{"text":" enum, including a hand-written ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","type":"reference"},{"text":" or a ","type":"text"},{"type":"codeVoice","code":"@Routable"},{"text":" enum. W