{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftRouting"}],"title":"Macros","role":"collectionGroup"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DefiningRoutes","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabNavigation","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Architecture","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks"],"title":"Related","anchor":"Related"}],"sections":[],"abstract":[{"text":"Generate ","type":"text"},{"type":"codeVoice","code":"name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"routingType"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hideTabBarOnPush"},{"text":" for routes and tabs from their cases with the opt-in macros.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route","isActive":true},{"text":" needs a ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", used for logging, debugging and analytics. For most enums this is a mechanical ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over the cases. The ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" macro writes that ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" for you, and ","type":"text"},{"code":"@RouteName","type":"codeVoice"},{"text":" overrides the cases that need a custom format. ","type":"text"},{"code":"@Sheet","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Cover","type":"codeVoice"},{"text":" mark the cases that are presented modally so ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" can generate ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":" too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tabs get the same treatment: "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" generates a "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","isActive":true},{"type":"text","text":"’s "},{"type":"codeVoice","code":"name"},{"type":"text","text":", and "},{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" marks the tabs that hide the tab bar when pushing, so it can generate "},{"type":"codeVoice","code":"hideTabBarOnPush"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macros ship in a separate, opt-in product so that apps which don’t use them never compile swift-syntax."}]},{"anchor":"Installation","level":2,"type":"heading","text":"Installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiftRoutingMacros"},{"type":"text","text":" product next to "},{"type":"codeVoice","code":"SwiftRouting"},{"type":"text","text":":"}]},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"SwiftRouting\", package: \"swift-routing\"),","        .product(name: \"SwiftRoutingMacros\", package: \"swift-routing\"),","    ]",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Then import it where your routes are declared:","type":"text"}]},{"syntax":"swift","code":["import SwiftRoutingMacros"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftRoutingMacros"},{"type":"text","text":" re-exports "},{"type":"codeVoice","code":"SwiftRouting"},{"type":"text","text":", so this single import gives you both the macros and the rest of the library. Writing "},{"type":"codeVoice","code":"import SwiftRouting"},{"type":"text","text":" as well still compiles."}]},{"anchor":"Default-Names","level":2,"type":"heading","text":"Default Names"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" to the enum. Each case without an override is named after itself. "},{"type":"codeVoice","code":"nameStyle"},{"type":"text","text":" sets the format:"}]},{"syntax":"swift","code":["@Routable(nameStyle: .capitalized)","enum AppRoute {","    case profile","    case search","}","\/\/ AppRoute.profile.name == \"Profile\"","\/\/ AppRoute.search.name == \"Search\""],"type":"codeListing"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nameStyle"}]}],[{"inlineContent":[{"type":"codeVoice","code":".profile"},{"type":"text","text":" becomes"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verbatim","type":"codeVoice"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"profile\""}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".capitalized"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"Profile\""}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"code":"nameStyle","type":"codeVoice"},{"text":" must be written as a literal (","type":"text"},{"code":".verbatim","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".capitalized","type":"codeVoice"},{"text":"), since the macro reads it from source.","type":"text"}]},{"anchor":"Choosing-a-Style","level":3,"type":"heading","text":"Choosing a Style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick the style that matches the names your routes already report, so logs and analytics stay unchanged when you adopt the macro. "},{"type":"codeVoice","code":"nameStyle"},{"type":"text","text":" also sets the prefix that "},{"type":"codeVoice","code":"@RouteName(.delegate)"},{"type":"text","text":" writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, take a hand-written route whose names are capitalized:"}]},{"syntax":"swift","code":["\/\/ Before: hand-written.","enum LegacyAppRoute: Route {","    case profile","    case search","    case notifications(NotificationsRoute)","","    var name: String {","        switch self {","        case .profile: \"Profile\"","        case .search: \"Search\"","        case .notifications(let child): \"Notifications.\\(child.name)\"","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"@Routable(nameStyle: .capitalized)","type":"codeVoice"},{"text":" reports the same names, with only one override:","type":"text"}]},{"syntax":"swift","code":["\/\/ After: same names.","@Routable(nameStyle: .capitalized)","enum AppRoute {","    case profile","    case search","    @RouteName(.delegate)","    case notifications(NotificationsRoute)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the default "},{"type":"codeVoice","code":".verbatim"},{"type":"text","text":", each case would need its own "},{"type":"codeVoice","code":"@RouteName"},{"type":"text","text":", and "},{"type":"codeVoice","code":".delegate"},{"type":"text","text":" would write "},{"type":"codeVoice","code":"notifications."},{"type":"text","text":", so "},{"type":"codeVoice","code":"notifications"},{"type":"text","text":" would need "},{"code":"@RouteName(#\"Notifications.\\(arg0.name)\"#)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"@Routable","type":"codeVoice"},{"text":" also adds the ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" conformance, so ","type":"text"},{"code":": Route","type":"codeVoice"},{"text":" is optional. Writing it explicitly still compiles.","type":"text"}]},{"anchor":"Overriding-a-Case","level":2,"type":"heading","text":"Overriding a Case"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"@RouteName","type":"codeVoice"},{"text":" with a raw string literal. Each associated value is available in the template under one name:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A labeled value is available by its label. It has no ","type":"text"},{"type":"codeVoice","code":"argN"},{"text":" name.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"An unlabeled value is available as ","type":"text"},{"code":"arg","type":"codeVoice"},{"text":" followed by its zero-based position among all the associated values, labeled or not.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" label counts as unlabeled: ","type":"text"},{"type":"codeVoice","code":"case detail(_ id: Int)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"arg0"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" isn’t usable.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".delegate"},{"type":"text","text":" uses the case’s single associated value, whatever its name."}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["@Routable","enum PlayersRoute {","    @RouteName(#\"Players(\\(arg0))\"#)","    case list(PlayerType)","","    @RouteName(#\"Player(\\(arg0.name))\"#)","    case detail(Player)","}","","@Routable","enum NotificationsRoute {","    @RouteName(#\"Notifications\"#)","    case list","","    @RouteName(#\"Notification(\\(id))\"#)","    case detail(id: Int)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In a case mixing both, the labeled value keeps its label and the unlabeled one uses its position, which counts the labeled value too:","type":"text"}]},{"syntax":"swift","code":["@Routable","enum OrderRoute {","    \/\/ arg0 doesn't exist here: the first value is labeled, so it's id.","    @RouteName(#\"Order(\\(id), \\(arg1))\"#)","    case detail(id: String, OrderTab)","}","\/\/ OrderRoute.detail(id: \"42\", .shipping).name == \"Order(42, shipping)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using a name that isn’t available is a compile-time error that lists the available names (for example "},{"type":"codeVoice","code":"Available: id, arg1"},{"type":"text","text":")."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The template must be a raw string literal ("},{"type":"codeVoice","code":"#\"...\"#"},{"type":"text","text":"). A regular string with "},{"type":"codeVoice","code":"\\(id)"},{"type":"text","text":" doesn’t compile, because "},{"type":"codeVoice","code":"id"},{"type":"text","text":" isn’t in scope where the attribute is written. In a raw string, "},{"type":"codeVoice","code":"\\(...)"},{"type":"text","text":" is plain text that the macro copies into the generated "},{"type":"codeVoice","code":"switch"},{"type":"text","text":", where the value is in scope."}]}],"name":"Important","type":"aside","style":"important"},{"anchor":"Composing-Child-Routes","level":2,"type":"heading","text":"Composing Child Routes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a case wraps another "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"@RouteName(.delegate)"},{"type":"text","text":" appends the child’s name to the case name:"}]},{"syntax":"swift","code":["@Routable(nameStyle: .capitalized)","enum AppRoute {","    @RouteName(.delegate)","    case notifications(NotificationsRoute)","}","\/\/ AppRoute.notifications(.detail(id: 1)).name == \"Notifications.Notification(1)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The prefix follows the enum’s "},{"type":"codeVoice","code":"nameStyle"},{"type":"text","text":". "},{"type":"codeVoice","code":".delegate"},{"type":"text","text":" requires exactly one associated value."}]},{"anchor":"Presentation-Style","level":2,"type":"heading","text":"Presentation Style"},{"type":"paragraph","inlineContent":[{"text":"Mark a case with ","type":"text"},{"type":"codeVoice","code":"@Sheet"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"@Cover"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Routable"},{"text":" also generates ","type":"text"},{"type":"codeVoice","code":"routingType"},{"text":":","type":"text"}]},{"syntax":"swift","code":["@Routable","enum AppRoute {","    case home","    @Sheet(withStack: true)","    case settings","    @Cover","    case onboarding","    case order(id: String)","}","\/\/ AppRoute.home.routingType == .push","\/\/ AppRoute.settings.routingType == .sheet(withStack: true)","\/\/ AppRoute.onboarding.routingType == .cover","\/\/ AppRoute.order(id: \"1\").routingType == .push"],"type":"codeListing"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marker"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated "},{"type":"codeVoice","code":"routingType"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Sheet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@Sheet()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sheet(withStack: true)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Sheet(withStack: false)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sheet(withStack: false)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Cover","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".cover"}]}]]],"header":"row","type":"table"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"routingType","type":"codeVoice"},{"type":"text","text":" is generated only when at least one case has a marker. Without any marker nothing is generated, so the default "},{"code":".push","type":"codeVoice"},{"type":"text","text":" of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route"},{"type":"text","text":" applies and a hand-written "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" keeps compiling."}]}]},{"content":[{"inlineContent":[{"text":"Markers compose with ","type":"text"},{"code":"@RouteName(.delegate)","type":"codeVoice"},{"text":". ","type":"text"},{"code":".delegate","type":"codeVoice"},{"text":" only affects ","type":"text"},{"code":"name","type":"codeVoice"},{"text":"; the parent’s marker decides the ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":" (the child’s ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":" is never consulted). ","type":"text"},{"code":"@Sheet @RouteName(.delegate) case form(FormRoute)","type":"codeVoice"},{"text":" presents the child flow in a sheet and derives its name from the child.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A marker on a case declaring several elements (","type":"text"},{"code":"@Cover case a, b","type":"codeVoice"},{"text":") applies to every element.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"withStack","type":"codeVoice"},{"type":"text","text":" must be a literal "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"anchor":"Tab-Routes","level":2,"type":"heading","text":"Tab Routes"},{"type":"paragraph","inlineContent":[{"type":"tex