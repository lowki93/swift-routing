e.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Several routing type markers on the same case ("},{"code":"@Sheet @Cover","type":"codeVoice"},{"type":"text","text":", or the same marker twice). A case can carry only one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"withStack"},{"text":" that isn’t a literal ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A marker combined with a hand-written "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":" in the enum body."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first identifier of each "},{"type":"codeVoice","code":"\\(...)"},{"type":"text","text":" is checked. Errors further in the expression, such as a missing property in "},{"type":"codeVoice","code":"\\(arg0.title)"},{"type":"text","text":", are reported by the compiler on the generated code."}]},{"anchor":"Tabs","level":3,"type":"heading","text":"Tabs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The checks above also apply to "},{"code":"@TabRoutable","type":"codeVoice"},{"type":"text","text":". These are specific to tabs:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" attached to something other than an enum."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" on something other than an enum case, or on a case outside a "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" enum (including a hand-written "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":" or a "},{"type":"codeVoice","code":