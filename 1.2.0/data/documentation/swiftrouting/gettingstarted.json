":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftRouting","","@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            RoutingView(destination: HomeRoute.self, root: .home)","        }","    }","}"]},{"type":"heading","level":2,"text":"Step 4: Navigate Between Routes","anchor":"Step-4-Navigate-Between-Routes"},{"type":"paragraph","inlineContent":[{"text":"Access the router from the environment and use it to navigate:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct HomeView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        VStack {","            Text(\"Welcome Home\")","            ","            \/\/ Push navigation","            Button(\"View Details\") {","                router.push(HomeRoute.detail(id: 42))","            }","            ","            \/\/ Present as sheet","            Button(\"Open Settings\") {","                router.present(HomeRoute.settings)","            }","        }","    }","}"]},{"type":"heading","level":2,"text":"Navigation Methods","anchor":"Navigation-Methods"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" provides several navigation methods:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"push(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pushes a route onto the navigation stack"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"present(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Presents a route as a modal sheet","type":"text"}]}]],[[{"type":"paragraph","inlin