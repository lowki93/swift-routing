eRoot(_:)"}]}]]]},{"level":2,"text":"DeeplinkRoute Structure","type":"heading","anchor":"DeeplinkRoute-Structure"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"text":" defines how to navigate to a destination. Use factory methods for common scenarios:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Push a route onto the navigation stack",".push(.detail(id: 1))","","\/\/ Push with intermediate routes (builds navigation hierarchy)",".push(.detail(id: 1), path: [.list, .category(id: 5)])","","\/\/ Push with a new root",".push(.detail(id: 1), root: .home, path: [.list])","","\/\/ Present as a sheet",".present(.settings)",".present(.settings, withStack: false)  \/\/ Without navigation stack","","\/\/ Present as a full-screen cover",".cover(.onboarding)","","\/\/ Reset navigation without navigating to a new route",".popToRoot()",".popToRoot(root: .home)  \/\/ Reset and update root","","\/\/ Update root without additional navigation",".updateRoot(.dashboard)"]},{"level":3,"text":"Factory Methods","type":"heading","anchor":"Factory-Methods"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Factory","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".push(_:root:path:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Push a route onto the navigation stack","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".present(_:withStack:root:path:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Present as a sheet","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".cover(_:root:path:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present as a full-screen cover"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".popToRoot(root:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset navigation to root (no final route)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".updateRoot(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace the root route only"}]}]]]},{"level":3,"text":"Parameters","type":"heading","anchor":"Parameters"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"root"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional route to set as the new root (default: "},{"type":"codeVoice","code":"nil"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Presentation type for the final route: "},{"type":"codeVoice","code":".push"},{"type":"text","text":", "},{"type":"codeVoice","code":".sheet(withStack:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":".cover"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"route","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional final destination route (default: "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for reset scenarios)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"path"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Array of intermediate routes to push first (default: ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]]]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (e.g., with ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":"), the final navigation step is skipped. The ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" parameter is set automatically by factory methods.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"level":2,"text":"Handling Deep Links","type":"heading","anchor":"Handling-Deep-Links"},{"inlineContent":[{"text":"Use the router’s ","type":"text"},{"type":"codeVoice","code":"handle(deeplink:)"},{"text":" method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    var body: some View {","        RoutingView(destination: HomeRoute.self, root: .home) {","            HomeRootView()","        }","    }","}","","struct HomeRootView: View {","    @Environment(\\.router) private var router","    let handler = AppDeeplinkHandler()","","    var body: some View {","        HomeView()","            .onOpenURL { url in","                Task {","                    guard let identifier = DeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"The route type returned by ","type":"text"},{"type":"codeVoice","code":"DeeplinkHandler"},{"text":" (","type":"text"},{"type":"codeVoice","code":"D"},{"text":") must match the route type used by ","type":"text"},{"type":"codeVoice","code":"RoutingView(destination:root:)"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"What handle(deeplink:) Does","type":"heading","anchor":"What-handledeeplink-Does"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Closes all presented modals (","type":"text"},{"code":"closeChildren()","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pops to the root ("},{"code":"popToRoot()","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Optionally updates the root route (if "},{"code":"root","type":"codeVoice"},{"type":"text","text":" is set)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pushes intermediate routes from ","type":"text"},{"code":"path","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Navigates to the final route with the specified type (only if ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"orderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Step 5 is skipped when ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", making ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".updateRoot(_:)","type":"codeVoice"},{"text":" useful for reset scenarios without a final destination.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"Complete Example","type":"heading","anchor":"Complete-Example"},{"syntax":"swift","type":"codeListing","code":["\/\/ Deep link: reset to dashboard, build path, then push detail as sheet",".present(","    .orderDetail(id: orderId),","    root: .dashboard,","    path: [.orders, .orderList]",")"]},{"inlineContent":[{"text":"This will:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Close any presented modals"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pop to root"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":".dashboard"},{"type":"text","text":" as the new root"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Push ","type":"text"},{"code":".orders","type":"codeVoice"},{"text":" then ","type":"text"},{"code":".orderList","type":"codeVoice"},{"text":" onto the stack","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Present "},{"code":".orderDetail(id:)","type":"codeVoice"},{"type":"text","text":" as a sheet"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Async Deep Link Handling","type":"heading","anchor":"Async-Deep-Link-Handling"},{"inlineContent":[{"type":"text","text":"The "},{"code":"deeplink(from:)","type":"codeVoice"},{"type":"text","text":" method is "},{"code":"async","type":"codeVoice"},{"type":"text","text":", allowing you to fetch data before navigation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    switch route {","    case .product(let productId):","        \/\/ Fetch product details before navigating","        let product = try await productService.fetch(id: productId)","        return .push(.productDetail(product))","        ","    case .user(let userId):","        \/\/ Validate user exists","        guard await userService.exists(id: userId) else {","            return nil  \/\/ Return nil to ignore invalid deep links","        }","        return .push(.profile(userId: userId))","        ","    default:","        return nil","    }","}"]},{"level":2,"text":"Composing Deeplink Handlers (Nested Route Logic)","type":"heading","anchor":"Composing-Deeplink-Handlers-Nested-Route-Logic"},{"inlineContent":[{"type":"text","text":"For larger apps, compose deep link handling by feature instead of keeping all cases in one switch."},{"type":"text","text":" "},{"type":"text","text":"This works well with nested route structures."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let child): \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview: \"overview\"","        case .edit(let userId): \"edit(\\(userId))\"","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Create feature-level handlers:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum ProfileDeeplinkID: Hashable, Sendable {","    case profile(userId: String)","    case editProfile(userId: String)","}","","struct ProfileDeeplinkHandler: DeeplinkHandler {","    typealias R = ProfileDeeplinkID","    typealias D = AppRoute","","    func deeplink(from route: ProfileDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .profile(let userId):","            return .push(.profile(.overview), path: [.home])","        case .editProfile(let userId):","            return .push(.profile(.edit(userId: userId)))","        }","    }","}"]},{"inlineContent":[{"text":"Then compose at the app level:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum AppDeeplinkID: Hashable, Sendable {","    case home","    case profile(ProfileDeeplinkID)","    case reset","}","","struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkID","    typealias D = AppRoute","","    private let profileHandler = ProfileDeeplinkHandler()","","    func deeplink(from route: AppDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let profileID):","            return try await profileHandler.deeplink(from: profileID)","        case .reset:","            return .popToRoot()","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Benefits:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"keeps handlers small and feature-focused","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"mirrors your nested route architecture"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"makes deeplink behavior easier to test","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Tab-Based Deep Links","type":"heading","anchor":"Tab-Based-Deep-Links"},{"inlineContent":[{"text":"For apps with tab navigation, implement ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","type":"reference","isActive":true},{"text":" and return a ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","type":"reference","isActive":true},{"text":". The ","type":"text"},{"code":"deeplink","type":"codeVoice"},{"text":" property accepts any ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","type":"reference","isActive":true},{"text":", including reset scenarios with ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct AppTabDeeplinkHandler: TabDeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias T = HomeTab","    typealias D = HomeRoute","","    func deeplink(from route: DeeplinkIdentifier) async throws -> TabDeeplink<HomeTab, HomeRoute>? {","        switch route {","        case .profile(let userId):","            return TabDeeplink(","                tab: .profile,","                deeplink: .push(.profile(userId: userId))","            )","            ","        case .search(let query):","            return TabDeeplink(","                tab: .search,","                deeplink: .push(.searchResults(query: query), path: [.search])","            )","            ","        case .resetHome:","            return TabDeeplink(tab: .home, deeplink: .popToRoot())","            ","        default:","            return nil","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"handle(tabDeeplink:)","type":"codeVoice"},{"text":" method switches to the specified tab, then delegates to ","type":"text"},{"code":"handle(deeplink:)","type":"codeVoice"},{"text":" on that tab’s router. This means all ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"text":" factories work seamlessly within tabs, including ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":" for resetting a specific tab’s navigation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Handle with TabRouter:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.router) private var router","","func handleDeeplink(_ url: URL) async throws {","    guard let identifier = DeeplinkIdentifier(url: url) else { return }","    guard let tabDeeplink = try await handler.deeplink(from: identifier) else { return }","    router.tabRouter?.handle(tabDeeplink: tabDeeplink)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tabRouter"},{"text":" is injected inside ","type":"text"},{"type":"codeVoice","code":"RoutingTabView"},{"text":" descendants.","type":"text"},{"text":" ","type":"text"},{"text":"If deeplink handling is implemented in a parent container that owns ","type":"text"},{"type":"codeVoice","code":"RoutingTabView"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.router)"},{"text":" and then ","type":"text"},{"type":"codeVoice","code":"router.tabRouter"},{"text":" to