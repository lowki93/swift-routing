{"seeAlsoSections":[{"generated":true,"anchor":"Split-Navigation","title":"Split Navigation","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/splitnavigation"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"kind":"article","identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitNavigation","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" through "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel","isActive":true},{"type":"text","text":". All three columns (sidebar, content, detail) share the same split-type "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true},{"type":"text","text":" — column selection is driven by typed, "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values, and only the detail column has a navigation stack, bound directly to that shared router’s "},{"code":"path","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A split-type ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"text":" is created automatically and injected into the environment via ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.router)"},{"text":". It conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"},{"text":", giving you typed bindings and programmatic selection alongside the regular ","type":"text"},{"type":"codeVoice","code":"push"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"present"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"cover"},{"text":" API.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"2-Column Layout (Sidebar + Detail)","anchor":"2-Column-Layout-Sidebar-+-Detail"},{"inlineContent":[{"text":"The sidebar shows a fixed route; the detail column is derived from a typed selection:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","}"]},{"type":"heading","level":2,"text":"3-Column Layout (Sidebar + Content + Detail)","anchor":"3-Column-Layout-Sidebar-+-Content-+-Detail"},{"inlineContent":[{"type":"text","text":"Add a "},{"type":"codeVoice","code":"content:"},{"type":"text","text":" closure to introduce a middle column. The sidebar drives the content column, and the content column drives the detail column:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","} detail: { (player: Player) in","    AppRoute.player(player)","}"]},{"type":"heading","level":2,"text":"Driving Selections","anchor":"Driving-Selections"},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/detailBinding(as:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/contentBinding(as:)","isActive":true,"type":"reference"},{"type":"text","text":" to wire a "},{"code":"List","type":"codeVoice"},{"type":"text","text":" selection directly, or call "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)","isActive":true,"type":"reference"},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(content:)","isActive":true,"type":"reference"},{"type":"text","text":" programmatically. Both paths behave identically – the binding calls "},{"code":"select(detail:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"select(content:)","type":"codeVoice"},{"type":"text","text":" internally, so a selection made by tapping a "},{"code":"List","type":"codeVoice"},{"type":"text","text":" row logs a "},{"code":".navigation","type":"codeVoice"},{"type":"text","text":" event just like a programmatic call would."}],"type":"paragraph"},{"syntax":"swift","code":["struct SidebarScreen: View {","    @Environment(\\.router) var router","    let items: [PlayerType] = PlayerType.allCases","","    var body: some View {","        List(items, selection: router.detailBinding(as: PlayerType.self)) { item in","            NavigationLink(item.label, value: item)","        }","        .onFirstAppear {","            guard !router.isCompact else { return }","            router.select(detail: items.first)","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/hasContentColumn","type":"reference","isActive":true},{"type":"text","text":" to branch between driving the content or the detail column from the same sidebar code path:"}]},{"syntax":"swift","code":["if router.hasContentColumn {","    router.select(content: playerType)","} else {","    router.select(detail: playerType)","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"Compact Mode (iPhone)","anchor":"Compact-Mode-iPho