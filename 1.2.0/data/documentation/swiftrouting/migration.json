n, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After — Option 2: Native TabView with .tabToRoot","anchor":"After-Option-2-Native-TabView-with-tabToRoot"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For simpler cases without programmatic tab control:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(\\.router) private var router","    @State private var selectedTab: HomeTab = .home","","    var body: some View {","        TabView(selection: .tabToRoot(for: $selectedTab, in: router)) {","            RoutingView(tab: .home, destination: HomeRoute.self, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","","            RoutingView(tab: .search, destination: HomeRoute.self, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","","            RoutingView(tab: .profile, destination: HomeRoute.self, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":".tabToRoot"},{"text":" binding automatically pops to root when the user taps the already-selected tab.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This option does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" provide "},{"code":"@Environment(\\.tabRouter)","type":"codeVoice"},{"type":"text","text":". Use "},{"code":"RoutingTabView","type":"codeVoice"},{"type":"text","text":" when cross-tab programmatic navigation is needed."}]}],"name":"Important","style":"important"},{"type":"heading","level":2,"text":"Deep Links","anchor":"Deep-Links"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep link handling typically required parsing URLs and manually mutating "},{"type":"codeVoice","code":"NavigationPath"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".onOpenURL { url in","    if url.path == \"\/detail\" {","        path.append(\"detail\")","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a typed identifier enum ("},{"type":"codeVoice","code":"Hashable & Sendable"},{"type":"text","text":") to represent your deep link inputs, then implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler"},{"type":"text","text":" to map it to a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"type":"text","text":":"}]},{"type":"codeListing","code":["enum AppDeeplinkIdentifier: Hashable, Sendable {","    case detail(id: Int)","}","","extension AppDeeplinkIdentifier {","    init?(url: URL) {","        switch url.path {","        case \"\/detail\":","            guard let id = Int(url.lastPathComponent) else { return nil }","            self = .detail(id: id)","        default:","            return nil","        }","    }","}","","struct HomeDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkIdentifier","    typealias D = HomeRoute","","    func deeplink(from route: AppDeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","        switch route {","        case .detail(let id):","            return .push(.detail(id: id))","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Parse the URL into the identifier inside ","type":"text"},{"type":"codeVoice","code":".onOpenURL"},{"text":", then pass it to the handler:","type":"text"}]},{"type":"codeListing","code":["struct HomeRootView: View {