{"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Migrating from NavigationStack","modules":[{"name":"SwiftRouting"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"},"abstract":[{"type":"text","text":"Adopt SwiftRouting in an existing SwiftUI app with minimal disruption."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app already uses "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":", "},{"type":"codeVoice","code":"NavigationLink"},{"type":"text","text":", or native sheet\/cover modifiers, you can migrate to SwiftRouting incrementally. This guide walks through each common pattern and shows the equivalent SwiftRouting code."}]},{"type":"heading","level":2,"text":"NavigationStack → RoutingView","anchor":"NavigationStack-%E2%86%92-RoutingView"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"codeListing","code":["@State private var path = NavigationPath()","","var body: some View {","    NavigationStack(path: $path) {","        HomeView()","            .navigationDestination(for: String.self) { value in","                if value == \"detail\" {","                    DetailView()","                } else if value == \"settings\" {","                    SettingsView()","                }","            }","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your routes as a Swift enum, then replace the stack with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"type":"text","text":":"}]},{"type":"codeListing","code":["enum HomeRoute: Route {","    case home","    case detail(id: Int)","    case settings","","    var name: String {","        switch self {","        case .home: \"home\"","        case .detail(let id): \"detail(\\(id))\"","        case .settings: \"settings\"","        }","    }","}","","extension HomeRoute: RouteDestination {","    static func view(for route: HomeRoute) -> some View {","        switch route {","        case .home: HomeView()","        case .detail(let id): DetailView(id: id)","        case .settings: SettingsView()","        }","    }","}","","var body: some View {","    RoutingView(destination: HomeRoute.self, root: .home)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"navigationDestination"},{"type":"text","text":" registrations are replaced by a single "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":" conformance."}]},{"type":"heading","level":2,"text":"NavigationLink → router.push","anchor":"NavigationLink-%E2%86%92-routerpush"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"codeListing","code":["NavigationLink(\"View Details\", value: \"detail\")","","\/\/ Or with a destination view","NavigationLink(\"View Details\") {","    DetailView(id: 42)","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.push(_:)"},{"type":"text","text":" or the SwiftRouting "},{"type":"codeVoice","code":"NavigationLink(route:)"},{"type":"text","text":" extension:"}]},{"type":"codeListing","code":["\/\/ Programmatic push","Button(\"View Details\") {","    router.push(HomeRoute.detail(id: 42))","}","","\/\/ Declarative NavigationLink","NavigationLink(\"View Details\", route: HomeRoute.detail(id: 42))"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationLink(route:)"},{"type":"text","text":" performs push navigation only. For modal presentation, use "},{"type":"codeVoice","code":"router.present(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"router.cover(_:)"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important","style":"important"},{"type":"heading","level":2,"text":"Sheets → router.present","anchor":"Sheets-%E2%86%92-routerpresent"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"codeListing","code":["@State private var showSettings = false","","var body: some View {","    Button(\"Open Settings\") {","        showSettings = true","    }","    .sheet(isPresented: $showSettings) {","        SettingsView()","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"codeListing","code":["@Environment(\\.router) private var router","","Button(\"Open Settings\") {","    router.present(HomeRoute.settings)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need sheet presentation modifiers such as "},{"type":"codeVoice","code":"presentationDetents"},{"type":"text","text":", present without a navigation stack:"}]},{"type":"codeListing","code":["\/\/ In your route definition","var routingType: RoutingType { .sheet(withStack: false) }","","\/\/ Or inline","router.present(HomeRoute.settings, withStack: false)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Full-Screen Cover → router.cover","anchor":"Full-Screen-Cover-%E2%86%92-routercover"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"codeListing","code":["@State private var showOnboarding = false","","var body: some View {","    Button(\"Start Onboarding\") {","        showOnboarding = true","    }","    .fullScreenCover(isPresented: $showOnboarding) {","        OnboardingView()","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"codeListing","code":["Button(\"Start Onboarding\") {","    router.cover(HomeRoute.onboa