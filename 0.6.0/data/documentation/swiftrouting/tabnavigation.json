{"abstract":[{"type":"text","text":"Learn how to implement tab-based navigation with SwiftRouting."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/tabnavigation"]}],"metadata":{"title":"Tab Navigation","role":"article","modules":[{"name":"SwiftRouting"}],"roleHeading":"Article"},"seeAlsoSections":[{"title":"Tab Navigation","anchor":"Tab-Navigation","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/AnyTabRoute"],"generated":true}],"sections":[],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabNavigation","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for tab-based navigation through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Defining Tabs","anchor":"Defining-Tabs","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Create an enum conforming to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["enum HomeTab: TabRoute {","    case home","    case search","    case profile","    ","    var name: String {","        switch self {","        case .home: \"Home\"","        case .search: \"Search\"","        case .profile: \"Profile\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Option 1: Using RoutingTabView","anchor":"Option-1-Using-RoutingTabView","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","isActive":true,"type":"reference"},{"text":" provides a ","type":"text"},{"code":"TabRouter","type":"codeVoice"},{"text":" for programmatic tab control:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        RoutingTabView(tab: $selectedTab, destination: HomeRoute.self) { destination in","            RoutingView(tab: HomeTab.home, destination: destination, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: destination, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: destination, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Option 2: Using Native TabView","anchor":"Option-2-Using-Native-TabView","type":"heading","level":2},{"inlineContent":[{"text":"For simpler cases, use SwiftUI’s ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":".tabToRoot","type":"codeVoice"},{"text":" binding:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(\\.router) private var router","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        TabView(selection: .tabToRoot(for: $selectedTab, in: router)) {","            RoutingView(tab: HomeTab.home, destination: HomeRoute.self, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: HomeRoute.self, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: HomeRoute.self, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":".tabToRoot"},{"type":"text","text":" binding automatically pops to root when the user taps the already-selected tab."}]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"This native "},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" approach does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" provide a "},{"code":"TabRouter","type":"codeVoice"},{"type":"text","text":" in the environment."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":"RoutingTabView","type":"codeVoice"},{"type":"text","text":" when you need "},{"code":"@Environment(\\.tabRouter)","type":"codeVoice"},{"type":"text","text":" and cross-tab programmatic actions."}]}],"name":"Important"},{"anchor":"Using-TabRouter","level":2,"type":"heading","text":"Using TabRouter"},{"type":"paragraph","inlineContent":[{"text":"Access the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","type":"reference"},{"text":" from the environment to navigate across tabs:","type":"text"}]},{"code":["struct SomeView: View {","    @Environment(\\.tabRouter) private var tabRouter","    ","    var body: some View {","        Button(\"Go to Profile\") {","            \/\/ Switch to profile tab and push a route","            tabRouter?.push(HomeRoute.settings, in: HomeTab.profile)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"App-Level-Convenience-Overloads-Optional","level":3,"type":"heading","text":"App-Level Convenience Overloads (Optional)"},{"type":"paragraph","inlineContent":[{"text":"If your app uses one main route enum with nested feature routes, you can add","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TabRouterModel"},{"text":" overloads to improve call-site ergonomics (for example using","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".profile(...)"},{"text":" directly at call sites).","type":"text"}]},{"code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute, in: nil)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute, in: nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before:"}]},{"code":["tabRouter.push(HomeRoute.profile, in: nil)","tabRouter.present(HomeRoute.settings, in: nil)","tabRouter.update(root: HomeRoute.home, in: nil)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"After:"}],"type":"paragraph"},{"code":["tabRouter.push(.profile)","tabRouter.present(.settings)","tabRouter.update(root: .home)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can apply the same pattern for your main tab enum as well:"}],"type":"paragraph"},{"code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute, in tab: HomeTab?) {","        push(homeRoute, in: tab as (any TabRoute)?)","    }","","    @_disfavoredOverload","    func popToRoot(in tab: HomeTab?) {","        popToRoot(in: tab as (any TabRoute)?)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Before:"}],"type":"paragraph"},{"code":["tabRouter.push(HomeRoute.profile, in: HomeTab.profile)","tabRouter.popToRoot(in: HomeTab.profile)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"After:","type":"text"}],"type":"paragraph"},{"code":["tabRouter.push(.profile, in: .profile)","tabRouter.popToRoot(in: .profile)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"TabRouter Methods","anchor":"TabRouter-Methods","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"change(tab:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Switch to a different tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"push(_:in:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Push a route in a specific tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"present(_:in:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a sheet in a specific tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cover(_:in:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Present a cover in a specific tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"update(root:in:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Update the root of a specific tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"popToRoot(in:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pop to root in a specific tab","type":