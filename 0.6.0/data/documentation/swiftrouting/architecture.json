ce","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Injects it into the environment via ","type":"text"},{"code":"@Environment(\\.router)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Registers the "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":" for navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Manages sheet and cover presentations","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Router","anchor":"Router"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" manages:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Navigation path"}]},{"text":": The stack of pushed routes","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Root route"}],"type":"strong"},{"text":": The initial route displayed","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Presentations"}]},{"type":"text","text":": Sheet and cover modals"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Context observers","type":"text"}]},{"type":"text","text":": Registered "},{"code":"RouteContext","type":"codeVoice"},{"type":"text","text":" handlers"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Child routers"}],"type":"strong"},{"type":"text","text":": Routers created by presented modals"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"TabRouter","anchor":"TabRouter"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","isActive":