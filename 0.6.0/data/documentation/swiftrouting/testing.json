{"kind":"article","identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Testing","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Learn how to write unit tests for your navigation logic."}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"SwiftRouting is designed with testability in mind. The protocol-based architecture allows you to mock routers and verify navigation behavior without running UI tests.","type":"text"}]},{"type":"heading","anchor":"Testing-Strategies","level":2,"text":"Testing Strategies"},{"type":"heading","anchor":"Strategy-1-RouterSpy","level":3,"text":"Strategy 1: RouterSpy"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" has grown a fair amount of surface (push, present, cover, context handling, split selections…), so hand-rolling a mock for every test is tedious and easy to let drift out of sync with the protocol. Add the companion package instead:"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"0.2.0\"))","]"],"syntax":"swift"},{"type":"codeListing","code":[".product(name: \"SwiftRoutingTestSupport\", package: \"swift-routing\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"RouterSpy","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"RouterModel","type":"codeVoice"},{"text":" and records every call instead of performing real navigation:","type":"text"}]},{"type":"codeListing","code":["import SwiftRoutingTestSupport","","let spy = RouterSpy(root: AppRoute.home)","spy.push(AppRoute.profile(userId: \"123\"))","","#expect(spy.pushedRoutes.count == 1)","#expect((spy.pushedRoutes.first as? AppRoute) == .profile(userId: \"123\"))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"routedDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"backCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeChildrenCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"terminatedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"dispatchedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"addedContextTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"removedContextTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"detailSelections"},{"type":"text","text":", "},{"type":"codeVoice","code":"contentSelections"},{"type":"text","text":" — plus live "},{"type":"codeVoice","code":"currentRoute"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"pathCount"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"detailSelection"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"contentSelection"},{"type":"text","text":" that update as calls happen."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"code":"tabRouter(for:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"findRouterInTabRouter(for:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"deepestRouter()","type":"codeVoice"},{"text":" always return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"RouterSpy","type":"codeVoice"},{"text":" — there’s no real router hierarchy behind it. Test code that depends on those against a real ","type":"text"},{"code":"Router","type":"codeVoice"},{"text":" instead.","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","anchor":"Strategy-2-Test-ViewModel-Navigation","level":3,"text":"Strategy 2: Test ViewModel Navigation"},{"type":"paragraph","inlineContent":[{"text":"Inject the spy into your ViewModel:","type":"text"}]},{"type":"codeListing","code":["@MainActor","final class ProfileViewModel {","    private let router: any RouterModel","    private let userId: String","    ","    init(router: any RouterModel, userId: String) {","        self.router = router","        self.userId = userId","    }","    ","    func editProfile() {","        router.push(ProfileRoute.edit(userId: userId))","    }","    ","    func openSettings() {","        router.present(ProfileRoute.settings)","    }","    ","    func logout() {","        router.popToRoot()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test the navigation behavior:"}]},{"type":"codeListing","code":["import Testing","","@Suite(\"ProfileViewModel Navigation\")","struct ProfileViewModelTests {","    ","    @Test","    @MainActor","    func editProfile_pushesEditRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.editProfile()","        ","        #expect(spy.pushedRoutes.count == 1)","        let pushedRoute = spy.pushedRoutes.first as? ProfileRoute","        #expect(pushedRoute == .edit(userId: \"123\"))","    }","    ","    @Test","    @MainActor","    func openSettings_presentsSettingsRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.openSettings()","        ","        #expect(spy.presentedRoutes.count == 1)","        let presentedRoute = spy.presentedRoutes.first?.route as? ProfileRoute","        #expect(presentedRoute == .settings)","    }","    ","    @Test","    @MainActor","    func logout_popsToRoot() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.logout()","        ","        #expect(spy.popToRootCallCount == 1)","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Testing-RouteContext","level":2,"text":"Testing RouteContext"},{"type":"heading","anchor":"Testing-Context-Sending","level":3,"text":"Testing Context Sending"},{"type":"codeListing","code":["@Test","@MainActor","func selectUser_terminatesWithContext() {","    let spy = RouterSpy(root: AppRoute.userPicker)","    let viewModel = UserPickerViewModel(router: spy)","    let user = User(id: \"1\", name: \"John\")","    ","    viewModel.selectUser(user)","    ","    #expect(spy.terminatedContexts.count == 1)","    let context = spy.terminatedContexts.first as? UserSelectionContext","    #expect(context?.selectedUser.id == \"1\")","}"],"syntax":"swift"},{"type":"heading","anchor":"Testing-Context-Reception","level":3,"text":"Testing Context Reception"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For testing context handlers, use a real "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"type":"text","text":" instance:"}]},{"type":"codeListing","code":["@Test","@MainActor","func contextHandler_receivesContext() async {","    let router = Router(configuration: .default)","    var receivedUser: User?","    ","    router.add(context: UserSelectionContext.self) { context in","        receivedUser = context.selectedUser","    }","    ","    let user = User(id: \"1\", name: \"John\")","    router.context(UserSelectionContext(selectedUser: user))","    ","    #expect(receivedUser?.id == \"1\")","}"],"syntax":"swift"},{"type":"heading","anchor":"Testing-Deep-Links","level":2,"text":"Testing Deep Links"},{"type":"heading","anchor":"Testing-DeeplinkHandler","level":3,"text":"Testing DeeplinkHandler"},{"type":"codeListing","code":["struct TestDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias D = AppRoute","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let userId):","            return .push(.profile(userId: userId))","        case .settings:","            return .present(.settings)","        default:","            return nil","        }","    }","}","","@Suite(\"DeeplinkHandler\")","struct DeeplinkHandlerTests {","    ","    @Test","    func homeIdentifier_returnsPushHome() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .home)","        ","        #expect(deeplink?.route == .home)","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func profileIdentifier_returnsPushWithUserId() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .profile(userId: \"123\"))","        ","        #expect(deeplink?.route == .profile(userId: \"123\"))","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func settingsIdentifier_returnsPresent() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .settings)","        ","        #expect(deeplink?.route == .settings)","        #expect(deeplink?.type == .sheet(withStack: true))","    }","    ","    @Test","    func unknownIdentifier_returnsNil() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .unknown)","        ","        #expect(deeplink == nil)","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Testing-DeeplinkRoute-Factories","level":3,"text":"Testing DeeplinkRoute Factories"},{"type":"codeListing","code":["@Suite(\"DeeplinkRoute Factories\")","struct DeeplinkRouteFactoryTests {","    ","    @Test","    func push_createsCorrectDeeplink() {","        let deeplink: DeeplinkRoute<AppRoute> = .push(.home, path: [.list])","        ","        #expect(deeplink.route == .home)","        #expect(deeplink.type == .push)","        #expect(deeplink.path.count == 1)","    }","    ","    @Test","    func popToRoot_hasNilRoute() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot()","        ","        #expect(deeplink.route == nil)","    }","    ","    @Test","    func popToRootWithRoot_setsRoot() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot(root: .dashboard)","        ","        #expect(deeplink.root == .dashboard)","        #expect(deeplink.route == nil)","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Testing-TabRouter-Navigation","level":2,"text":"Testing TabRouter Navigation"},{"type":"paragraph","inlineContent":[{"code":"TabRouterSpy","type":"codeVoice"},{"text":", from the same ","type":"text"},{"code":"SwiftRoutingTestSupport","type":"codeVoice"},{"text":" package, conforms to ","type":"text"},{"code":"TabRouterModel","type":"codeVoice"},{"text":" the same way:","type":"text"}]},{"type":"codeListing","code":["import SwiftRoutingTestSupport","","@Test","@MainActor","func crossTabNavigation_pushesToCorrectTab() {","    let spy = TabRouterSpy(root: AppRoute.home)","    let viewModel = HomeViewModel(tabRouter: spy)","    ","    viewModel.goToProfile(userId: \"123\")","    ","    #expect(spy.pushedRoutes.count == 1)","    let call = spy.pushedRoutes.first","    #expect((call?.route as? AppRoute) == .profile(userId: \"123\"))","    #expect((call?.tab as? AppTab) == .profile)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Available recorded state: ","type":"text"},{"code":"changedTabs","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pushedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"presentedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"coveredRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"updatedRoots","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popToRootTabs","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Best-Practices","level":2,"text":"Best Practices"},{"type":"heading","anchor":"Use-Protocol-Types","level":3,"text":"Use Protocol Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always inject "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" or "},{"type":"codeVoice","code":"any TabRouterModel"},{"type":"text","text":" instead of concrete types:"}]},{"type":"codeListing","code":["\/\/ Good: Protocol type enables mocking","init(router: any RouterModel) { ... }","","\/\/ Avoid: Concrete type is harder to test","init(router: Router) { ... }"],"syntax":"swift"},{"type":"heading","anchor":"Test-Navigation-Intent-Not-Implementation","level":3,"text":"Test Navigation Intent, Not Implementation"},{"type":"paragraph","inlineContent":[{"text":"Focus on ","type":"text"},{"inlineContent":[{"type":"text","text":"what"}],"type":"emphasis"},{"text":" navigation should happen, not ","type":"text"},{"inlineContent":[{"type":"text","text":"how"}],"type":"emphasis"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ Good: Tests the intent","#expect(spy.pushedRoutes.contains { ($0 as? AppRoute) == .profile(userId: \"123\") })","","\/\/ Avoid: Testing implementation details","#expect(spy.pathCount == 2)"],"syntax":"swift"},{"type":"heading","anchor":"Prefer-RouterSpy-Over-Hand-Rolled-Mocks","level":3,"text":"Prefer RouterSpy Over Hand-Rolled Mocks"},{"type":"paragraph","inlineContent":[{"code":"RouterModel","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"TabRouterModel","type":"codeVoice"},{"type":"text","text":" have grown a fair amount of surface, and a hand-rolled mock silently drifts out of sync every time the protocol changes. "},{"code":"RouterSpy","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"TabRouterSpy","type":"codeVoice"},{"type":"text","text":" are tested against the real protocols, so use them instead of writing your own unless a test needs custom behavior a spy can’t express."}]},{"type":"heading","anchor":"Test-Async-Handlers","level":3,"text":"Test Async Handlers"},{"type":"paragraph","inlineContent":[{"text":"Deep link handlers are async. Use Swift Testing’s async support:","type":"text"}]},{"type":"codeListing","code":["@Test","func asyncDeeplinkHandler() async throws {","    let handler = MyDeeplinkHandler()","    let result = try await handler.deeplink(from: .someIdentifier)","    #expect(result != nil)","}"],"syntax":"swift"}],"kind":"content"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftRouting"}],"role":"collectionGroup","title":"Testing Navigation"},"variants":[{"paths":["\/documentation\/swiftrouting\/testing"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"Related","title":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"]}],"references":{"doc://SwiftRouting/documentation/SwiftRouting":{"url":"\/documentation\/swiftrouting","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","type":"topic","title":"SwiftRouting","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","t