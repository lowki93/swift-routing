{"kind":"article","abstract":[{"text":"Learn how to set up SwiftRouting and perform your first navigation.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftrouting\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"modules":[{"name":"SwiftRouting"}],"roleHeading":"Article","role":"article","title":"Getting Started with SwiftRouting"},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks you through the essential steps to integrate SwiftRouting into your SwiftUI app. You’ll learn how to define routes, map them to views, and perform navigation."}],"type":"paragraph"},{"level":2,"text":"Installation","anchor":"Installation","type":"heading"},{"inlineContent":[{"text":"Add SwiftRouting to your project using Swift Package Manager:","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"1.0.0\"))","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add the product to your target:"}],"type":"paragraph"},{"code":[".product(name: \"SwiftRouting\", package: \"swift-routing\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 1: Define Your Routes","anchor":"Step-1-Define-Your-Routes","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an enum that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route"},{"type":"text","text":". Each case represents a navigable destination in your app."}],"type":"paragraph"},{"code":["import SwiftRouting","","enum HomeRoute: Route {","    case home","    case detail(id: Int)","    case settings","    ","    var name: String {","        switch self {","        case .home: \"home\"","        case .detail(let id): \"detail(\\(id))\"","        case .settings: \"settings\"","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"name"},{"type":"text","text":" property provides a human-readable identifier for logging and debugging."}],"type":"paragraph"},{"text":"Step 2: Map Routes to Views","type":"heading","level":2,"anchor":"Step-2-Map-Routes-to-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Extend your route enum to conform to "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","isActive":true},{"type":"text","text":". This protocol defines which view should be displayed for each route."}]},{"type":"codeListing","syntax":"swift","code":["extension HomeRoute: RouteDestination {","    static func view(for route: HomeRoute) -> some View {","        switch route {","        case .home:","            HomeView()","        case .detail(let id):","            DetailView(id: id)","        case .settings:","            SettingsView()","        }","    }","}"]},{"text":"Step 3: Create a RoutingView","type":"heading","level":2,"anchor":"Step-3-Create-a-RoutingView"},{"type":"paragraph","inlineContent":[{"text":"Replace your ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":" with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"text":". This creates a navigation stack with an associated ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import SwiftRouting","","@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            RoutingView(destination: HomeRoute.self, root: .home)","        }","    }","}"]},{"text":"Step 4: Navigate Between Routes","type":"heading","level":2,"anchor":"Step-4-Navigate-Between-Routes"},{"type":"paragraph","inlineContent":[{"text":"Access the router from the environment and use it to navigate:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct HomeView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        VStack {","            Text(\"Welcome Home\")","            ","            \/\/ Push navigation","            Button(\"View Details\") {","                router.push(HomeRoute.detail(id: 42))","            }","            ","            \/\/ Present as sheet","            Button(\"Open Settings\") {","                router.present(HomeRoute.settings)","            }","        }","    }","}"]},{"text":"Navigation Methods","type":"heading","level":2,"anchor":"Navigation-Methods"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"text":" provides several navigation methods:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"push(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pushes a route onto the navigation stack","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"present(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents a route as a modal sheet","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cover(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents a route as a full-screen cover","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"back()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Navigates back one step"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"popToRoot()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns to the root of the stack"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"close()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismisses a presented modal"}]}]]],"header":"row","type":"table"},{"text":"Using NavigationLink","type":"heading","anchor":"Using-NavigationLink","level":2},{"inlineContent":[{"text":"You can also use ","type":"text"},{"type":"codeVoice","code":"NavigationLink"},{"text":" with your routes:","type":"text"}],"type":"paragraph"},{"code":["NavigationLink(route: HomeRoute.detail(id: 42)) {","    Text(\"View Details\")","}","","\/\/ Or with a string label","NavigationLink(\"View Details\", route: HomeRoute.detail(id: 42))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"NavigationLink(route:)"},{"text":" performs push navigation in the current stack.","type":"text"},{"text":" ","type":"text"},{"text":"For modal presentation, use ","type":"text"},{"type":"codeVoice","code":"router.present(...)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"router.cover(...)"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Next Steps","type":"heading","anchor":"Next-Steps","level":2},{"inlineContent":[{"text":"Now that you have the basics, explore these topics:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DefiningRoutes","isActive":true},{"type":