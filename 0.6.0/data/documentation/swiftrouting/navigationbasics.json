{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiftRouting"}],"title":"Navigation Basics"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel"],"title":"Navigation","generated":true,"anchor":"Navigation"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/navigationbasics"]}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"sections":[],"kind":"article","abstract":[{"text":"Learn how to navigate between routes using the Router.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference"},{"text":" is your primary interface for programmatic navigation. Every ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference"},{"text":" creates its own router, accessible via the SwiftUI environment.","type":"text"}]},{"anchor":"Accessing-the-Router","type":"heading","level":2,"text":"Accessing the Router"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" property wrapper to access the router:"}]},{"code":["struct MyView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        Button(\"Navigate\") {","            router.push(HomeRoute.detail(id: 42))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Push-Navigation","type":"heading","level":2,"text":"Push Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Push adds a route to the navigation stack with a standard slide animation:"}]},{"code":["\/\/ Push a new route","router.push(HomeRoute.detail(id: 42))","","\/\/ Using NavigationLink","NavigationLink(route: HomeRoute.detail(id: 42)) {","    Text(\"View Details\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"NavigationLink-Behavior","type":"heading","level":3,"text":"NavigationLink Behavior"},{"type":"paragraph","inlineContent":[{"code":"NavigationLink(route:)","type":"codeVoice"},{"type":"text","text":" is push-only (stack navigation), because it uses"},{"type":"text","text":" "},{"code":"NavigationLink(value:)","type":"codeVoice"},{"type":"text","text":" with route values."}]},{"type":"paragraph","inlineContent":[{"text":"Important notes:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"It must be used inside a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":" configured with a matching "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It does not perform modal presentation, even if the route has a modal ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"For modal flows, prefer ","type":"text"},{"type":"codeVoice","code":"router.present(...)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"router.cover(...)"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Modal Presentations","type":"heading","level":2,"anchor":"Modal-Presentations"},{"text":"Sheet","type":"heading","level":3,"anchor":"Sheet"},{"inlineContent":[{"type":"text","text":"Present a route as a modal sheet:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ With navigation stack (default)","router.present(HomeRoute.settings)","","\/\/ Without navigation stack","router.present(HomeRoute.settings, withStack: false)"]},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"withStack: false"},{"text":" when the presented destination needs direct sheet modifiers such as:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".presentationDetents([.medium])",".presentationDragIndicator(.visible)"]},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"withStack: true"},{"type":"text","text":" (default), the route is wrapped in a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":", which can make these modifiers less predictable on the final destination view."}],"type":"paragraph"},{"text":"Full-Screen Cover","type":"heading","level":3,"anchor":"Full-Screen-Cover"},{"inlineContent":[{"text":"Present a route as a full-screen cover:","type":"text"}],"type":"paragraph"},{"code":["router.cover(HomeRoute.onboarding)"],"syntax":"swift","type":"codeListing"},{"text":"Navigating Back","level":2,"anchor":"Navigating-Back","type":"heading"},{"text":"Back One Step","level":3,"anchor":"Back-One-Step","type":"heading"},{"inlineContent":[{"text":"Remove the top route from the stack:","type":"text"}],"type":"paragraph"},{"code":["router.back()"],"syntax":"swift","type":"codeListing"},{"text":"Pop to Root","level":3,"anchor":"Pop-to-Root","type":"heading"},{"inlineContent":[{"type":"text","text":"Return to the root of the navigation stack:"}],"type":"paragraph"},{"code":["router.popToRoot()"],"syntax":"swift","type":"codeListing"},{"text":"Close Modal","level":3,"anchor":"Close-Modal","type":"heading"},{"inlineContent":[{"text":"Dismiss a presented sheet or cover:","type":"text"}],"type":"paragraph"},{"code":["router.close()"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" only works on routers that are presented (sheets or covers).","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Updating the Root","level":2,"anchor":"Updating-the-Root","type":"heading"},{"inlineContent":[{"type":"text","text":"Replace the current root route:"}],"type":"paragraph"},{"code":["router.update(root: HomeRoute.dashboard)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is useful for scenarios like switching between logged-in and logged-out states."}],"type":"paragraph"},{"text":"Using routingType","level":2,"anchor":"Using-routingType","type":"heading"},{"inlineContent":[{"type":"text","text":"Instead of calling specific methods, you can use "},{"code":"route(_:)","type":"codeVoice"},{"type":"text","text":" which respects the route’s "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ This will use the route's defined routingType","router.route(HomeRoute.settings)","","\/\/ Equivalent to checking routingType and calling the appropriate method","switch route.routingType {","case .push: router.push(route)","case .sheet: router.present(route)","case .cover: router.cover(route)","case .root: router.update(root: route)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For routes that require sheet presentation customizations ("},{"type":"codeVoice","code":"presentationDetents"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentationDragIndicator"},{"type":"text","text":"), prefer:"}],"type":"paragraph"},{"syntax":"swift","code":["var routingType: RoutingType { .sheet(withStack: false) }"],"type":"codeListing"},{"text":"Router Properties","level":2,"anchor":"Router-Properties","type":"heading"},{"inlineContent":[{"type":"text","text":"The router provides useful properties for UI decisions:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Check if this router is presented as a modal","if router.isPresented {","    Button(\"Close\") { router.close() }","}","","\/\/ Get the current route","let current = router.currentRoute","","\/\/ Check navigation depth","if router.routeCount > 1 {","    Button(\"Back\") { router.back() }","}"],"type":"codeListing"},{"text":"Injecting Router into ViewModels","level":2,"anchor":"Injecting-Router-into-ViewModels","type":"heading"},{"inlineContent":[{"type":"text","text":"For MVVM architectures, inject the router using "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["class DetailViewModel: ObservableObject {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","    ","    func goToSettings() {","        router.present(HomeRoute.settings)","    }","}","","struct DetailView: View {","    @Environment(\\.router) private var router","    @StateObject private var viewModel: DetailViewModel","    ","    init() {","        \/\/ Note: Initialize in onAppear or use a factory","    }","    ","    var body: some View {","        \/\/ ...","    }","}"],"type":"codeListing"},{"text":"App-Level Convenience Overloads (Optional)","level":2,"anchor":"App-Level-Convenience-Overloads-Optional","type":"heading"},{"inlineContent":[{"type":"text","text":"If your app uses one main route enum (for example "},{"code":"HomeRoute","type":"codeVoice"},{"type":"text","text":"), you can add"},{"type":"text","text":" "},{"code":"RouterModel","type":"codeVoice"},{"type":"text","text":" overloads to improve call-site ergonomics:"}],"type":"paragraph"},{"syntax":"swift","code":["public extension RouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Before:"}],"type":"paragraph"},{"syntax":"swift","code":["router.push(HomeRoute.profile)","router.update(root: HomeRoute.home)"],"type":"codeListing"},{"inlineContent":[{"text":"After:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.push(.profile)","router.update(root: .home)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}],"type":"paragraph"},{"text":"Closing Child Routers","level":2,"anchor":"Closing-Child-Routers","type":"heading"},{"inlineContent":[{"text":"When handling deep links or resetting navigation, close all presented modals:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["router.closeChildren()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This dismisses any sheets or covers presented from this router."}],"type":"paragraph"},{"text":"Targeting the Frontmost Router","level":2,"anchor":"Targeting-the-Frontmost-Router","type":"heading"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":" always gives you the router for that view."},{"type":"text","text":" "},{"type":"text","text":"But at the "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" App level — where no environment is available — you hold a reference to"},{"type":"text","text":" "},{"type":"text","text":"the root router directly. In that case, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()"},{"type":"text","text":" to target whichever"},{"type":"text","text":" "},{"type":"text","text":"router is actually on screen at the moment the action fires:"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","  @State var rootRouter = Router(configuration: .default)","","  var body: some Scene {","    WindowGroup {","      ContentView()","        .environment(rootRouter)","        .onOpenURL { url in","          Task { @MainActor in","            rootRouter.deepestRouter()?.terminate(MyContext())","          }","        }","    }","  }","}"],"type":"codeListing"},{"inlineContent":[{"code":"deepestRouter()","type":"codeVoice"},{"text":" traverses the router tree depth-first, following the last live child at each","type":"text"},{"text":" ","type":"text"},{"text":"level until it reaches a leaf with no active children. If no child is active, it returns the","type":"text"},{"text":" ","type":"text"},{"text":"receiver itself.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" at dispatch time, not at setup time."},{"type":"text","text":" "},{"type":"text","text":"If a modal is on screen when the action fires, "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" returns that modal’s router"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" unwinds through the correct presenter."}]}],"type":"aside","name":"Important"}],"kind":"content"}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RoutingView"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"topic","url":