,"url":"\/documentation\/swiftrouting\/routermodel"},"doc://SwiftRouting/documentation/SwiftRouting":{"url":"\/documentation\/swiftrouting","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","type":"topic","title":"SwiftRouting","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","role":"collectionGroup","title":"FAQ","url":"\/documentation\/swiftrouting\/faq","kind":"article","abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting/Migration":{"abstract":[{"type":"text","text":"Adopt SwiftRouting in an existing SwiftUI app with minimal disruption."}],"role":"collectionGroup","url":"\/documentation\/swiftrouting\/migration","title":"Migrating from NavigationStack","kind":"article","type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"},"doc://SwiftRouting/documentation/SwiftRouting/Router":{"url":"\/documentation\/swiftrouting\/router","abstract":[{"text":"Manages programmatic navigation for both stack-based and split-view contexts.","type":"text"}],"type":"topic","role":"symbol","title":"Router","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Router"}],"kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","navigatorTitle":[{"kind":"identifier","text":"Router"}]}}}