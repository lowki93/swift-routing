{"abstract":[{"text":"Learn how to pass data between routes using RouteContext.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftRouting"}],"role":"article","title":"Route Context"},"variants":[{"paths":["\/documentation\/swiftrouting\/routecontextguide"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"},{"type":"text","text":" enables communication from child routes back to parent routes. Use it to pass selection results, form data, or completion signals up the navigation hierarchy."}]},{"level":2,"text":"What is RouteContext?","anchor":"What-is-RouteContext","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"RouteContext"},{"type":"text","text":" is any type conforming to "},{"type":"codeVoice","code":"Hashable & Sendable"},{"type":"text","text":". It acts as a message that can be sent from a child route and received by any ancestor route that registered an observer."}]},{"syntax":"swift","type":"codeListing","code":["struct UserSelectionContext: RouteContext {","    let selectedUser: User","}","","struct FormCompletionContext: RouteContext {","    let formData: FormData","    let success: Bool","}"]},{"level":2,"text":"Registering Context Observers","anchor":"Registering-Context-Observers","type":"heading"},{"level":3,"text":"Using the View Modifier","anchor":"Using-the-View-Modifier","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to observe contexts is with the "},{"type":"codeVoice","code":"routerContext"},{"type":"text","text":" modifier:"}]},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State private var selectedUser: User?","    ","    var body: some View {","        ContentView()","            .routerContext(UserSelectionContext.self) { context in","                selectedUser = context.selectedUser","            }","    }","}"]},{"level":3,"text":"Using Router Directly","anchor":"Using-Router-Directly","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For ViewModel-driven architectures, register observers via ","type":"text"},{"type":"codeVoice","code":"any RouterModel"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@MainActor","final class ParentViewModel: ObservableObject {","    private let router: any RouterModel","","    init(router: any RouterModel) {","        self.router = router","    }","","    func startObservingContext() {","        router.add(context: UserSelectionContext.self) { [weak self] context in","            self?.selectedUser = context.selectedUser","        }","    }","","    func stopObservingContext() {","        router.remove(context: UserSelectionContext.self)","    }","","    deinit {","        stopObservingContext()","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In views, prefer "},{"type":"codeVoice","code":".routerContext(...)"},{"type":"text","text":" for simple cases."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" in ViewModels when context handling belongs to presentation\/business logic."}]},{"type":"paragraph","inlineContent":[{"text":"Warning: Use weak captures for class references (for example view models) to prevent retain cycles.","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","anchor":"Sending-Context","level":2,"text":"Sending Context"},{"type":"paragraph","inlineContent":[{"text":"From a child route, send context using ","type":"text"},{"code":"context(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"terminate(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"heading","anchor":"context-Send-Without-Navigation","level":3,"text":"context(_:) - Send Without Navigation"},{"type":"paragraph","inlineContent":[{"text":"Sends the context to all observers without affecting navigation:","type":"text"}]},{"type":"codeListing","code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context but stay on this screen","                router.context(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"terminate-Send-and-Complete-Navigation","level":3,"text":"terminate(_:) - Send and Complete Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sends the context, then completes navigation based on router state:"}]},{"type":"codeListing","code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context and complete the current flow","                router.terminate(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"terminate(_:)"},{"text":" will:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Execute all matching context observers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If a matching local context anchor is found, pop back to that point in the current stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Otherwise, close the modal if the router is presented"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Otherwise, go back one step"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Context-Hierarchy","level":2,"text":"Context Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Contexts propagate up through the entire router hierarchy:"}]},{"type":"codeListing","code":["App Router","    └── Tab Router","            └── Home Router (observer registered here)","                    └── List Router","                            └── Detail Router (context sent from here)"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"When context is sent from Detail Router, it reaches the observer in Home Router.","type":"text"}]},{"type":"heading","anchor":"Removing-Observers","level":2,"text":"Removing Observers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observers are automatically removed when their route is popped. You can also remove them manually:"}]},{"type":"codeListing","code":["router.remove(context: UserSelectionContext.self)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"remove(context:)","type":"codeVoice"},{"text":" removes observers for that context type ","type":"text"},{"inlineContent":[{"text":"only on the current route","type":"text"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Common-Patterns","level":2,"text":"Common Patterns"},{"type":"heading","anchor":"Selection-Flow","level":3,"text":"Selection Flow"},{"type":"codeListing","code":["\/\/ Parent: Start selection","router.push(HomeRoute.userPicker)","","\/\/ Parent: Receive selection",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child: Complete selection","router.terminate(UserSelectionContext(selectedUser: user))"],"syntax":"swift"},{"type":"heading","anchor":"Form-Completion","level":3,"text":"Form Completion"},{"type":"codeListing","code":["\/\/ Parent",".routerContext(FormCompletionContext.self) { context in","    if context.success {","        showSuccessMessage()","    }","}","","\/\/ Child (form view)","func submitForm() async {","    let success = await api.submit(formData)","    router.terminate(FormCompletionContext(formData: formData, success: success))","}"],"syntax":"swift"},{"type":"heading","anchor":"Multi-Step-Wizard","level":3,"text":"Multi-Step Wizard"},{"type":"codeListing","code":["struct WizardContext: RouteContext {","    let step: Int","    let data: WizardData","}","","\/\/ Each step sends progress","router.context(WizardContext(step: currentStep, data: collectedData))","","\/\/ Final step terminates","router.terminate(WizardContext(step: finalStep, data: completeData))"],"syntax":"swift"},{"type":"heading","anchor":"Memory-Management","level":2,"text":"Memory Management"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Context closures can cause retain cycles. Always use weak references:"}]},{"type":"codeListing","code":["\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handleContext(context)","}","","\/\/ ✅ Correct with view model",".routerContext(MyContext.self) { [weak viewModel] context in","    viewModel?.process(context)","}","","\/\/ ❌ Wrong for class references - causes retain cycle","router.add(context: MyContext.self) { context in","    self.handleContext(context)  \/\/ Strong reference to self","}"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/RouteContext":{"title":"RouteContext","kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","navigatorTitle":[{"text":"RouteContext","kind":"identifier"}],"abstract":[{"text":"A type that can be used to pass data between routes and trigger navigation flow completions.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouteContext","kind":"identifier"}],"url":"\/documentation\/swiftrouting\/routecontext"},"doc://SwiftRouting/documentation/SwiftRouting":{"type":"topic","title":"SwiftRouting","role":"collection","url":"\/documentation\/swiftrouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","kind":"symbol","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"title":"FAQ","type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","kind":"article","role":"collectionGroup","url":"\/documentation\/swiftrouting\/faq","abstract":[{"type":"text","text":"Answers to common questions about SwiftRouting usage and design decisions."}]},"doc://SwiftRouting/documentation/SwiftRouting/Troubleshooting":{"role":"collectionGroup","title":"Troubleshooting","type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting","abstract":[{"type":"text","text":"Diagnose and fix common issues encountered when using SwiftRouting."}],"url":"\/documentation\/swiftrouting\/troubleshooting","kind":"article"}}}