: HomeRoute.self, root: .home)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Step 4: Navigate Between Routes","anchor":"Step-4-Navigate-Between-Routes","type":"heading","level":2},{"inlineContent":[{"text":"Access the router from the environment and use it to navigate:","type":"text"}],"type":"paragraph"},{"code":["struct HomeView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        VStack {","            Text(\"Welcome Home\")","            ","            \/\/ Push navigation","            Button(\"View Details\") {","                router.push(HomeRoute.detail(id: 42))","            }","            ","            \/\/ Present as sheet","            Button(\"Open Settings\") {","                router.present(HomeRoute.settings)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Navigation Methods","anchor":"Navigation-Methods","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"type":"text","text":" provides several navigation methods:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"push(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pushes a route onto the navigation stack","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"present(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presents a route as a modal sheet"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cover(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presents a route as a full-screen cover"}]}]],[[{"type":"paragraph","inlineContent":[{"type":