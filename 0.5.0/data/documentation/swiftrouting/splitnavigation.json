{"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"variants":[{"paths":["\/documentation\/swiftrouting\/splitnavigation"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Learn how to implement sidebar-based split navigation with SwiftRouting.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"],"anchor":"Split-Navigation","title":"Split Navigation"}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitNavigation","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"article","title":"Split Navigation","roleHeading":"Article","modules":[{"name":"SwiftRouting"}]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"},{"type":"text","text":". Each column (sidebar, content, detail) renders inside its own "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":", so it gets an independent navigation stack while column selection stays driven by typed, "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A split-type "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"type":"text","text":" is created automatically and injected into the environment via "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":". It conforms to "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel","type":"reference","isActive":true},{"type":"text","text":", giving you typed bindings and programmatic selection alongside the regular "},{"type":"codeVoice","code":"push"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"present"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"cover"},{"type":"text","text":" API."}],"type":"paragraph"},{"text":"2-Column Layout (Sidebar + Detail)","type":"heading","anchor":"2-Column-Layout-Sidebar-+-Detail","level":2},{"inlineContent":[{"type":"text","text":"The sidebar shows a fixed route; the detail column is derived from a typed selection:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","}"]},{"text":"3-Column Layout (Sidebar + Content + Detail)","type":"heading","anchor":"3-Column-Layout-Sidebar-+-Content-+-Detail","level":2},{"inlineContent":[{"text":"Add a ","type":"text"},{"code":"content:","type":"codeVoice"},{"text":" closure to introduce a middle column. The sidebar drives the content column, and the content column drives the detail column:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","} detail: { (player: Player) in","    AppRoute.player(player)","}"]},{"text":"Driving Selections","type":"heading","anchor":"Driving-Selections","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/detailBinding(as:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/contentBinding(as:)","type":"reference","isActive":true},{"type":"text","text":" to wire a "},{"code":"List","type":"codeVoice"},{"type":"text","text":" selection directly, or call "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)","type":"reference","isActive":true},{"type":"text","text":" \/ "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(content:)","type":"reference","isActive":true},{"type":"text","text":" programmatically:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SidebarScreen: View {","    @Environment(\\.router) var router","    let items: [PlayerType] = PlayerType.allCases","","    var body: some View {","        List(items, selection: router.detailBinding(as: PlayerType.self)) { item in","            NavigationLink(item.label, value: item)","        }","        .onFirstAppear {","            guard !router.isCompact else { return }","            router.select(detail: items.first)","        }","    }","}"]},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/hasContentColumn","isActive":true,"type":"reference"},{"text":" to branch between driving the content or the detail column from the same sidebar code path:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if router.hasContentColumn {","    router.select(content: playerType)","} else {","    router.select(detail: playerType)","}"]},{"text":"Compact Mode (iPhone)","type":"heading","anchor":"Compact-Mode-iPhone","level":2},{"inlineContent":[{"text":"On iPhone, ","type":"text"},{"type":"codeVoice","code":"NavigationSplitView"},{"text":" collapses into a single-column stack. Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/isCompact"},{"text":" to skip auto-selection and let the user tap to navigate instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onFirstAppear {","    guard !router.isCompact else { return }","    router.select(detail: items.first)","}"]},{"inlineContent":[{"type":"codeVoice","code":"isCompact"},{"type":"text","text":" reflects "},{"type":"codeVoice","code":"horizontalSizeClass"},{"type":"text","text":", so it also updates during iPad multitasking."}],"type":"paragraph"},{"text":"Navigating Within a Column","type":"heading","anchor":"Navigating-Within-a-Column","level":2},{"inlineContent":[{"type":"text","text":"Each column is its own "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":", so "},{"type":"codeVoice","code":"router.push(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":".present(_:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":".cover(_:)"},{"type":"text","text":" work the same way they do everywhere else in SwiftRouting — a push inside the detail column only affects the detail column’s stack."}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Split navigation does not currently integrate with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler"},{"text":". Resolve deep links to a selection value before setting it via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)"},{"text":" or a binding.","type":"text"}],"type":"paragraph"}]},{"text":"SplitModel Reference","type":"heading","anchor":"SplitModel-Reference","level":3},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"detailSelection"}]}],[{"type":"paragraph","inlineConte