"text":"Callbacks:"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Every layer must forward the closure manually","router.push(AppRoute.picker(onSelect: { user in","    self.selectedUser = user","}))"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Couples the route to the callback signature"}]}]},{"content":[{"inlineContent":[{"text":"Must be threaded through every intermediate view","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hard to refactor when the hierarchy changes","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"RouteContext:"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Parent registers once",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child sends when done, regardless of depth","router.terminate(UserSelectionContext(selectedUser: user))"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Decoupled: sender and receiver don’t reference each other","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Propagates up through the entire router hierarchy automatically","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Works the same whether the child is one or five levels deep"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" to handle both data passing and navigation in one call"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Use callbacks for simple, same-level communication. Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","type":"reference"},{"text":" when data needs to travel up multiple levels or when the naviga