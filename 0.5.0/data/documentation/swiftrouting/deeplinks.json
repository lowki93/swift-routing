{"abstract":[{"type":"text","text":"Learn how to handle deep links and navigate to specific routes."}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"SwiftRouting provides a flexible deep linking system through ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Creating-a-Deeplink-Handler","text":"Creating a Deeplink Handler","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Implement "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","type":"reference","isActive":true},{"type":"text","text":" to convert incoming URLs or identifiers into navigation routes:"}],"type":"paragraph"},{"type":"codeListing","code":["struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier  \/\/ Your input type","    typealias D = HomeRoute           \/\/ Your route type","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","        switch route {","        case .home:","            return .push(.home)","            ","        case .userProfile(let userId):","            return .push(.profile(userId: userId))","            ","        case .settings:","            return .present(.settings)","            ","        case .reset:","            return .popToRoot()","            ","        default:","            return nil","        }","    }","}"],"syntax":"swift"},{"anchor":"Choosing-the-Right-Factory","text":"Choosing the Right Factory","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scenario"}]}],[{"inlineContent":[{"text":"Factory","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Navigate to a screen in the stack","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".push(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Show a modal sheet"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".present(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Show a full-screen modal"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".cover(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Reset navigation (logout, clear state)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".popToRoot()"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Change root without clearing stack"}],"type":"paragraph"}],[{"inlineContent":[{"code":".updateRoot(_:)","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"DeeplinkRoute-Structure","text":"DeeplinkRoute Structure","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"type":"text","text":" defines how to navigate to a destination. Use factory methods for common scenarios:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Push a route onto the navigation stack",".push(.detail(id: 1))","","\/\/ Push with intermediate routes (builds navigation hierarchy)",".push(.detail(id: 1), path: [.list, .category(id: 5)])","","\/\/ Push with a new root",".push(.detail(id: 1), root: .home, path: [.list])","","\/\/ Present as a sheet",".present(.settings)",".present(.settings, withStack: false)  \/\/ Without navigation stack","","\/\/ Present as a full-screen cover",".cover(.onboarding)","","\/\/ Reset navigation without navigating to a new route",".popToRoot()",".popToRoot(root: .home)  \/\/ Reset and update root","","\/\/ Update root without additional navigation",".updateRoot(.dashboard)"],"syntax":"swift"},{"anchor":"Factory-Methods","text":"Factory Methods","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push(_:root:path:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Push a route onto the navigation stack"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".present(_:withStack:root:path:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Present as a sheet","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".cover(_:root:path:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Present as a full-screen cover","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popToRoot(root:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset navigation to root (no final route)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".updateRoot(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Replace the root route only","type":"text"}]}]]],"type":"table"},{"anchor":"Parameters","text":"Parameters","type":"heading","level":3},{"header":"row","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"root","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optional route to set as the new root (default: ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Presentation type for the final route: "},{"type":"codeVoice","code":".push"},{"type":"text","text":", "},{"type":"codeVoice","code":".sheet(withStack:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":".cover"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"route","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional final destination route (default: "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for reset scenarios)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"path"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Array of intermediate routes to push first (default: "},{"type":"codeVoice","code":"[]"},{"type":"text","text":")"}],"type":"paragraph"}]]],"type":"table"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"route","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (e.g., with ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":"), the final navigation step is skipped. The ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" parameter is set automatically by factory methods.","type":"text"}]}],"style":"note"},{"anchor":"Handling-Deep-Links","text":"Handling Deep Links","type":"heading","level":2},{"inlineContent":[{"text":"Use the router’s ","type":"text"},{"code":"handle(deeplink:)","type":"codeVoice"},{"text":" method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct ContentView: View {","    var body: some View {","        RoutingView(destination: HomeRoute.self, root: .home) {","            HomeRootView()","        }","    }","}","","struct HomeRootView: View {","    @Environment(\\.router) private var router","    let handler = AppDeeplinkHandler()","","    var body: some View {","        HomeView()","            .onOpenURL { url in","                Task {","                    guard let identifier = DeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"],"syntax":"swift"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"The route type returned by ","type":"text"},{"code":"DeeplinkHandler","type":"codeVoice"},{"text":" (","type":"text"},{"code":"D","type":"codeVoice"},{"text":") must match the route type used by ","type":"text"},{"code":"RoutingView(destination:root:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"anchor":"What-handledeeplink-Does","text":"What handle(deeplink:) Does","type":"heading","level":3},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Closes all presented modals (","type":"text"},{"code":"closeChildren()","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pops to the root ("},{"code":"popToRoot()","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optionally updates the root route (if ","type":"text"},{"code":"root","type":"codeVoice"},{"text":" is set)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Pushes intermediate routes from ","type":"text"},{"type":"codeVoice","code":"path"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Navigates to the final route with the specified type (only if "},{"code":"route","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"nil","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Step 5 is skipped when "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", making "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" and "},{"type":"codeVoice","code":".updateRoot(_:)"},{"type":"text","text":" useful for reset scenarios without a final destination."}]}],"style":"note"},{"anchor":"Complete-Example","text":"Complete Example","type":"heading","level":3},{"type":"codeListing","code":["\/\/ Deep link: reset to dashboard, build path, then push detail as sheet",".present(","    .orderDetail(id: orderId),","    root: .dashboard,","    path: [.orders, .orderList]",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This will:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Close any presented modals","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pop to root"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":".dashboard"},{"type":"text","text":" as the new root"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Push ","type":"text"},{"code":".orders","type":"codeVoice"},{"text":" then ","type":"text"},{"code":".orderList","type":"codeVoice"},{"text":" onto the stack","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Present ","type":"text"},{"type":"codeVoice","code":".orderDetail(id:)"},{"text":" as a sheet","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Async-Deep-Link-Handling","text":"Async Deep Link Handling","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"deeplink(from:)"},{"type":"text","text":" method is "},{"type":"codeVoice","code":"async"},{"type":"text","text":", allowing you to fetch data before navigation:"}],"type":"paragraph"},{"type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    switch route {","    case .product(let productId):","        \/\/ Fetch product details before navigating","        let product = try await productService.fetch(id: productId)","        return .push(.productDetail(product))","        ","    case .user(let userId):","        \/\/ Validate user exists","        guard await userService.exists(id: userId) else {","            return nil  \/\/ Return nil to ignore invalid deep links","        }","        return .push(.profile(userId: userId))","        ","    default:","        return nil","    }","}"],"syntax":"swift"},{"anchor":"Composing-Deeplink-Handlers-Nested-Route-Logic","text":"Composing Deeplink Handlers (Nested Route Logic)","type":"heading","level":2},{"inlineContent":[{"text":"For larger apps, compose deep link handling by feature instead of keeping all cases in one switch.","type":"text"},{"text":" ","type":"text"},{"text":"This works well with nested route structures.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let child): \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview: \"overview\"","        case .edit(let userId): \"edit(\\(userId))\"","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create feature-level handlers:"}],"type":"paragraph"},{"type":"codeListing","code":["enum ProfileDeeplinkID: Hashable, Sendable {","    case profile(userId: String)","    case editProfile(userId: String)","}","","struct ProfileDeeplinkHandler: DeeplinkHandler {","    typealias R = ProfileDeeplinkID","    typealias D = AppRoute","","    func deeplink(from route: ProfileDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .profile(let userId):","            return .push(.profile(.overview), path: [.home])","        case .editProfile(let userId):","            return .push(.profile(.edit(userId: userId)))","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Then compose at the app level:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["enum AppDeeplinkID: Hashable, Sendable {","    case home","    case profile(ProfileDeeplinkID)","    case reset","}","","struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkID","    typealias D = AppRoute","","    private let profileHandler = ProfileDeeplinkHandler()","","    func deeplink(from route: AppDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let profileID):","            return try await profileHandler.deeplink(from: profileID)","        case .reset:","            return .popToRoot()","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Benefits:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"keeps handlers small and feature-focused","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"mirrors your nested route architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"makes deeplink behavior easier to test"}]}]}]},{"anchor":"Tab-Based-Deep-Links","text":"Tab-Based Deep Links","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For apps with tab navigation, implement "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","isActive":true},{"type":"text","text":" and return a "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","isActive":true},{"type":"text","text":". The "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" property accepts any "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"type":"text","text":", including reset scenarios with "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["struct AppTabDeeplinkHandler: TabDeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias T = HomeTab","    typealias D = HomeRoute","","    func deeplink(from route: DeeplinkIdentifier) async throws -> TabDeeplink<HomeTab, HomeRoute>? {","        switch route {","        case .profile(let userId):","            return TabDeeplink(","                tab: .profile,","                deeplink: .push(.profile(userId: userId))","            )","            ","        case .search(let query):","            return TabDeeplink(","                tab: .search,","                deeplink: .push(.searchResults(query: query), path: [.search])","            )","            ","        case .resetHome:","            return TabDeeplink(tab: .home, deeplink: .popToRoot())","            ","        default:","            return nil","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"handle(tabDeeplink:)"},{"type":"text","text":" method switches to the specified tab, then delegates to "},{"type":"codeVoice","code":"handle(deeplink:)"},{"type":"text","text":" on that tab’s router. This means all "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true},{"type":"text","text":" factories work seamlessly within tabs, including "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" for resetting a specific tab’s navigation."}],"type":"paragraph"},{"inlineContent":[{"text":"Handle with TabRouter:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@Environment(\\.router) private var router","","func handleDeeplink(_ url: URL) async throws {","    guard let identifier = DeeplinkIdentifier(url: url) else { return }","    guard let tabDeeplink = try await handler.deeplink(from: identifier) else { return }","    router.tabRouter?.handle(tabDeeplink: tabDeeplink)","}"],"syntax":"swift"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"codeVoice","code":"tabRouter"},{"type":"text","text":" is injected inside "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":" descendants."},{"type":"text","text":" "},{"type":"text","text":"If deeplink handling is implemented in a parent container that owns "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"router.tabRouter"},{"type":"text","text":" to access the tab router."}],"type":"paragraph"}],"style":"note"},{"anchor":"Building-Navigation-Paths","text":"Building Navigation Paths","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For complex deep links, build a path of intermediate routes:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Deep link to: Home → Category → Subcategory → Product",".push(","    .product(id: productId),","    path: [","        .category(id: categoryId),","        .subcategory(id: subcategoryId)","    ]",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This ensures the back button works correctly through the entire hierarchy."}],"type":"paragraph"},{"anchor":"Resetting-Navigation","text":"Resetting Navigation","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" to reset navigation without navigating to a specific route:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Simply reset to root",".popToRoot()","","\/\/ Reset and change the root route",".popToRoot(root: .dashboard)","","\/\/ Update root only (no popToRoot, no path navigation)",".updateRoot(.newHome)"],"syntax":"swift"},{"inlineContent":[{"text":"These are useful for logout flows, session resets, or returning users to a clean state.","type":"text"}],"type":"paragraph"},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" from "},{"type":"codeVoice","code":"deeplink(from:)"},{"type":"text","text":" to ignore invalid deep links:"}],"type":"paragraph"},{"type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    guard isValidRoute(route) else {","        return nil  \/\/ Silently ignore","    }","    ","    \/\/ Or throw for error handling","    guard let data = try await fetchData(for: route) else {","        throw DeeplinkError.notFound","    }","    ","    return .push(.detail(data))","}"],"syntax":"swift"}],"kind":"content"}],"kind":"article","topicSections":[{"title":"Related","anchor":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRouteGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink"]}],"seeAlsoSections":[{"title":"Deep Linking","generated":true,"anchor":"Deep-Linking","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink"]}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftrouting\/deeplinks"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftRouting"}],"role":"collectionGroup","title":"Deep Linking","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftRouting/documentation/SwiftRouting/TabDeeplink":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","title":"TabDeeplink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TabDeeplink","kind":"identifier"}],"navigatorTitle":[{"text":"TabDeeplink","kind":"identifier"}],"url":"\/documentation\/swiftrouting\/tabdeeplink","abstract":[{"type":"text","text":"A structure representing a deep link associated with a specific tab."}]},"doc://SwiftRouting/documentation/SwiftRouting":{"type":"topic","title":"SwiftRouting","role":"collection","url":"\/documentation\/swiftrouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","kind":"symbol","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/TabDeeplinkHandler":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","role":"symbol","url":"\/documentation\/swiftrouting\/tabdeeplinkhandler","fragments":[{"text":"p