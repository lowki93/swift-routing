{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true},{"type":"text","text":" is your primary interface for programmatic navigation. Every "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","isActive":true},{"type":"text","text":" creates its own router, accessible via the SwiftUI environment."}]},{"level":2,"anchor":"Accessing-the-Router","type":"heading","text":"Accessing the Router"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" property wrapper to access the router:"}]},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        Button(\"Navigate\") {","            router.push(HomeRoute.detail(id: 42))","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Push-Navigation","type":"heading","text":"Push Navigation"},{"type":"paragraph","inlineContent":[{"text":"Push adds a route to the navigation stack with a standard slide animation:","type":"text"}]},{"syntax":"swift","code":["\/\/ Push a new route","router.push(HomeRoute.detail(id: 42))","","\/\/ Using NavigationLink","NavigationLink(route: HomeRoute.detail(id: 42)) {","    Text(\"View Details\")","}"],"type":"codeListing"},{"level":3,"anchor":"NavigationLink-Behavior","type":"heading","text":"NavigationLink Behavior"},{"type":"paragraph","inlineContent":[{"code":"NavigationLink(route:)","type":"codeVoice"},{"text":" is push-only (stack navigation), because it uses","type":"text"},{"text":" ","type":"text"},{"code":"NavigationLink(value:)","type":"codeVoice"},{"text":" with route values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Important notes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It must be used inside a "},{"code":"RoutingView","type":"codeVoice"},{"type":"text","text":" configured with a matching "},{"code":"RouteDestination","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It does not perform modal presentation, even if the route has a modal "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For modal flows, prefer ","type":"text"},{"code":"router.present(...)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"router.cover(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Modal Presentations","level":2,"anchor":"Modal-Presentations","type":"heading"},{"text":"Sheet","level":3,"anchor":"Sheet","type":"heading"},{"inlineContent":[{"type":"text","text":"Present a route as a modal sheet:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ With navigation stack (default)","router.present(HomeRoute.settings)","","\/\/ Without navigation stack","router.present(HomeRoute.settings, withStack: false)"]},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"withStack: false"},{"text":" when the presented destination needs direct sheet modifiers such as:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".presentationDetents([.medium])",".presentationDragIndicator(.visible)"]},{"inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"withStack: true"},{"text":" (default), the route is wrapped in a ","type":"text"},{"type":"codeVoice","code":"RoutingView"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":", which can make these modifiers less predictable on the final destination view.","type":"text"}],"type":"paragraph"},{"text":"Full-Screen Cover","level":3,"anchor":"Full-Screen-Cover","type":"heading"},{"inlineContent":[{"text":"Present a route as a full-screen cover:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["router.cover(HomeRoute.onboarding)"]},{"text":"Navigating Back","level":2,"type":"heading","anchor":"Navigating-Back"},{"text":"Back One Step","level":3,"type":"heading","anchor":"Back-One-Step"},{"type":"paragraph","inlineContent":[{"text":"Remove the top route from the stack:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["router.back()"]},{"text":"Pop to Root","level":3,"type":"heading","anchor":"Pop-to-Root"},{"type":"paragraph","inlineContent":[{"text":"Return to the root of the navigation stack:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["router.popToRoot()"]},{"text":"Close Modal","level":3,"type":"heading","anchor":"Close-Modal"},{"type":"paragraph","inlineContent":[{"text":"Dismiss a presented sheet or cover:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["router.close()"]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"close()"},{"type":"text","text":" only works on routers that are presented (sheets or covers)."}]}]},{"text":"Updating the Root","level":2,"type":"heading","anchor":"Updating-the-Root"},{"type":"paragraph","inlineContent":[{"text":"Replace the current root route:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["router.update(root: HomeRoute.dashboard)"]},{"type":"paragraph","inlineContent":[{"text":"This is useful for scenarios like switching between logged-in and logged-out states.","type":"text"}]},{"text":"Using routingType","level":2,"type":"heading","anchor":"Using-routingType"},{"type":"paragraph","inlineContent":[{"text":"Instead of calling specific methods, you can use ","type":"text"},{"code":"route(_:)","type":"codeVoice"},{"text":" which respects the route’s ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ This will use the route's defined routingType","router.route(HomeRoute.settings)","","\/\/ Equivalent to checking routingType and calling the appropriate method","switch route.routingType {","case .push: router.push(route)","case .sheet: router.present(route)","case .cover: router.cover(route)","case .root: router.update(root: route)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For routes that require sheet presentation customizations ("},{"code":"presentationDetents","type":"codeVoice"},{"type":"text","text":", "},{"code":"presentationDragIndicator","type":"codeVoice"},{"type":"text","text":"), prefer:"}]},{"type":"codeListing","syntax":"swift","code":["var routingType: RoutingType { .sheet(withStack: false) }"]},{"text":"Router Properties","level":2,"type":"heading","anchor":"Router-Properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The router provides useful properties for UI decisions:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check if this router is presented as a modal","if router.isPresented {","    Button(\"Close\") { router.close() }","}","","\/\/ Get the current route","let current = router.currentRoute","","\/\/ Check navigation depth","if router.routeCount > 1 {","    Button(\"Back\") { router.back() }","}"]},{"text":"Injecting Router into ViewModels","level":2,"type":"heading","anchor":"Injecting-Router-into-ViewModels"},{"type":"paragraph","inlineContent":[{"text":"For MVVM architectures, inject the router using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class DetailViewModel: ObservableObject {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","    ","    func goToSettings() {","        router.present(HomeRoute.settings)","    }","}","","struct DetailView: View {","    @Environment(\\.router) private var router","    @StateObject private var viewModel: DetailViewModel","    ","    init() {","        \/\/ Note: Initialize in onAppear or use a factory","    }","    ","    var body: some View {","        \/\/ ...","    }","}"]},{"text":"App-Level Convenience Overloads (Optional)","level":2,"type":"heading","anchor":"App-Level-Convenience-Overloads-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses one main route enum (for example "},{"type":"codeVoice","code":"HomeRoute"},{"type":"text","text":"), you can add"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" overloads to improve call-site ergonomics:"}]},{"type":"codeListing","syntax":"swift","code":["public extension RouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before:"}]},{"type":"codeListing","syntax":"swift","code":["router.push(HomeRoute.profile)","router.update(root: HomeRoute.home)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After:"}]},{"type":"codeListing","syntax":"swift","code":["router.push(.profile)","router.update(root: .home)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}]},{"text":"Closing Child Routers","level":2,"type":"heading","anchor":"Closing-Child-Routers"},{"type":"paragraph","inlineContent":[{"text":"When handling deep links or resetting navigation, close all presented modals:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["router.closeChildren()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This dismisses any sheets or covers presented from this router."}]},{"text":"Targeting the Frontmost Router","level":2,"type":"heading","anchor":"Targeting-the-Frontmost-Router"},{"type":"paragraph","inlineContent":[{"text":"Inside a ","type":"text"},{"code":"RoutingView","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Environment(\\.router)","type":"codeVoice"},{"text":" always gives you the router for that view.","type":"text"},{"text":" ","type":"text"},{"text":"But at the ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":" App level — where no environment is available — you hold a reference to","type":"text"},{"text":" ","type":"text"},{"text":"the root router directly. In that case, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()","type":"reference"},{"text":" to target whichever","type":"text"},{"text":" ","type":"text"},{"text":"router is actually on screen at the moment the action fires:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","  @State var rootRouter = Router(configuration: .default)","","  var body: some Scene {","    WindowGroup {","      ContentView()","        .environment(rootRouter)","        .onOpenURL { url in","          Task { @MainActor in","            rootRouter.deepestRouter()?.terminate(MyContext())","          }","        }","    }","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"deepestRouter()"},{"text":" traverses the router tree depth-first, following the last live child at each","type":"text"},{"text":" ","type":"text"},{"text":"level until it reaches a leaf with no active children. If no child is active, it returns the","type":"text"},{"text":" ","type":"text"},{"text":"receiver itself.","type":"text"}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" at dispatch time, not at setup time."},{"type":"text","text":" "},{"type":"text","text":"If a modal is on screen when the action fires, "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" returns that modal’s router"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" unwinds through the correct presenter."}],"type":"paragraph"}]}]}],"sections":[],"abstract":[{"type":"text","text":"Learn how to navigate between routes using the Router."}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"seeAlsoSections":[{"generated":true,"anchor":"Navigation","title":"Navigation","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel"]}],"kind":"article","variants":[{"paths":["\/documentation\/swiftrouting\/navigationbasics"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","interfaceLanguage":"swift"},"metadata":{"title":"Navigation Basics","role":"article","modules":[{"name":"SwiftRouting"}],"roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"title":"FAQ","type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","kind":"article","role":"collectionGroup","url":"\/documentation\/swiftrouting\/faq","abstract":[{"type":"text","text":"Answers to common questions about SwiftRouting usage and design decisions."}]},"doc://SwiftRouting/documentation/SwiftRouting/Migration":{"abstract":[{"type":"text","text":"Adopt SwiftRouting in an existing SwiftUI app with minimal disruption."}],"type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration","title":"Migrating from NavigationStack","url":"\/documentation\/swiftrouting\/migration","kind":"article","role":"collectionGroup"},"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftrouting\/routermodel","role":"symbol","title":"RouterModel","navigatorTitle":[{"text":"RouterModel","kind":"identifier"}],"abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","kind":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouterModel":{"kind":"symbol","url":"\/documentation\/swiftrouting\/baseroutermodel","title":"BaseRouterModel","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel","navigatorTitle":[{"kind":"identifier","text":"BaseRouterModel"}],"role":"symbol","abstract":[{"type":"text","text":"Defines the base navigation capabilities shared by all router types."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseRouterModel"}],"type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting":{"type":"topic","title":"SwiftRouting","role":"collection","url":"\/documentation\/swiftrouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","kind":"symbol","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","title":"RoutingView","abstract":[{"text":"Creates a navigation container with its own ","type":"text"},{"code":"Router","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoutingView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftrouting\/routingview"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouter/deepestRouter()":{"url":"\/documentation\/swiftrouting\/baserouter\/deepestrouter()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deepestRouter","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12SwiftRouting6RouterC","text":"Router","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[],"kind":"symbol","title":"deepestRouter()","role":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()","type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting/Router":{"title":"Router","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Router","kind":"identifier"}],"navigatorTitle":[{"text":"Router","kind":"identifier"}],"url":"\/documentation\/swiftrouting\/router","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","abstract":[{"type":"text","text":"Manages programmatic navigation for both stack-based and split-view contexts."}],"kind":"symbol","role":"symbol"}}}