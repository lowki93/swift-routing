":"codeListing","syntax":"swift","code":["\/\/ ✅ Correct — route and destination match","router.push(HomeRoute.detail(id: 42))","","\/\/ ❌ Wrong — route type doesn't match the active RoutingView","router.push(SettingsRoute.profile)"]},{"anchor":"ErrorView-Behavior","type":"heading","level":2,"text":"ErrorView Behavior"},{"type":"paragraph","inlineContent":[{"text":"When a route cannot be resolved, an error view is rendered. Its behavior depends on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Configuration","type":"reference"},{"text":":","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"codeVoice","code":"shouldCrashOnRouteNotFound"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Behavior","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"false","type":"codeVoice"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Displays the error message inline as "},{"type":"codeVoice","code":"Text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"true","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Crashes the app with ","type":"text"},{"type":"codeVoice","code":"fatalError"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" during development to catch routing mismatches immediately. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","type":"reference"},{"text":" for setup details.","type":"text"}]},{"anchor":"Context-Not-Received","type":"heading","level":2,"text":"Context Not Received"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a context is sent but no observer is triggered, check:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The observer is registered ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" the context is sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The observer is registered on the "},{"type":"strong","inlineContent":[{"text":"parent","type":"text"}]},{"type":"text","text":" router, not the child."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The context type matches exactly on both the sender and the observer side.","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Parent — register before navigation","router.add(context: UserSelectionContext.self) { [weak self] context in","    self?.selectedUser = context.selectedUser","}","","\/\/ Child — send context","router.context(UserSelectionContext(selectedUser: user))"]},{"anchor":"Memory-Leaks-with-Contexts","type":"heading","level":2,"text":"Memory Leaks with Contexts"},{"type":"paragraph","inlineContent":[{"text":"Retain cycles occur when closures capture ","type":"text"},{"code":"self","type":"codeVoice"},{"text":" strongly. Always use ","type":"text"},{"code":"[weak self]","type":"codeVoice"},{"text":" when referencing class instances:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ❌ Retain cycle","router.add(context: MyContext.self) { context in","    self.handle(context)","}","","\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handle(context)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observers registered outside of a view lifecycle (e.g., in a ViewModel) must be removed explicitly. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide"},{"type":"text","text":" for the full memory management guide."}]}],"kind":"content"}],"abstract":[{"text":"Diagnose and fix common issues encountered when using SwiftRouting.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftRouting\/