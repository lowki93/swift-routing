{"sections":[],"topicSections":[{"anchor":"Related","title":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Architecture"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftRouting is built around a few core principles: "},{"inlineContent":[{"type":"text","text":"separation of concerns"}],"type":"strong"},{"type":"text","text":", "},{"inlineContent":[{"text":"type safety","type":"text"}],"type":"strong"},{"type":"text","text":", and "},{"inlineContent":[{"text":"testability","type":"text"}],"type":"strong"},{"type":"text","text":". This guide explains how these principles shape the framework’s architecture."}]},{"text":"Design Principles","type":"heading","level":2,"anchor":"Design-Principles"},{"text":"Routes Are Data, Not Views","type":"heading","level":3,"anchor":"Routes-Are-Data-Not-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftRouting, routes are simple Swift enums that describe "},{"type":"emphasis","inlineContent":[{"text":"what","type":"text"}]},{"type":"text","text":" destination to navigate to, not "},{"type":"emphasis","inlineContent":[{"type":"text","text":"how"}]},{"type":"text","text":" to display it:"}]},{"syntax":"swift","code":["enum AppRoute: Route {","    case home","    case profile(userId: String)","    case settings","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view mapping is handled separately through "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":":"}]},{"syntax":"swift","code":["extension AppRoute: RouteDestination {","    static func view(for route: AppRoute) -> some View {","        switch route {","        case .home: HomeView()","        case .profile(let userId): ProfileView(userId: userId)","        case .settings: SettingsView()","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Why this separation?"}]}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Benefit"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Explanation","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reusability","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Routes can be used in navigation, deep links, analytics, and tests without view dependencies"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Testability","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test navigation logic by asserting on route values, not view hierarchies"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flexibility","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Change view implementations without touching route definitions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modularity"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Routes can live in a shared module; views in feature modules","type":"text"}]}]]]},{"text":"Protocol-Based Router","type":"heading","level":3,"anchor":"Protocol-Based-Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"text":" class implements the ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","isActive":true,"type":"reference"},{"text":" protocol, which defines all navigation operations:","type":"text"}]},{"syntax":"swift","code":["public protocol RouterModel {","    func push(_ route: some Route)","    func present(_ route: some Route, withStack: Bool)","    func cover(_ route: some Route)","    func back()","    func popToRoot()","    func close()","    \/\/ ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This protocol-based design enables:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dependency injection"}]},{"type":"text","text":" in ViewModels"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mocking"}]},{"type":"text","text":" for unit tests"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Abstraction"}]},{"type":"text","text":" over concrete router implementations"}]}]}]},{"text":"Hierarchical Router Structure","type":"heading","level":3,"anchor":"Hierarchical-Router-Structure"},{"type":"paragraph","inlineContent":[{"text":"SwiftRouting creates a hierarchy of routers that mirrors your navigation structure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Without tabs"}]},{"text":" (single stack):","type":"text"}]},{"syntax":null,"code":["App","└── RoutingView","    └── Router  root: .home","        ├── push(.list)","        │   └── Stack: [.home, .list]          (same Router)","        └── present(.detail)","            └── Router  root: .detail          (child Router, sheet)","                └── push(.comments)","                    └── Stack: [.detail, .comments]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"With tabs","type":"text"}]},{"text":":","type":"text"}]},{"syntax":null,"code":["App","└── RoutingTabView","    └── TabRouter","        ├── RoutingView [Home Tab]","        │   └── Router  root: .home","        │       ├── push(.list)","        │       │   └── Stack: [.home, .list]          (same Router)","        │       └── present(.detail)","        │           └── Router  root: .detail          (child Router, sheet)","        │               └── push(.comments)","        │                   └── Stack: [.detail, .comments]","        ├── RoutingView [Search Tab]","        │   └── Router  root: .search","        └── RoutingView [Profile Tab]","            └── Router  root: .profile"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference","isActive":true},{"type":"text","text":" creates its own "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"type":"text","text":". When you present a sheet or cover, a new child router is created. This hierarchy enables:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scoped navigation"}]},{"type":"text","text":": Each router manages its own stack"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Context propagation","type":"text"}]},{"text":": ","type":"text"},{"code":"RouteContext","type":"codeVoice"},{"text":" flows up through the hierarchy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Coordinated dismissal"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"closeChildren()"},{"type":"text","text":" dismisses all descendants"}],"type":"paragraph"}]}]},{"text":"Component Relationships","type":"heading","level":2,"anchor":"Component-Relationships"},{"syntax":null,"code":["┌─────────────────────────────────────────────────────────────┐","│                        RoutingTabView                        │","│                             │                               │","│                        TabRouter                            │","│               ┌─────────────┼─────────────┐                │","│               ▼             ▼             ▼                │","│         RoutingView    RoutingView    RoutingView           │","│              │                                              │","│           Router  ◀── @Environment(\\.router)               │","│           │    │                                            │","│      path │    │ sheet \/ cover                             │","│           ▼    ▼                                            │","│        Routes  Child Router (weak ref to parent)           │","│                │                                            │","│            contexts: [RouteContext observers]               │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"text":"RoutingView","type":"heading","level":3,"anchor":"RoutingView"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"type":"text","text":" is the entry point that creates a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" with an associated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":":"}]},{"syntax":"swift","code":["RoutingView(destination: AppRoute.self, root: .home)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Creates a ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"text":" instance","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Injects it into the environment via "},{"type":"codeVoice","code":"@Environment(\\.router)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Registers the ","type":"text"},{"code":"RouteDestination","type":"codeVoice"},{"text":" for navigation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages sheet and cover presentations"}]}]}]},{"text":"Router","type":"heading","level":3,"anchor":"Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"text":" manages:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Navigation path"}]},{"text":": The stack of pushed routes","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Root route"}],"type":"strong"},{"text":": The initial route displayed","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Presentations","type":"text"}],"type":"strong"},{"text":": Sheet and cover modals","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Context observers"}]},{"type":"text","text":": Registered "},{"type":"codeVoice","code":"RouteContext"},{"type":"text","text":" handlers"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Child routers","type":"text"}]},{"text":": Routers created by presented modals","type":"text"}]}]}]},{"text":"TabRouter","type":"heading","level":3,"anchor":"TabRouter"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","isActive":true,"type":"reference"},{"text":" coordinates navigation across tabs:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Manages the selected tab"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Provides access to each tab’s "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enables cross-tab navigation (","type":"text"},{"type":"codeVoice","code":"push(_:in:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"popToRoot(in:)"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Handles tab-aware deep links","type":"text"}],"type":"paragraph"}]}]},{"text":"Data Flow","type":"heading","level":2,"anchor":"Data-Flow"},{"text":"Navigation Flow","type":"heading","level":3,"anchor":"Navigation-Flow"},{"type":"paragraph","inlineContent":[{"text":"Each navigation type operates differently on the router hierarchy:","type":"text"}]},{"syntax":null,"code":["push(_:)","    │","    ├── Appends route to NavigationStack path","    ├── Same Router instance handles the new route","    └── back() or popToRoot() to unwind","","present(_:)  \/  cover(_:)","    │","    ├── Creates a new child Router","    ├── Presented as .sheet (present) or .fullScreenCover (cover)","    ├── Child Router manages its own NavigationStack","    └── close() or terminate(_:) to dismiss","","","User Action        Router Method         State Change         SwiftUI Result","─────────────      ─────────────         ────────────         ──────────────","Button tap    ──▶  push(.detail)    ──▶  path += [.detail]  ──▶  New view pushed","Link tapped   ──▶  present(.form)   ──▶  child Router set   ──▶  Sheet appears","Back gesture  ──▶  back()           ──▶  path.removeLast()  ──▶  View popped","Dismiss swipe ──▶  close()          ──▶  child Router = nil ──▶  Sheet dismissed","Deep link     ──▶  handle(_:)       ──▶  path replaced      ──▶  Stack rebuilt"],"type":"codeListing"},{"text":"Context Flow","type":"heading","level":3,"anchor":"Context-Flow"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouteContext"},{"type":"text","text":" flows upward through the router hierarchy:"}]},{"syntax":null,"code":["Child Router                    Parent Router","     │                               │","     │ router.terminate(context) ────▶│ .routerContext handler executes","     │                               │","     │◀──── Navigation completes ────│"],"type":"codeListing"},{"text":"RouterContext Lifecycle","type":"heading","level":4,"anchor":"RouterContext-Lifecycle"},{"syntax":null,"code":["                    ┌─────────────────────────────────────┐","                    │           Parent Router              │","                    │                                      │","  add(context:) ──▶ │  contexts: [SelectionContext: {...}] │","                    │                                      │","                    └──────────────────┬───────────────────┘","                                       │ context propagates up","                                       │","                    ┌──────────────────▼───────────────────┐","                    │           Child Router               │","                    │                                      │"," context(_:)    ──▶ │  Finds observer in parent hierarchy  │","  terminate(_:) ──▶ │  Executes observer + navigates back  │","                    │                                      │","                    └──────────────────────────────────────┘","","Observer removal:","  • Automatic  ──▶  route popped from stack (back \/ popToRoot)","  • Automatic  ──▶  Router deallocated (sheet dismissed)","  • Manual     ──▶  remove(context:) called explicitly"],"type":"codeListing"},{"text":"Deep Link Flow","type":"heading","level":3,"anchor":"Deep-Link-Flow"},{"syntax":null,"code":["URL\/Identifier → DeeplinkHandler → DeeplinkRoute → Router.handle(deeplink:)","                      │                  │                   │","                      │                  │                   └── Executes navigation sequence","                      │                  └── Factory creates navigation instructions","                      └── Async conversion with optional data fetching"],"type":"codeListing"},{"text":"Memory Management","type":"heading","level":2,"anchor":"Memory-Management"},{"text":"Router Lifecycle","type":"heading","level":3,"anchor":"Router-Lifecycle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Routers are retained by their parent "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":". When a view is dismissed:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The router is deallocated"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Context observers are automatically cleaned up","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Child routers are released"}],"type":"paragraph"}]}]},{"text":"Context Cleanup","type":"heading","level":3,"anchor":"Context-Cleanup"},{"type":"paragraph","inlineContent":[{"text":"Context observers registered on a route are automatically removed when that route is popped from the stack. This prevents memory leaks and stale callbacks.","type":"text"}]},{"syntax":"swift","code":["\/\/ Observer registered on .list route","router.push(.list)","router.add(context: SelectionContext.self) { ... }","","\/\/ When .list is popped, the observer is automatically removed","router.back()"],"type":"codeListing"},{"text":"Best Practices","type":"heading","level":2,"anchor":"Best-Practices"},{"text":"Keep Routes Focused","type":"heading","level":3,"anchor":"Keep-Routes-Focused"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One route enum per feature or navigation context:"}]},{"syntax":"swift","code":["\/\/ Good: Focused route enums","enum HomeRoute: Route { ... }","enum ProfileRoute: Route { ... }","enum SettingsRoute: Route { ... }","","\/\/ Avoid: One massive enum for everything","enum AppRoute: Route {","    case home, homeDetail, homeSettings, profile, profileEdit, ...","}"],"type":"codeListing"},{"text":"Use Nested Routes for Complex Hierarchies","type":"heading","level":3,"anchor":"Use-Nested-Routes-for-Complex-Hierarchies"},{"syntax":"swift","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","    case settings(SettingsRoute)","}"],"type":"codeListing"},{"text":"Inject RouterModel, Not Router","type":"heading","level":3,"anchor":"Inject-RouterModel-Not-Router"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In ViewModels, depend on the protocol for testability:"}]},{"syntax":"swift","code":["class MyViewModel {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","}"],"type":"codeListing"},{"text":"Prefer terminate() Over Manual Navigation","type":"heading","level":3,"anchor":"Prefer-terminate-Over-Manual-Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When completing a flow with context, use "},{"type":"codeVoice","code":"terminate()"},{"type":"text","text":" instead of manual "},{"type":"codeVoice","code":"back()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"close()"},{"type":"text","text":":"}]},{"syntax":"swift","code":["\/\/ Good: Let the framework handle navigation","router.terminate(SelectionContext(item: selectedItem))","","\/\/ Avoid: Manual navigation after context","router.context(SelectionContext(item: selectedItem))","router.back() \/\/ or router.close()"],"type":"codeListing"}]}],"kind":"article","metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Architecture","modules":[{"name":"Swift