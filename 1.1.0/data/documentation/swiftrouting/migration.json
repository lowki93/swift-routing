","            .onOpenURL { url in","                Task {","                    guard let identifier = AppDeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try? await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks","type":"reference","isActive":true},{"text":" for advanced patterns including path building, async data fetching, and tab-aware deep linking.","type":"text"}]},{"type":"heading","level":2,"text":"Dismissing Modals","anchor":"Dismissing-Modals"},{"type":"heading","level":3,"text":"Before","anchor":"Before"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.dismiss) private var dismiss","","Button(\"Close\") {","    dismiss()","}"]},{"type":"heading","level":3,"text":"After","anchor":"After"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.router) private var router","","Button(\"Close\") {","    router.close()","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"router.close()"},{"type":"text","text":" dismisses the current presented modal. It is a no-op if the router is not presented."}]},{"type":"heading","level":2,"text":"Upgrading to 1.0","anchor":"Upgrading-to-10"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"back()","type":"codeVoice"},{"text":" is renamed ","type":"text"},{"code":"pop()","type":"codeVoice"},{"text":". ","type":"text"},{"code":"back()","type":"codeVoice"},{"text":" still works but is deprecated.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Logger: "},{"type":"codeVoice","code":".action(.back)"},{"type":"text","text":" is now "},{"type":"codeVoice","code":".action(.pop)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"co