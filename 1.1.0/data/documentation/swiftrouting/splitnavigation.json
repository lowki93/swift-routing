{"abstract":[{"text":"Learn how to implement sidebar-based split navigation with SwiftRouting.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftrouting\/splitnavigation"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"metadata":{"modules":[{"name":"SwiftRouting"}],"roleHeading":"Article","title":"Split Navigation","role":"article"},"kind":"article","identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitNavigation","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"},{"type":"text","text":". All three columns (sidebar, content, detail) share the same split-type "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" — column selection is driven by typed, "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values, and only the detail column has a navigation stack, bound directly to that shared router’s "},{"code":"path","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A split-type ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"text":" is created automatically and injected into the environment via ","type":"text"},{"code":"@Environment(\\.router)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel","isActive":true,"type":"reference"},{"text":", giving you typed bindings and programmatic selection alongside the regular ","type":"text"},{"code":"push","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"present","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" API.","type":"text"}],"type":"paragraph"},{"text":"2-Column Layout (Sidebar + Detail)","type":"heading","level":2,"anchor":"2-Column-Layout-Sidebar-+-Detail"},{"inlineContent":[{"text":"The sidebar shows a fixed route; the detail column is derived from a typed selection:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","}"]},{"text":"3-Column Layout (Sidebar + Content + Detail)","type":"heading","level":2,"anchor":"3-Column-Layout-Sidebar-+-Content-+-Detail"},{"inlineContent":[{"type":"text","text":"Add a "},{"code":"content:","type":"codeVoice"},{"type":"text","text":" closure to introduce a middle column. The sidebar drives the content column, and the content column drives the detail column:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","} detail: { (player: Player) in","    AppRoute.player(player)","}"]},{"text":"Driving Selections","type":"heading","level":2,"anchor":"Driving-Selections"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/detailBinding(as:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/contentBinding(as:)","type":"reference"},{"text":" to wire a ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" selection directly, or call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)","type":"reference"},{"text":" \/ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(content:)","type":"reference"},{"text":" programmatically. Both paths behave identically – the binding calls ","type":"text"},{"code":"select(detail:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"select(content:)","type":"codeVoice"},{"text":" internally, so a selection made by tapping a ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" row logs a ","type":"text"},{"code":".navigation","type":"codeVoice"},{"text":" event just like a programmatic call would.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct SidebarScreen: View {","    @Environment(\\.router) var router","    let items: [PlayerType] = PlayerType.allCases","","    var body: some View {","        List(items, selection: router.detailBinding(as: PlayerType.self)) { item in","            NavigationLink(item.label, value: item)","        }","        .onFirstAppear {","            guard !router.isCompact else { return }","            router.select(detail: items.first)","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/hasContentColumn"},{"text":" to branch between driving the content or the detail column from the same sidebar code path:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["if router.hasContentColumn {","    router.select(content: playerType)","} else {","    router.select(detail: playerType)","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Compact Mode (iPhone)","anchor":"Compact-Mode-iPhone"},{"inlineContent":[{"text":"On iPhone, ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" collapses into a single-column stack. Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/isCompact","isActive":true,"type":"reference"},{"text":" to skip auto-selection and let the user tap to navigate instead:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".onFirstAppear {","    guard !router.isCompact else { return }","    router.select(detail: items.first)","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"isCompact"},{"type":"text","text":" reflects "},{"type":"codeVoice","code":"horizontalSizeClass"},{"type":"text","text":", so it also updates during iPad multitasking."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Navigating Within a Column","anchor":"Navigating-Within-a-Column"},{"inlineContent":[{"code":"router.push(_:)","type":"codeVoice"},{"text":" works like everywhere else in SwiftRouting, but since all columns share the same split ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"text":", it always pushes onto the one navigation stack — rendered only in the detail column. Pushing from the sidebar or content column doesn’t open a stack there; it appears in the detail column instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"router.present(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".cover(_:)"},{"text":" are also router-wide, not per-column: calling them from any column presents the same sheet\/cover over the whole ","type":"text"},{"type":"codeVoice","code":"RoutingSplitView"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Deep Linking","type":"heading","level":2,"anchor":"Deep-Linking"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplinkHandler"},{"text":" to convert an external input into a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplink"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/handle(splitDeeplink:)"},{"text":" to apply it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct PlayerSplitDeeplinkHandler: SplitDeeplinkHandler {","    func deeplink(from route: DeeplinkIdentifier) async throws -> SplitDeeplink<PlayerType, Player, AppRoute>? {","        switch route {","        case .player(let player):","            SplitDeeplink(content: player.type, detail: player)","        default:","            nil","        }","    }","}","","router.handle(splitDeeplink: splitDeeplink)"]},{"inlineContent":[{"type":"codeVoice","code":"handle(splitDeeplink:)"},{"type":"text","text":" selects "},{"type":"codeVoice","code":"content"},{"type":"text","text":" (3-column layout only), then "},{"type":"codeVoice","code":"detail"},{"type":"text","text":", then applies the optional "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" within the detail column’s own navigation stack — the content column has no stack of its own, so "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" can only push into "},{"type":"codeVoice","code":"detail"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"SplitModel Reference","type":"heading","level":3,"anchor":"SplitModel-Reference"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"detailSelection","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type-erased current selection for the detail column"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contentSelection"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type-erased current selection for the content column (3-column only)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isCompact"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the split view is currently collapsed to a single column"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"hasContentColumn","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this router was created with a "},{"type":"codeVoice","code":"content:"},{"type":"text","text":" closure"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"detailBinding(as:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed ","type":"text"},{"type":"codeVoice","code":"Binding<T?>"},{"text":" for the detail column selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"contentBinding(as:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed ","type":"text"},{"type":"codeVoice","code":"Binding<T?>"},{"text":" for the content column selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"select(detail:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Programmatically drive the detail column selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"select(content:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Programmatically drive the content column selection"}]}]]]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"],"generated":true,"anchor":"Split-Navigation","title":"Split Navigation"}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/Router