ngview","abstract":[{"type":"text","text":"Creates a navigation container with its own "},{"code":"Router","type":"codeVoice"},{"type":"text","text":"."}],"title":"RoutingView","type":"topic","navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoutingView","kind":"identifier"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","kind":"symbol","role":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftrouting\/routermodel","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","role":"symbol","abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"title":"RouterModel","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"navigatorTitle":[{"text":"RouterModel","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting/ConfigurationGuide":{"kind":"article","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","abstract":[{"text":"Learn how to configure SwiftRouting and customize logging behavior.","type":"text"}],"type":"topic","url":"\/documentation\/swiftrouting\/configurationguide","title":"Configuration and Logging","role":"collectionGroup"},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"type":"topic","title":"FAQ","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","url":"\/documentation\/swiftrouting\/faq","abstract":[{"type":"text","text":"Answers to common questions about SwiftRouting usage and design decisions."}],"kind":"article","role":"collectionGroup"},"doc://SwiftRouting/documentation/SwiftRouting/Configuration":{"abstract":[{"type":"text","text":"A configuration structure used to initialize t