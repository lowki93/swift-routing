{"abstract":[{"type":"text","text":"Learn how to implement tab-based navigation with SwiftRouting."}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabNavigation","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftRouting"}],"role":"article","roleHeading":"Article","title":"Tab Navigation"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/AnyTabRoute"],"anchor":"Tab-Navigation","generated":true,"title":"Tab Navigation"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros"]]},"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/tabnavigation"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for tab-based navigation through "},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","type":"reference"},{"type":"text","text":", and "},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Defining-Tabs","text":"Defining Tabs"},{"inlineContent":[{"type":"text","text":"Create an enum conforming to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["enum HomeTab: TabRoute {","    case home","    case search","    case profile","    ","    var name: String {","        switch self {","        case .home: \"Home\"","        case .search: \"Search\"","        case .profile: \"Profile\"","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Generating-Tabs-with-TabRoutable","text":"Generating Tabs with @TabRoutable"},{"inlineContent":[{"type":"text","text":"With the opt-in "},{"code":"@TabRoutable","type":"codeVoice"},{"type":"text","text":" macro you don’t write the "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" by hand. This enum generates the same "},{"code":"name","type":"codeVoice"},{"type":"text","text":" as "},{"code":"HomeTab","type":"codeVoice"},{"type":"text","text":" above and adds the "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","isActive":true},{"type":"text","text":" conformance:"}],"type":"paragraph"},{"code":["@TabRoutable(nameStyle: .capitalized)","enum HomeTab {","    case home","    case search","    case profile","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros#Tab-Routes","type":"reference","isActive":true},{"type":"text","text":" for the rules, compile-time errors and limits."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Option-1-Using-RoutingTabView","text":"Option 1: Using RoutingTabView"},{"inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingTabView","isActive":true,"type":"reference"},{"text":" provides a ","type":"text"},{"code":"TabRouter","type":"codeVoice"},{"text":" for programmatic tab control:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        RoutingTabView(tab: $selectedTab, destination: HomeRoute.self) { destination in","            RoutingView(tab: HomeTab.home, destination: destination, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: destination, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: destination, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Option-2-Using-Native-TabView","text":"Option 2: Using Native TabView"},{"inlineContent":[{"text":"For simpler cases, use SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":".tabToRoot"},{"text":" binding:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(\\.router) private var router","    @State private var selectedTab: HomeTab = .home","    ","    var body: some View {","        TabView(selection: .tabToRoot(for: $selectedTab, in: router)) {","            RoutingView(tab: HomeTab.home, destination: HomeRoute.self, root: .home)","                .tabItem { Label(\"Home\", systemImage: \"house\") }","            ","            RoutingView(tab: HomeTab.search, destination: HomeRoute.self, root: .search)","                .tabItem { Label(\"Search\", systemImage: \"magnifyingglass\") }","            ","            RoutingView(tab: HomeTab.profile, destination: HomeRoute.self, root: .profile)","                .tabItem { Label(\"Profile\", systemImage: \"person\") }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":".tabToRoot"},{"type":"text","text":" binding automatically pops to root when the user taps the already-selected tab."}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"This native "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" approach does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" provide a "},{"type":"codeVoice","code":"TabRouter"},{"type":"text","text":" in the environment."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":" when you need "},{"type":"codeVoice","code":"@Environment(\\.tabRouter)"},{"type":"text","text":" and cross-tab programmatic actions."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"level":2,"type":"heading","anchor":"Using-TabRouter","text":"Using TabRouter"},{"inlineContent":[{"type":"text","text":"Access the "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","type":"reference","isActive":true},{"type":"text","text":" from the environment to navigate across tabs:"}],"type":"paragraph"},{"code":["struct SomeView: View {","    @Environment(\\.tabRouter) private var tabRouter","    ","    var body: some View {","        Button(\"Go to Profile\") {","            \/\/ Switch to profile tab and push a route","            tabRouter?.push(HomeRoute.settings, in: HomeTab.profile)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"App-Level-Convenience-Overloads-Optional","text":"App-Level Convenience Overloads (Optional)"},{"inlineContent":[{"text":"If your app uses one main route enum with nested feature routes, you can add","type":"text"},{"text":" ","type":"text"},{"code":"TabRouterModel","type":"codeVoice"},{"text":" overloads to improve call-site ergonomics (for example using","type":"text"},{"text":" ","type":"text"},{"code":".profile(...)","type":"codeVoice"},{"text":" directly at call sites).","type":"text"}],"type":"paragraph"},{"code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute, in: nil)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute, in: nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Before:"}],"type":"paragraph"},{"code":["tabRouter.push(HomeRoute.profile, in: nil)","tabRouter.present(HomeRoute.settings, in: nil)","tabRouter.update(root: HomeRoute.home, in: nil)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"After:"}],"type":"paragraph"},{"code":["tabRouter.push(.profile)","tabRouter.present(.settings)","tabRouter.update(root: .home)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can apply the same pattern for your main tab enum as well:"}],"type":"paragraph"},{"code":["public extension TabRouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute, in tab: HomeTab?) {","        push(homeRoute, in: tab as (any TabRoute)?)","    }","","    @_disfavoredOverload","    func popToRoot(in tab: HomeTab?) {","        popToRoot(in: tab as (any TabRoute)?)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Before:","type":"text"}],"type":"paragraph"},{"code":["tabRouter.push(HomeRoute.profile, in: HomeTab.profile)","tabRouter.popToRoot(in: HomeTab.profile)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"After:"}],"type":"paragraph"},{"code":["tabRouter.push(.profile, in: .profile)","tabRouter.popToRoot(in: .profile)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"TabRouter-Methods","text":"TabRouter Methods"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"change(tab:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Switch to a different tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"push(_:in:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Push a route in a specific tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"present(_:in:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Present a sheet in a specific tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cover(_:in:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Present a cover in a specific tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"update(root:in:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Update the root of a specific tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"popToRoot(in:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pop to root in a specific tab","type":"text"}],"type":"paragraph"}]]]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"For "},{"type":"codeVoice","code":"update(root:in:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"push(_:in:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"present(_:in:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"cover(_:in:)"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"if you pass a non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tab, "},{"type":"codeVoice","code":"TabRouter"},{"type":"text","text":" switches to that tab first (equivalent to calling "},{"type":"codeVoice","code":"change(tab:)"},{"type":"text","text":"), then performs the navigation action."}]}],"type":"aside","name":"Note"},{"level":3,"type":"heading","anchor":"Navigating-in-Current-Tab","text":"Navigating in Current Tab"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for the tab parameter to use the currently selected tab:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Push in the current tab","tabRouter?.push(HomeRoute.detail(id: 42), in: nil)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Reacting-to-Tab-Reselection","text":"Reacting to Tab Reselection"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"onTabReselected(_:perform:)","type":"codeVoice"},{"type":"text","text":" modifier from any view inside a "},{"code":"RoutingTabView","type":"codeVoice"},{"type":"text","text":" to react to same-tab taps. The default "},{"code":"popToRoot","type":"codeVoice"},{"type":"text","text":" behavior always fires first; the handler is called after."}],"type":"paragraph"},{"code":["struct HomeView: View {","    @ScrollViewProxy var scrollProxy","","    var body: some View {","        ScrollView {","            \/\/ ...","        }","        .onTabReselected(HomeTab.home) {","            scrollProxy.scrollTo(\"top\", anchor: .top)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"codeVoice","code":"onTabReselected(_:perform:)"},{"type":"text","text":" works with both "},{"type":"codeVoice","code":"RoutingTabView"},{"type":"text","text":" and native "},{"type":"codeVoice","code":"TabView + .tabToRoot"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The handler fires only when the reselected tab matches the tab you pass."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"level":2,"type":"heading","anchor":"Hiding-the-Tab-Bar","text":"Hiding the Tab Bar"},{"inlineContent":[{"text":"To hide the tab bar when pushing views, override ","type":"text"},{"code":"hideTabBarOnPush","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["enum HomeTab: TabRoute {","    case home","    case immersive","    ","    var name: String { \/* ... *\/ }","    ","    var hideTabBarOnPush: Bool {","        switch self {","        case .immersive: true","        default: false","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"tip","content":[{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":", mark the tabs that hide the tab bar with "},{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hideTabBarOnPush"},{"type":"text","text":" is generated for you. See "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros#Tab-Routes","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"level":2,"type":"heading","anchor":"Deep-Linking-with-Tabs","text":"Deep Linking with Tabs"},{"inlineContent":[{"text":"Tab deeplink handling is covered in ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks","type":"reference","isActive":true},{"text":", including:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink"}]}]},{"content":[{"inlineContent":[{"type":"tex