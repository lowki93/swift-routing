r ","type":"text"},{"type":"codeVoice","code":"router.close()"},{"text":" and for native dismissals (swipe-down, tap outside, ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.dismiss)"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".action(.closeChildren)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Child routers were closed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".action(.changeTab)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab selection changed"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Context-Events","level":4,"type":"heading","text":"Context Events"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Message","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".context(.add)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Context observer was registered","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".context(.execute)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context was sent and executed"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".context(.remove)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context observer was removed"}]}]]],"type":"table","header":"row"},{"anchor":"Routing-Errors","level":4,"type":"heading","text":"Routing Errors"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Message"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".error(RouterError)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A route could not be resolved to its destination"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"When a route cannot be matched, SwiftRouting emits ","type":"text"},{"type":"codeVoice","code":".error(RouterError.routeNotFound)"},{"text":" before either crashing or displaying the fallback message. Use this in your logger to monitor unresolved routes in production:","type":"text"}]},{"code":["Configuration(logger: { config in","    if case .error(let error) = config.message {","        \/\/ Report to your error tracking service","        Analytics.record(error.description)","    }","})"],"syntax":"swift","type":"codeListing"},{"anchor":"Custom-Logger-Examples","level":2,"type":"heading","text":"Custom Logger Examples"},{"anchor":"Analytics-Integration","level":3,"type":"heading","text":"Analytics Integration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Send navigation events to your analytics service:"}]},{"code":["let config = Configuration(","    logger: { loggerConfig in","        switch loggerConfig.message {","        case .navigation(let from, let to, let type):","            Analytics.track(\"navigation\", properties: [","                \"from\": from.name,","                \"to\": to.name,","                \"type\": \"\\(type)\"","            ])","        default:","            break","        }","    },","    shouldCrashOnRouteNotFound: false",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Debug-Logging","level":3,"type":"heading","text":"Debug Logging"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detailed logging for development:"}]},{"code":["let config = Configuration(","    logger: { loggerConfig in","        let routerId = loggerConfig.router.id.uuidString.prefix(8)","        ","        switch loggerConfig.message {","        case .create(let from, _):","            if let parent = from {","                print(\"🆕 [\\(routerId)] Created from \\(parent)\")","            } else {","                print(\"🆕 [\\(routerId)] Root router created\")","            }","            ","        case .delete:","            print(\"🗑️ [\\(routerId)] Deallocated\")","            ","        case .navigation(let from, let to, let type):","            print(\"🧭 [\\(routerId)] \\(from.name) → \\(to.name) (\\(type))\")","            ","        case .action(let action):","            print(\"⚡ [\\(routerId)] Action: \\(action)\")","            ","        case .context(let context):","            print(\"📦 [\\(routerId)] Context: \\(context)\")","            ","        case .onAppear(let route):","            print(\"👁️ [\\(routerId)] Appear: \\(route.name)\")","            ","        case .onDisappear(let route):","            print(\"👁️‍🗨️ [\\(routerId)] Disappear: \\(route.name)\")","        }","    },","    shouldCrashOnRouteNotFound: true",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Filtered-Logging","level":3,"type":"heading","text":"Filtered Logging"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Log only specific events:"}]},{"code":["let config = Configuration(","    logger: { loggerConfig in","        switch loggerConfig.message {","        case .navigation, .action:","            LoggerConfiguration.default(loggerConfiguration: loggerConfig)","        default:","            break","        }","    },","    shouldCrashOnRouteNotFound: false",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Disable-Logging","level":3,"type":"heading","text":"Disable Logging"},{"type":"paragraph","inlineContent":[{"text":"To disable logging entirely, pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let config = Configuration(","    logger: nil,","    shouldCrashOnRouteNotFound: false",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Environment-Based Configuration","anchor":"Environment-Based-Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"Use different configurations for debug and release builds:"}],"type":"paragraph"},{"code":["extension Configuration {","    static 