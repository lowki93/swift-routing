{"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"abstract":[{"type":"text","text":"Generate "},{"code":"name","type":"codeVoice"},{"type":"text","text":", "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hideTabBarOnPush","type":"codeVoice"},{"type":"text","text":" for routes and tabs from their cases with the opt-in macros."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route","isActive":true},{"type":"text","text":" needs a "},{"code":"name","type":"codeVoice"},{"type":"text","text":", used for logging, debugging and analytics. For most enums this is a mechanical "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over the cases. The "},{"code":"@Routable","type":"codeVoice"},{"type":"text","text":" macro writes that "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" for you, and "},{"code":"@RouteName","type":"codeVoice"},{"type":"text","text":" overrides the cases that need a custom format. "},{"code":"@Sheet","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Cover","type":"codeVoice"},{"type":"text","text":" mark the cases that are presented modally so "},{"code":"@Routable","type":"codeVoice"},{"type":"text","text":" can generate "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tabs get the same treatment: "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" generates a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"name"},{"type":"text","text":", and "},{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" marks the tabs that hide the tab bar when pushing, so it can generate "},{"type":"codeVoice","code":"hideTabBarOnPush"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The macros ship in a separate, opt-in product so that apps which don’t use them never compile swift-syntax.","type":"text"}],"type":"paragraph"},{"anchor":"Installation","type":"heading","level":2,"text":"Installation"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiftRoutingMacros","type":"codeVoice"},{"text":" product next to ","type":"text"},{"code":"SwiftRouting","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"SwiftRouting\", package: \"swift-routing\"),","        .product(name: \"SwiftRoutingMacros\", package: \"swift-routing\"),","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then import it where your routes are declared:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftRoutingMacros"],"type":"codeListing"},{"inlineContent":[{"code":"SwiftRoutingMacros","type":"codeVoice"},{"text":" re-exports ","type":"text"},{"code":"SwiftRouting","type":"codeVoice"},{"text":", so this single import gives you both the macros and the rest of the library. Writing ","type":"text"},{"code":"import SwiftRouting","type":"codeVoice"},{"text":" as well still compiles.","type":"text"}],"type":"paragraph"},{"anchor":"Default-Names","type":"heading","level":2,"text":"Default Names"},{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" to the enum. Each case without an override is named after itself. ","type":"text"},{"code":"nameStyle","type":"codeVoice"},{"text":" sets the format:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Routable(nameStyle: .capitalized)","enum AppRoute {","    case profile","    case search","}","\/\/ AppRoute.profile.name == \"Profile\"","\/\/ AppRoute.search.name == \"Search\""],"type":"codeListing"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nameStyle"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".profile"},{"type":"text","text":" becomes"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verbatim","type":"codeVoice"},{"text":" (default)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"profile\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".capitalized"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"Profile\""}]}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"nameStyle","type":"codeVoice"},{"text":" must be written as a literal (","type":"text"},{"code":".verbatim","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".capitalized","type":"codeVoice"},{"text":"), since the macro reads it from source.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Choosing a Style","type":"heading","anchor":"Choosing-a-Style"},{"inlineContent":[{"text":"Pick the style that matches the names your routes already report, so logs and analytics stay unchanged when you adopt the macro. ","type":"text"},{"code":"nameStyle","type":"codeVoice"},{"text":" also sets the prefix that ","type":"text"},{"code":"@RouteName(.delegate)","type":"codeVoice"},{"text":" writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, take a hand-written route whose names are capitalized:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Before: hand-written.","enum LegacyAppRoute: Route {","    case profile","    case search","    case notifications(NotificationsRoute)","","    var name: String {","        switch self {","        case .profile: \"Profile\"","        case .search: \"Search\"","        case .notifications(let child): \"Notifications.\\(child.name)\"","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Routable(nameStyle: .capitalized)","type":"codeVoice"},{"text":" reports the same names, with only one override:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ After: same names.","@Routable(nameStyle: .capitalized)","enum AppRoute {","    case profile","    case search","    @RouteName(.delegate)","    case notifications(NotificationsRoute)","}"],"type":"codeListing"},{"inlineContent":[{"text":"With the default ","type":"text"},{"code":".verbatim","type":"codeVoice"},{"text":", each case would need its own ","type":"text"},{"code":"@RouteName","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".delegate","type":"codeVoice"},{"text":" would write ","type":"text"},{"code":"notifications.","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"notifications","type":"codeVoice"},{"text":" would need ","type":"text"},{"type":"codeVoice","code":"@RouteName(#\"Notifications.\\(arg0.name)\"#)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@Routable"},{"text":" also adds the ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance, so ","type":"text"},{"type":"codeVoice","code":": Route"},{"text":" is optional. Writing it explicitly still compiles.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Overriding-a-Case","text":"Overriding a Case","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"@RouteName","type":"codeVoice"},{"text":" with a raw string literal. Each associated value is available in the template under one name:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A labeled value is available by its label. It has no "},{"type":"codeVoice","code":"argN"},{"type":"text","text":" name."}]}]},{"content":[{"inlineContent":[{"text":"An unlabeled value is available as ","type":"text"},{"code":"arg","type":"codeVoice"},{"text":" followed by its zero-based position among all the associated values, labeled or not.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"_"},{"type":"text","text":" label counts as unlabeled: "},{"type":"codeVoice","code":"case detail(_ id: Int)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"arg0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"id"},{"type":"text","text":" isn’t usable."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".delegate"},{"type":"text","text":" uses the case’s single associated value, whatever its name."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["@Routable","enum PlayersRoute {","    @RouteName(#\"Players(\\(arg0))\"#)","    case list(PlayerType)","","    @RouteName(#\"Player(\\(arg0.name))\"#)","    case detail(Player)","}","","@Routable","enum NotificationsRoute {","    @RouteName(#\"Notifications\"#)","    case list","","    @RouteName(#\"Notification(\\(id))\"#)","    case detail(id: Int)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"In a case mixing both, the labeled value keeps its label and the unlabeled one uses its position, which counts the labeled value too:"}],"type":"paragraph"},{"code":["@Routable","enum OrderRoute {","    \/\/ arg0 doesn't exist here: the first value is labeled, so it's id.","    @RouteName(#\"Order(\\(id), \\(arg1))\"#)","    case detail(id: String, OrderTab)","}","\/\/ OrderRoute.detail(id: \"42\", .shipping).name == \"Order(42, shipping)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Using a name that isn’t available is a compile-time error that lists the available names (for example "},{"type":"codeVoice","code":"Available: id, arg1"},{"type":"text","text":")."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"The template must be a raw string literal (","type":"text"},{"code":"#\"...\"#","type":"codeVoice"},{"text":"). A regular string with ","type":"text"},{"code":"\\(id)","type":"codeVoice"},{"text":" doesn’t compile, because ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" isn’t in scope where the attribute is written. In a raw string, ","type":"text"},{"code":"\\(...)","type":"codeVoice"},{"text":" is plain text that the macro copies into the generated ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":", where the value is in scope.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":2,"anchor":"Composing-Child-Routes","text":"Composing Child Routes","type":"heading"},{"inlineContent":[{"type":"text","text":"When a case wraps another "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route"},{"type":"text","text":", "},{"code":"@RouteName(.delegate)","type":"codeVoice"},{"type":"text","text":" appends the child’s name to the case name:"}],"type":"paragraph"},{"code":["@Routable(nameStyle: .capitalized)","enum AppRoute {","    @RouteName(.delegate)","    case notifications(NotificationsRoute)","}","\/\/ AppRoute.notifications(.detail(id: 1)).name == \"Notifications.Notification(1)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The prefix follows the enum’s ","type":"text"},{"code":"nameStyle","type":"codeVoice"},{"text":". ","type":"text"},{"code":".delegate","type":"codeVoice"},{"text":" requires exactly one associated value.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Presentation-Style","text":"Presentation Style","type":"heading"},{"inlineContent":[{"text":"Mark a case with ","type":"text"},{"type":"codeVoice","code":"@Sheet"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"@Cover"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Routable"},{"text":" also generates ","type":"text"},{"type":"codeVoice","code":"routingType"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@Routable","enum AppRoute {","    case home","    @Sheet(withStack: true)","    case settings","    @Cover","    case onboarding","    case order(id: String)","}","\/\/ AppRoute.home.routingType == .push","\/\/ AppRoute.settings.routingType == .sheet(withStack: true)","\/\/ AppRoute.onboarding.routingType == .cover","\/\/ AppRoute.order(id: \"1\").routingType == .push"],"syntax":"swift","type":"codeListing"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated "},{"type":"codeVoice","code":"routingType"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Sheet"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"@Sheet()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sheet(withStack: true)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Sheet(withStack: false)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".sheet(withStack: false)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Cover","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".cover"}]}]]],"type":"table"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"routingType"},{"type":"text","text":" is generated only when at least one case has a marker. Without any marker nothing is generated, so the default "},{"type":"codeVoice","code":".push"},{"type":"text","text":" of "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Route","type":"reference","isActive":true},{"type":"text","text":" applies and a hand-written "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":" keeps compiling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Markers compose with "},{"code":"@RouteName(.delegate)","type":"codeVoice"},{"type":"text","text":". "},{"code":".delegate","type":"codeVoice"},{"type":"text","text":" only affects "},{"code":"name","type":"codeVoice"},{"type":"text","text":"; the parent’s marker decides the "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" (the child’s "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" is never consulted). "},{"code":"@Sheet @RouteName(.delegate) case form(FormRoute)","type":"codeVoice"},{"type":"text","text":" presents the child flow in a sheet and derives its name from the child."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A marker on a case declaring several elements (","type":"text"},{"type":"codeVoice","code":"@Cover case a, b"},{"text":") applies to every element.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"withStack"},{"text":" must be a literal ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Tab-Routes","text":"Tab Routes","type":"heading"},{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"@TabRoutable","type":"codeVoice"},{"text":" to a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"text":" enum instead of ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" is generated exactly as above: same ","type":"text"},{"code":"nameStyle","type":"codeVoice"},{"text":", same ","type":"text"},{"code":"@RouteName","type":"codeVoice"},{"text":" overrides and ","type":"text"},{"code":".delegate","type":"codeVoice"},{"text":" composition, same compile-time checks. ","type":"text"},{"code":"@TabRoutable","type":"codeVoice"},{"text":" also adds the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"text":" conformance, so ","type":"text"},{"code":": TabRoute","type":"codeVoice"},{"text":" is optional.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mark a case with ","type":"text"},{"code":"@HideTabBarOnPush","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@TabRoutable","type":"codeVoice"},{"text":" also generates ","type":"text"},{"code":"hideTabBarOnPush","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@TabRoutable","enum HomeTab {","    @HideTabBarOnPush","    case home","    case notifications","    case profile","}","\/\/ HomeTab.home.hideTabBarOnPush == true","\/\/ HomeTab.notifications.hideTabBarOnPush == false","\/\/ HomeTab.profile.hideTabBarOnPush == false"],"syntax":"swift","type":"codeListing"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marked cases"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated "},{"code":"hideTabBarOnPush","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"nothing, the ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute","isActive":true,"type":"reference"},{"text":" default (","type":"text"},{"code":"false","type":"codeVoice"},{"text":") applies","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"some","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for marked cases and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for the others","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"all"}]}],[{"type":"paragraph","inlineContent":[{"text":"a constant ","type":"text"},{"code":"true","type":"codeVoice"}]}]]],"type":"table"},{"items":[{"content":[{"inlineContent":[{"text":"A marker on a case declaring several elements (","type":"text"},{"code":"@HideTabBarOnPush case a, b","type":"codeVoice"},{"text":") applies to every element.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" never generates "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":": tabs are selected, never presented. "},{"type":"codeVoice","code":"@Sheet"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Cover"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" enum are errors."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" is an error anywhere other than a case of a "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" enum, including a hand-written "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" enum. Without that check the tab bar would silently stay visible."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Compile-Time-Checks","text":"Compile-Time Checks","type":"heading"},{"inlineContent":[{"text":"The macros report mistakes on the attribute itself.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Routes","text":"Routes","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" attached to something other than an enum."}]}]},{"content":[{"inlineContent":[{"code":"nameStyle","type":"codeVoice"},{"text":" that isn’t a literal ","type":"text"},{"code":".verbatim","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".capitalized","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@RouteName"},{"type":"text","text":" on a case declaring several elements ("},{"type":"codeVoice","code":"case a, b"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@RouteName"},{"type":"text","text":" argument that is neither a raw string nor "},{"type":"codeVoice","code":".delegate"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A template referencing a name that isn’t one of the case’s associated values (for example "},{"type":"codeVoice","code":"\\(idd)"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"\\(id)"},{"type":"text","text":"). The error lists the case’s available names."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delegate"},{"type":"text","text":" on a case without exactly one associated value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Sheet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@Cover"},{"type":"text","text":" on something other than an enum case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Several routing type markers on the same case (","type":"text"},{"code":"@Sheet @Cover","type":"codeVoice"},{"text":", or the same marker twice). A case can carry only one.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"withStack"},{"type":"text","text":" that isn’t a literal "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A marker combined with a hand-written ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":" in the enum body.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only the first identifier of each ","type":"text"},{"code":"\\(...)","type":"codeVoice"},{"text":" is checked. Errors further in the expression, such as a missing property in ","type":"text"},{"code":"\\(arg0.title)","type":"codeVoice"},{"text":", are reported by the compiler on the generated code.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Tabs","text":"Tabs","type":"heading"},{"inlineContent":[{"text":"The checks above also apply to ","type":"text"},{"code":"@TabRoutable","type":"codeVoice"},{"text":". These are specific to tabs:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@TabRoutable","type":"codeVoice"},{"text":" attached to something other than an enum.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":" on something other than an enum case, or on a case outside a "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" enum (including a hand-written "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRoute"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" enum)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@HideTabBarOnPush","type":"codeVoice"},{"text":" applied twice to the same case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"@HideTabBarOnPush","type":"codeVoice"},{"text":" combined with a hand-written ","type":"text"},{"code":"hideTabBarOnPush","type":"codeVoice"},{"text":" in the enum body.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Sheet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"@Cover"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"@TabRoutable"},{"type":"text","text":" enum."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Limits","text":"Limits","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The macros only generate "},{"code":"name","type":"codeVoice"},{"type":"text","text":", "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hideTabBarOnPush","type":"codeVoice"},{"type":"text","text":". Mapping routes to views ("},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination","isActive":true},{"type":"text","text":") and deep link handling ("},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Deeplinks","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","isActive":true},{"type":"text","text":") stay hand-written, which keeps routes plain data (see "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Architecture","isActive":true},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"There is no marker for "},{"type":"codeVoice","code":".root"},{"type":"text","text":". An enum that needs it keeps a hand-written "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":" (and then uses no markers), as described in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DefiningRoutes"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Module-qualified ","type":"text"},{"code":"@SwiftRoutingMacros.RouteName","type":"codeVoice"},{"text":" isn’t recognised, so the case keeps its default name. The markers (","type":"text"},{"code":"@Sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Cover","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@HideTabBarOnPush","type":"codeVoice"},{"text":") are recognised in both spellings.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"routingType"},{"type":"text","text":" declared in a separate extension isn’t detected when combined with markers; the compiler reports a redeclaration instead. The same goes for "},{"type":"codeVoice","code":"hideTabBarOnPush"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@HideTabBarOnPush"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated properties ("},{"code":"name","type":"codeVoice"},{"type":"text","text":", "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":", "},{"code":"hideTabBarOnPush","type":"codeVoice"},{"type":"text","text":") use the enum’s access level ("},{"code":"public","type":"codeVoice"},{"type":"text","text":", "},{"code":"package","type":"codeVoice"},{"type":"text","text":" or internal)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A label named like a positional name collides with another value’s position-based name: in "},{"type":"codeVoice","code":"case a(arg1: Int, String)"},{"type":"text","text":" both values bind "},{"type":"codeVoice","code":"arg1"},{"type":"text","text":". The compiler reports the error on the generated code, not on the attribute, when a template references it. Avoid "},{"type":"codeVoice","code":"argN"},{"type":"text","text":" labels."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Raw strings using ","type":"text"},{"type":"codeVoice","code":"\\#(...)"},{"text":" interpolation aren’t supported.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/sw