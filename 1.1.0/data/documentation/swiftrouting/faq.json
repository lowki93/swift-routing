{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This article addresses frequently asked questions about routing patterns, API choices, and known limitations."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"When-should-I-use-sheet-vs-cover","text":"When should I use sheet vs cover?","level":2,"type":"heading"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"present(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cover(_:)","type":"codeVoice"},{"text":" create a child router and present a modal, but they differ in appearance and dismissal behavior:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"code":"present(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"cover(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"SwiftUI modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sheet"}]}],[{"type":"paragraph","inlineContent":[{"code":".fullScreenCover","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Partial screen, card style"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full screen","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dismiss gesture"}]}],[{"type":"paragraph","inlineContent":[{"text":"Swipe down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not dismissable by gesture","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use case"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quick actions, pickers, forms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Onboarding, auth, immersive flows","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"present(_:)"},{"text":" when:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The user needs to stay aware of the context behind (e.g. selecting an item from a list)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The flow is short and dismissable (form, picker, confirmation)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"cover(_:)"},{"type":"text","text":" when:"}]}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The flow takes over the full experience (onboarding, login, camera)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You want to prevent accidental swipe-to-dismiss","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both support navigation stacks inside them via the ","type":"text"},{"code":"withStack","type":"codeVoice"},{"text":" parameter on ","type":"text"},{"code":"present(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Sheet with its own NavigationStack (default)","router.present(AppRoute.form)","","\/\/ Sheet without a NavigationStack (single view only)","router.present(AppRoute.form, withStack: false)","","\/\/ Full-screen cover (always has its own stack)","router.cover(AppRoute.onboarding)"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"How-do-I-share-a-router-between-views","text":"How do I share a router between views?","level":2,"type":"heading"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","type":"reference"},{"text":" for accessing the router via ","type":"text"}