,"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Propagates up through the entire router hierarchy automatically"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Works the same whether the child is one or five levels deep"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enables "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" to handle both data passing and navigation in one call"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use callbacks for simple, same-level communication. Use "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","isActive":true,"type":"reference"},{"type":"text","text":" when data needs to travel up multiple levels or when the navigation flow should complete on context delivery."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Known-Limitations-and-Unsupported-Cases","text":"Known Limitations and Unsupported Cases","level":2,"type":"heading"},{"anchor":"Multiple-simultaneous-modals","text":"Multiple simultaneous modals","level":3,"type":"heading"},{"inlineContent":[{"text":"SwiftRouting supports one sheet or cover at a time per router. Presenting a second modal while one is already active is not supported and will replace the current presentation.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ ❌ Unsupported — only one modal per router at a time","router.present(AppRoute.sheet1)","router.present(AppRoute.sheet2) \/\/ replaces sheet1"],"type":"codeListing"},{"anchor":"Mixing-route-types-across-RoutingView-boundaries","text":"Mixing route types across RoutingView boundaries","level":3,"type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"text":" is bound to a single ","type":"text"},{"isActive":true,"type":"refe