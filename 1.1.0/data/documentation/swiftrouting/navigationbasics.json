"paragraph"},{"syntax":"swift","type":"codeListing","code":[".presentationDetents([.medium])",".presentationDragIndicator(.visible)"]},{"inlineContent":[{"text":"With ","type":"text"},{"code":"withStack: true","type":"codeVoice"},{"text":" (default), the route is wrapped in a ","type":"text"},{"code":"RoutingView","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":", which can make these modifiers less predictable on the final destination view.","type":"text"}],"type":"paragraph"},{"anchor":"Full-Screen-Cover","type":"heading","level":3,"text":"Full-Screen Cover"},{"inlineContent":[{"type":"text","text":"Present a route as a full-screen cover:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.cover(HomeRoute.onboarding)"]},{"anchor":"Navigating-Back","type":"heading","level":2,"text":"Navigating Back"},{"anchor":"Back-One-Step","type":"heading","level":3,"text":"Back One Step"},{"type":"paragraph","inlineContent":[{"text":"Remove the top route from the stack:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["router.pop()"]},{"anchor":"Pop-to-Root","type":"heading","level":3,"text":"Pop to Root"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return to the root of the navigation stack:"}]},{"syntax":"swift","type":"codeListing","code":["router.popToRoot()"]},{"anchor":"Close-Modal","type":"heading","level":3,"text":"Close Modal"},{"type":"paragraph","inlineContent":[{"text":"Dismiss a presented sheet or cover:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["router.close()"]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" only works on routers that are presented (sheets or covers).","type":"text"}],"type":"paragraph"}]},{"anchor":"Updating-the-Root","type":"heading","level":2,"text":"Updating the Root"},{"type":"paragraph","inlineContent":[{"tex