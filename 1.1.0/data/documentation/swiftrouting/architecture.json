{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Architecture","interfaceLanguage":"swift"},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Architecture","modules":[{"name":"SwiftRouting"}]},"abstract":[{"type":"text","text":"Understand the design principles and structure behind SwiftRouting."}],"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"],"anchor":"Related","title":"Related"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"SwiftRouting is built around a few core principles: ","type":"text"},{"inlineContent":[{"text":"separation of concerns","type":"text"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"type safety"}],"type":"strong"},{"text":", and ","type":"text"},{"inlineContent":[{"text":"testability","type":"text"}],"type":"strong"},{"text":". This guide explains how these principles shape the framework’s architecture.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Design Principles","anchor":"Design-Principles","type":"heading"},{"level":3,"text":"Routes Are Data, Not Views","anchor":"Routes-Are-Data-Not-Views","type":"heading"},{"inlineContent":[{"text":"In SwiftRouting, routes are simple Swift enums that describe ","type":"text"},{"inlineContent":[{"text":"what","type":"text"}],"type":"emphasis"},{"text":" destination to navigate to, not ","type":"text"},{"inlineContent":[{"type":"text","text":"how"}],"type":"emphasis"},{"text":" to display it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum AppRoute: Route {","    case home","    case profile(userId: String)","    case settings","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The view mapping is handled separately through "},{"code":"RouteDestination","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["extension AppRoute: RouteDestination {","    static func view(for route: AppRoute) -> some View {","        switch route {","        case .home: HomeView()","        case .profile(let userId): ProfileView(userId: userId)","        case .settings: SettingsView()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Why this separation?"}]}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Benefit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Explanation","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reusability"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Routes can be used in navigation, deep links, analytics, and tests without view dependencies"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Testability","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test navigation logic by asserting on route values, not view hierarchies"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flexibility"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Change view implementations without touching route definitions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modularity"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Routes can live in a shared module; views in feature modules","type":"text"}]}]]],"header":"row","type":"table"},{"level":3,"text":"Protocol-Based Router","anchor":"Protocol-Based-Router","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"text":" class implements the ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","type":"reference","isActive":true},{"text":" protocol, which defines all navigation operations:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public protocol RouterModel {","    func push(_ route: some Route)","    func present(_ route: some Route, withStack: Bool)","    func cover(_ route: some Route)","    func pop()","    func popToRoot()","    func close()","    \/\/ ...","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This protocol-based design enables:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dependency injection"}]},{"text":" in ViewModels","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mocking"}]},{"type":"text","text":" for unit tests"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Abstraction"}]},{"type":"text","text":" over concrete router implementations"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Hierarchical Router Structure","anchor":"Hierarchical-Router-Structure","type":"heading"},{"inlineContent":[{"text":"SwiftRouting creates a hierarchy of routers that mirrors your navigation structure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Without tabs","type":"text"}]},{"type":"text","text":" (single stack):"}],"type":"paragraph"},{"syntax":null,"code":["App","└── RoutingView","    └── Router  root: .home","        ├── push(.list)","        │   └── Stack: [.home, .list]          (same Router)","        └── present(.detail)","            └── Router  root: .detail          (child Router, sheet)","                └── push(.comments)","                    └── Stack: [.detail, .comments]"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"With tabs","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["App","└── RoutingTabView","    └── TabRouter","        ├── RoutingView [Home Tab]","        │   └── Router  root: .home","        │       ├── push(.list)","        │       │   └── Stack: [.home, .list]          (same Router)","        │       └── present(.detail)","        │           └── Router  root: .detail          (child Router, sheet)","        │               └── push(.comments)","        │                   └── Stack: [.detail, .comments]","        ├── RoutingView [Search Tab]","        │   └── Router  root: .search","        └── RoutingView [Profile Tab]","            └── Router  root: .profile"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","type":"reference","isActive":true},{"type":"text","text":" creates its own "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"type":"text","text":". When you present a sheet or cover, a new child router is created. This hierarchy enables:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Scoped navigation","type":"text"}],"type":"strong"},{"text":": Each router manages its own stack","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Context propagation"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"RouteContext"},{"type":"text","text":" flows up through the hierarchy"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Coordinated dismissal","type":"text"}]},{"text":": ","type":"text"},{"code":"closeChildren()","type":"codeVoice"},{"text":" dismisses all descendants","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Component Relationships","anchor":"Component-Relationships","type":"heading"},{"syntax":null,"code":["┌─────────────────────────────────────────────────────────────┐","│                        RoutingTabView                        │","│                             │                               │","│                        TabRouter                            │","│               ┌─────────────┼─────────────┐                │","│               ▼             ▼             ▼                │","│         RoutingView    RoutingView    RoutingView           │","│              │                                              │","│           Router  ◀── @Environment(\\.router)               │","│           │    │                                            │","│      path │    │ sheet \/ cover                             │","│           ▼    ▼                                            │","│        Routes  Child Router (weak ref to parent)           │","│                │                                            │","│            contexts: [RouteContext observers]               │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"level":3,"text":"RoutingView","anchor":"RoutingView","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","isActive":true},{"type":"text","text":" is the entry point that creates a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" with an associated "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["RoutingView(destination: AppRoute.self, root: .home)"],"type":"codeListing"},{"inlineContent":[{"text":"It:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Creates a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" instance"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Injects it into the environment via "},{"type":"codeVoice","code":"@Environment(\\.router)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Registers the "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":" for navigation"}]}]},{"content":[{"inlineContent":[{"text":"Manages sheet and cover presentations","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Router","anchor":"Router","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true},{"type":"text","text":" manages:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Navigation path"}]},{"type":"text","text":": The stack of pushed routes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Root route","type":"text"}],"type":"strong"},{"text":": The initial route displayed","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Presentations","type":"text"}]},{"type":"text","text":": Sheet and cover modals"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Context observers","type":"text"}],"type":"strong"},{"text":": Registered ","type":"text"},{"type":"codeVoice","code":"RouteContext"},{"text":" handlers","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Child routers","type":"text"}],"type":"strong"},{"type":"text","text":": Routers created by presented modals"}]}]}],"type":"unorderedList"},{"level":3,"text":"TabRouter","anchor":"TabRouter","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouter"},{"type":"text","text":" coordinates navigation across tabs:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Manages the selected tab","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides access to each tab’s "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"text":"Enables cross-tab navigation (","type":"text"},{"type":"codeVoice","code":"push(_:in:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRoot(in:)"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles tab-aware deep links"}]}]}],"type":"unorderedList"},{"level":2,"text":"Data Flow","anchor":"Data-Flow","type":"heading"},{"level":3,"text":"Navigation Flow","anchor":"Navigation-Flow","type":"heading"},{"inlineContent":[{"type":"text","text":"Each navigation type operates differently on the router hierarchy:"}],"type":"paragraph"},{"syntax":null,"code":["push(_:)","    │","    ├── Appends route to NavigationStack path","    ├── Same Router instance handles the new route","    └── pop() or popToRoot() to unwind","","present(_:)  \/  cover(_:)","    │","    ├── Creates a new child Router","    ├── Presented as .sheet (present) or .fullScreenCover (cover)","    ├── Child Router manages its own NavigationStack","    └── close() or terminate(_:) to dismiss","","","User Action        Router Method         State Change         SwiftUI Result","─────────────      ─────────────         ────────────         ──────────────","Button tap    ──▶  push(.detail)    ──▶  path += [.detail]  ──▶  New view pushed","Link tapped   ──▶  present(.form)   ──▶  child Router set   ──▶  Sheet appears","Back gesture  ──▶  pop()            ──▶  path.removeLast()  ──▶  View popped","Dismiss swipe ──▶  close()          ──▶  child Router = nil ──▶  Sheet dismissed","Deep link     ──▶  handle(_:)       ──▶  path replaced      ──▶  Stack rebuilt"],"type":"codeListing"},{"level":3,"text":"Context Flow","anchor":"Context-Flow","type":"heading"},{"inlineContent":[{"code":"RouteContext","type":"codeVoice"},{"type":"text","text":" flows upward through the router hierarchy:"}],"type":"paragraph"},{"syntax":null,"code":["Child Router                    Parent Router","     │                               │","     │ router.terminate(context) ────▶│ .routerContext handler executes","     │                               │","     │◀──── Navigation completes ────│"],"type":"codeListing"},{"level":4,"text":"RouterContext Lifecycle","anchor":"RouterContext-Lifecycle","type":"heading"},{"syntax":null,"code":["                    ┌─────────────────────────────────────┐","                    │           Parent Router              │","                    │                                      │","  add(context:) ──▶ │  contexts: [SelectionContext: {...}] │","                    │                                      │","                    └──────────────────┬───────────────────┘","                                       │ context propagates up","                                       │","                    ┌──────────────────▼───────────────────┐","                    │           Child Router               │","                    │                                      │"," context(_:)    ──▶ │  Finds observer in parent hierarchy  │","  terminate(_:) ──▶ │  Executes observer + navigates back  │","                    │                                      │","                    └──────────────────────────────────────┘","","Observer removal:","  • Automatic  ──▶  route popped from stack (back \/ popToRoot)","  • Automatic  ──▶  Router deallocated (sheet dismissed)","  • Manual     ──▶  remove(context:) called explicitly"],"type":"codeListing"},{"level":3,"text":"Deep Link Flow","anchor":"Deep-Link-Flow","type":"heading"},{"syntax":null,"code":["URL\/Identifier → DeeplinkHandler → DeeplinkRoute → Router.handle(deeplink:)","                      │                  │                   │","                      │                  │                   └── Executes navigation sequence","                      │                  └── Factory creates navigation instructions","                      └── Async conversion with optional data fetching"],"type":"codeListing"},{"level":2,"text":"Memory Management","anchor":"Memory-Management","type":"heading"},{"level":3,"text":"Router Lifecycle","anchor":"Router-Lifecycle","type":"heading"},{"inlineContent":[{"text":"Routers are retained by their parent ","type":"text"},{"code":"RoutingView","type":"codeVoice"},{"text":". When a view is dismissed:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The router is deallocated"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Context observers are automatically cleaned up"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Child routers are released","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Context Cleanup","anchor":"Context-Cleanup","type":"heading"},{"inlineContent":[{"text":"Context observers registered on a route are automatically removed when that route is popped from the stack. This prevents memory leaks and stale callbacks.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Observer registered on .list route","router.push(.list)","router.add(context: SelectionContext.self) { ... }","","\/\/ When .list is popped, the observer is automatically removed","router.pop()"],"type":"codeListing"},{"level":2,"text":"Best Practices","anchor":"Best-Practices","type":"heading"},{"level":3,"text":"Keep Routes Focused","anchor":"Keep-Routes-Focused","type":"heading"},{"inlineContent":[{"text":"One route enum per feature or navigation context:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Good: Focused route enums","enum HomeRoute: Route { ... }","enum ProfileRoute: Route { ... }","enum SettingsRoute: Route { ... }","","\/\/ Avoid: One massive enum for everything","enum AppRoute: Route {","    case home, homeDetail, homeSettings, profile, profileEdit, ...","}"],"type":"codeListing"},{"level":3,"text":"Use Nested Routes for Complex Hierarchies","anchor":"Use-Nested-Routes-for-Complex-Hierarchies","type":"heading"},{"syntax":"swift","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","    case settings(SettingsRoute)","}"],"type":"codeListing"},{"level":3,"text":"Inject RouterModel, Not Router","anchor":"Inject-RouterModel-Not-Router","type":"heading"},{"inlineContent":[{"type":"text","text":"In ViewModels, depend on the protocol for testability:"}],"type":"paragraph"},{"syntax":"swift","code":["class MyViewModel {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","}"],"type":"codeListing"},{"level":3,"text":"Prefer terminate() Over Manual Navigation","anchor":"Prefer-terminate-Over-Manual-Navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"When completing a flow with context, use "},{"code":"terminate()","type":"codeVoice"},{"type":"text","text":" instead of manual "},{"code":"pop()","type":"codeVoice"},{"type":"text","text":" or "},{"code":"close()","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Good: Let the framework handle navigation","router.terminate(SelectionContext(item: selectedItem))","","\/\/ Avoid: Manual navigation after context","router.context(SelectionContext(item: selectedItem))","router.pop() \/\/ or router.close()"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/architecture"]}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/Macros":{"kind":"article","type":"topic","role":"collectionGroup","title":"Macros","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Macros","url":"\/documentation\/swiftrouting\/macros","abstract":[{"text":"Generate ","type":"text"},{"type":"codeVoice","code":"name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"routingType"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hideTabBarOnPush"},{"text":" for routes and tabs from their cases with the opt-in macros.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftrouting\/routermodel","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","role":"symbol","abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"title":"RouterModel","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"navigatorTitle":[{"text":"RouterModel","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"url":"\/documentation\/swiftrouting\/routingview","abstract":[{"type":"text","text":"Creates a navigation container with its own "},{"code":"Router","type":"codeVoice"},{"type":"text","text":"."}],"title":"RoutingView","type":"topic","navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"fragments":[{"text":"struct","ki