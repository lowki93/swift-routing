{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"SwiftRouting is designed with testability in mind. The protocol-based architecture allows you to mock routers and verify navigation behavior without running UI tests.","type":"text"}],"type":"paragraph"},{"text":"Testing Strategies","level":2,"anchor":"Testing-Strategies","type":"heading"},{"text":"Strategy 1: RouterSpy","level":3,"anchor":"Strategy-1-RouterSpy","type":"heading"},{"inlineContent":[{"code":"RouterModel","type":"codeVoice"},{"text":" has grown a fair amount of surface (push, present, cover, context handling, split selections…), so hand-rolling a mock for every test is tedious and easy to let drift out of sync with the protocol. Add the companion package instead:","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"1.0.0\"))","]"],"syntax":"swift","type":"codeListing"},{"code":[".product(name: \"SwiftRoutingTestSupport\", package: \"swift-routing\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"RouterSpy"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" and records every call instead of performing real navigation:"}],"type":"paragraph"},{"code":["import SwiftRoutingTestSupport","","let spy = RouterSpy(root: AppRoute.home)","spy.push(AppRoute.profile(userId: \"123\"))","","#expect(spy.pushedRoutes.count == 1)","#expect((spy.pushedRoutes.first as? AppRoute) == .profile(userId: \"123\"))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"routedDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"popCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"closeChildrenCallCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"terminatedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"dispatchedContexts"},{"type":"text","text":", "},{"type":"codeVoice","code":"addedContextTypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"removedContextTypes"},{"type":"text","text":", "},{"code":"detailSelections","type":"codeVoice"},{"text":", ","type":"text"},{"code":"contentSelections","type":"codeVoice"},{"text":" — plus live ","type":"text"},{"code":"currentRoute","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"pathCount","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"detailSelection","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"contentSelection","type":"codeVoice"},{"text":" that update as calls happen.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"code":"tabRouter(for:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"findRouterInTabRouter(for:)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"deepestRouter()","type":"codeVoice"},{"type":"text","text":" always return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on "},{"code":"RouterSpy","type":"codeVoice"},{"type":"text","text":" — there’s no real router hierarchy behind it. Test code that depends on those against a real "},{"code":"Router","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}]},{"level":3,"text":"Strategy 2: Test ViewModel Navigation","anchor":"Strategy-2-Test-ViewModel-Navigation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject the spy into your ViewModel:"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","final class ProfileViewModel {","    private let router: any RouterModel","    private let userId: String","    ","    init(router: any RouterModel, userId: String) {","        self.router = router","        self.userId = userId","    }","    ","    func editProfile() {","        router.push(ProfileRoute.edit(userId: userId))","    }","    ","    func openSettings() {","        router.present(ProfileRoute.settings)","    }","    ","    func logout() {","        router.popToRoot()","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Test the navigation behavior:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Testing","","@Suite(\"ProfileViewModel Navigation\")","struct ProfileViewModelTests {","    ","    @Test","    @MainActor","    func editProfile_pushesEditRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.editProfile()","        ","        #expect(spy.pushedRoutes.count == 1)","        let pushedRoute = spy.pushedRoutes.first as? ProfileRoute","        #expect(pushedRoute == .edit(userId: \"123\"))","    }","    ","    @Test","    @MainActor","    func openSettings_presentsSettingsRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.openSettings()","        ","        #expect(spy.presentedRoutes.count == 1)","        let presentedRoute = spy.presentedRoutes.first?.route as? ProfileRoute","        #expect(presentedRoute == .settings)","    }","    ","    @Test","    @MainActor","    func logout_popsToRoot() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.logout()","        ","        #expect(spy.popToRootCallCount == 1)","    }","}"]},{"level":2,"text":"Testing RouteContext","anchor":"Testing-RouteContext","type":"heading"},{"level":3,"text":"Testing Context Sending","anchor":"Testing-Context-Sending","type":"heading"},{"syntax":"swift","type":"codeListing","code":["@Test","@MainActor","func selectUser_terminatesWithContext() {","    let spy = RouterSpy(root: AppRoute.userPicker)","    let viewModel = UserPickerViewModel(router: spy)","    let user = User(id: \"1\", name: \"John\")","    ","    viewModel.selectUser(user)","    ","    #expect(spy.terminatedContexts.count == 1)","    let context = spy.terminatedContexts.first as? UserSelectionContext","    #expect(context?.selectedUser.id == \"1\")","}"]},{"level":3,"text":"Testing Context Reception","anchor":"Testing-Context-Reception","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For testing context handlers, use a real ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"text":" instance:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Test","@MainActor","func contextHandler_receivesContext() async {","    let router = Router(configuration: .default)","    var receivedUser: User?","    ","    router.add(context: UserSelectionContext.self) { context in","        receivedUser = context.selectedUser","    }","    ","    let user = User(id: \"1\", name: \"John\")","    router.context(UserSelectionContext(selectedUser: user))","    ","    #expect(receivedUser?.id == \"1\")","}"]},{"level":2,"text":"Testing Deep Links","anchor":"Testing-Deep-Links","type":"heading"},{"level":3,"text":"Testing DeeplinkHandler","anchor":"Testing-DeeplinkHandler","type":"heading"},{"syntax":"swift","type":"codeListing","code":["struct TestDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias D = AppRoute","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let userId):","            return .push(.profile(userId: userId))","        case .settings:","            return .present(.settings)","        default:","            return nil","        }","    }","}","","@Suite(\"DeeplinkHandler\")","struct DeeplinkHandlerTests {","    ","    @Test","    func homeIdentifier_returnsPushHome() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .home)","        ","        #expect(deeplink?.route == .home)","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func profileIdentifier_returnsPushWithUserId() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .profile(userId: \"123\"))","        ","        #expect(deeplink?.route == .profile(userId: \"123\"))","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func settingsIdentifier_returnsPresent() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .settings)","        ","        #expect(deeplink?.route == .settings)","        #expect(deeplink?.type == .sheet(withStack: true))","    }","    ","    @Test","    func unknownIdentifier_returnsNil() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .unknown)","        ","        #expect(deeplink == nil)","    }","}"]},{"level":3,"text":"Testing DeeplinkRoute Factories","anchor":"Testing-DeeplinkRoute-Factories","type":"heading"},{"syntax":"swift","type":"codeListing","code":["@Suite(\"DeeplinkRoute Factories\")","struct DeeplinkRouteFactoryTests {","    ","    @Test","    func push_createsCorrectDeeplink() {","        let deeplink: DeeplinkRoute<AppRoute> = .push(.home, path: [.list])","        ","        #expect(deeplink.route == .home)","        #expect(deeplink.type == .push)","        #expect(deeplink.path.count == 1)","    }","    ","    @Test","    func popToRoot_hasNilRoute() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot()","        ","        #expect(deeplink.route == nil)","    }","    ","    @Test","    func popToRootWithRoot_setsRoot() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot(root: .dashboard)","        ","        #expect(deeplink.root == .dashboard)","        #expect(deeplink.route == nil)","    }","}"]},{"level":2,"text":"Testing TabRouter Navigation","anchor":"Testing-TabRouter-Navigation","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"TabRouterSpy","type":"codeVoice"},{"text":", from the same ","type":"text"},{"code":"SwiftRoutingTestSupport","type":"codeVoice"},{"text":" package, conforms to ","type":"text"},{"code":"TabRouterModel","type":"codeVoice"},{"text":" the same way:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftRoutingTestSupport","","@Test","@MainActor","func crossTabNavigation_pushesToCorrectTab() {","    let spy = TabRouterSpy(root: AppRoute.home)","    let viewModel = HomeViewModel(tabRouter: spy)","    ","    viewModel.goToProfile(userId: \"123\")","    ","    #expect(spy.pushedRoutes.count == 1)","    let call = spy.pushedRoutes.first","    #expect((call?.route as? AppRoute) == .profile(userId: \"123\"))","    #expect((call?.tab as? AppTab) == .profile)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"changedTabs"},{"type":"text","text":", "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootTabs"},{"type":"text","text":"."}]},{"level":2,"text":"Best Practices","anchor":"Best-Practices","type":"heading"},{"level":3,"text":"Use Protocol Types","anchor":"Use-Protocol-Types","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Always inject ","type":"text"},{"code":"any RouterModel","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"any TabRouterModel","type":"codeVoice"},{"text":" instead of concrete types:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Good: Protocol type enables mocking","init(router: any RouterModel) { ... }","","\/\/ Avoid: Concrete type is harder to test","init(router: Router) { ... }"]},{"level":3,"text":"Test Navigation Intent, Not Implementation","anchor":"Test-Navigation-Intent-Not-Implementation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus on "},{"inlineContent":[{"text":"what","type":"text"}],"type":"emphasis"},{"type":"text","text":" navigation should happen, not "},{"inlineContent":[{"text":"how","type":"text"}],"type":"emphasis"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Good: Tests the intent","#expect(spy.pushedRoutes.contains { ($0 as? AppRoute) == .profile(userId: \"123\") })","","\/\/ Avoid: Testing implementation details","#expect(spy.pathCount == 2)"]},{"level":3,"text":"Prefer RouterSpy Over Hand-Rolled Mocks","anchor":"Prefer-RouterSpy-Over-Hand-Rolled-Mocks","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"RouterModel","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"TabRouterModel","type":"codeVoice"},{"type":"text","text":" have grown a fair amount of surface, and a hand-rolled mock silently drifts out of sync every time the protocol changes. "},{"code":"RouterSpy","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"TabRouterSpy","type":"codeVoice"},{"type":"text","text":" are tested against the real protocols, so use them instead of writing your own unless a test needs custom behavior a spy can’t express."}]},{"level":3,"text":"Test Async Handlers","anchor":"Test-Async-Handlers","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Deep link handlers are async. Use Swift Testing’s async support:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Test","func asyncDeeplinkHandler() async throws {","    let handler = MyDeeplinkHandler()","    let result = try await handler.deeplink(from: .someIdentifier)","    #expect(result != nil)","}"]}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Testing","interfaceLanguage":"swift"},"topicSections":[{"title":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"],"anchor":"Related"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/testing"]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftRouting"}],"title":"Testing Navigation"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"abstract":[{"type":"text","text":"Learn how to write unit tests for your navigation logic."}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/DeeplinkHandler":{"url":"\/documentation\/swiftrouting\/deeplinkhandler","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeeplinkHandler"}],"type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/D