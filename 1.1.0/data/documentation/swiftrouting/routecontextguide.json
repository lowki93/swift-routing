{"kind":"article","abstract":[{"type":"text","text":"Learn how to pass data between routes using RouteContext."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","isActive":true,"type":"reference"},{"text":" enables communication from child routes back to parent routes. Use it to pass selection results, form data, or completion signals up the navigation hierarchy.","type":"text"}],"type":"paragraph"},{"anchor":"What-is-RouteContext","type":"heading","level":2,"text":"What is RouteContext?"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"RouteContext","type":"codeVoice"},{"text":" is any type conforming to ","type":"text"},{"code":"Hashable & Sendable","type":"codeVoice"},{"text":". It acts as a message that can be sent from a child route and received by any ancestor route that registered an observer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct UserSelectionContext: RouteContext {","    let selectedUser: User","}","","struct FormCompletionContext: RouteContext {","    let formData: FormData","    let success: Bool","}"],"syntax":"swift"},{"anchor":"Registering-Context-Observers","type":"heading","level":2,"text":"Registering Context Observers"},{"anchor":"Using-the-View-Modifier","type":"heading","level":3,"text":"Using the View Modifier"},{"inlineContent":[{"type":"text","text":"The simplest way to observe contexts is with the "},{"code":"routerContext","type":"codeVoice"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"type":"codeListing","code":["struct ParentView: View {","    @State private var selectedUser: User?","    ","    var body: some View {","        ContentView()","            .routerContext(UserSelectionContext.self) { context in","                selectedUser = context.selectedUser","            }","    }","}"],"syntax":"swift"},{"anchor":"Using-Router-Directly","type":"heading","level":3,"text":"Using Router Directly"},{"inlineContent":[{"type":"text","text":"For ViewModel-driven architectures, register observers via "},{"code":"any RouterModel","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["@MainActor","final class ParentViewModel: ObservableObject {","    private let router: any RouterModel","","    init(router: any RouterModel) {","        self.router = router","    }","","    func startObservingContext() {","        router.add(context: UserSelectionContext.self) { [weak self] context in","            self?.selectedUser = context.selectedUser","        }","    }","","    func stopObservingContext() {","        router.remove(context: UserSelectionContext.self)","    }","","    deinit {","        stopObservingContext()","    }","}"],"syntax":"swift"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In views, prefer "},{"type":"codeVoice","code":".routerContext(...)"},{"type":"text","text":" for simple cases."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" in ViewModels when context handling belongs to presentation\/business logic."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Warning: Use weak captures for class references (for example view models) to prevent retain cycles."}]}]},{"anchor":"Sending-Context","type":"heading","level":2,"text":"Sending Context"},{"inlineContent":[{"text":"From a child route, send context using ","type":"text"},{"code":"context(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"terminate(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"anchor":"context-Send-Without-Navigation","type":"heading","level":3,"text":"context(_:) - Send Without Navigation"},{"inlineContent":[{"type":"text","text":"Sends the context to all observers without affecting navigation:"}],"type":"paragraph"},{"type":"codeListing","code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context but stay on this screen","                router.context(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"syntax":"swift"},{"anchor":"terminate-Send-and-Complete-Navigation","type":"heading","level":3,"text":"terminate(_:) - Send and Complete Navigation"},{"inlineContent":[{"type":"text","text":"Sends the context, then completes navigation based on router state:"}],"type":"paragraph"},{"type":"codeListing","code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","    ","    var body: some View {","        List(users) { user in","            Button(user.name) {","                \/\/ Send context and complete the current flow","                router.terminate(UserSelectionContext(selectedUser: user))","            }","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"code":"terminate(_:)","type":"codeVoice"},{"text":" will:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Execute all matching context observers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If a matching local context anchor is found, pop back to that point in the current stack","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Otherwise, close the modal if the router is presented"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise, go back one step"}]}]}]},{"anchor":"Context-Hierarchy","type":"heading","level":2,"text":"Context Hierarchy"},{"inlineContent":[{"type":"text","text":"Contexts propagate up through the entire router hierarchy:"}],"type":"paragraph"},{"type":"codeListing","code":["App Router","    └── Tab Router","            └── Home Router (observer registered here)","                    └── List Router","                            └── Detail Router (context sent from here)"],"syntax":null},{"inlineContent":[{"type":"text","text":"When context is sent from Detail Router, it reaches the observer in Home Router."}],"type":"paragraph"},{"anchor":"Checking-for-Observers-Before-Terminating","type":"heading","level":2,"text":"Checking for Observers Before Terminating"},{"inlineContent":[{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" always performs a navigation action (pop to context, close, or back), even if"},{"type":"text","text":" "},{"type":"text","text":"nobody actually observes the context — it can’t tell you in advance whether the payload will"},{"type":"text","text":" "},{"type":"text","text":"reach a listener. Use "},{"type":"codeVoice","code":"canTerminate(_:)"},{"type":"text","text":" to check first, for example to disable a “Confirm”"},{"type":"text","text":" "},{"type":"text","text":"button when no parent screen registered an observer:"}],"type":"paragraph"},{"type":"codeListing","code":["struct UserPickerView: View {","    @Environment(\\.router) private var router","    let users: [User]","","    var body: some View {","        List(users) { user in","            Button(user.name) {","                router.terminate(UserSelectionContext(selectedUser: user))","            }","            .disabled(!router.canTerminate(UserSelectionContext.self))","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"canTerminate(_:)"},{"text":" searches the same hierarchy as ","type":"text"},{"type":"codeVoice","code":"context(_:)"},{"text":" — the current router and every","type":"text"},{"text":" ","type":"text"},{"text":"ancestor — without executing anything.","type":"text"}],"type":"paragraph"},{"anchor":"Removing-Observers","type":"heading","level":2,"text":"Removing Observers"},{"inlineContent":[{"text":"Observers are automatically removed when their route is popped. You can also remove them manually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["router.remove(context: UserSelectionContext.self)"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"remove(context:)"},{"type":"text","text":" removes observers for that context type "},{"type":"strong","inlineContent":[{"type":"text","text":"only on the current route"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Common-Patterns","type":"heading","level":2,"text":"Common Patterns"},{"anchor":"Selection-Flow","type":"heading","level":3,"text":"Selection Flow"},{"type":"codeListing","code":["\/\/ Parent: Start selection","router.push(HomeRoute.userPicker)","","\/\/ Parent: Receive selection",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child: Complete selection","router.terminate(UserSelectionContext(selectedUser: user))"],"syntax":"swift"},{"anchor":"Form-Completion","type":"heading","level":3,"text":"Form Completion"},{"type":"codeListing","code":["\/\/ Parent",".routerContext(FormCompletionContext.self) { context in","    if context.success {","        showSuccessMessage()","    }","}","","\/\/ Child (form view)","func submitForm() async {","    let success = await api.submit(formData)","    router.terminate(FormCompletionContext(formData: formData, success: success))","}"],"syntax":"swift"},{"anchor":"Multi-Step-Wizard","type":"heading","level":3,"text":"Multi-Step Wizard"},{"type":"codeListing","code":["struct WizardContext: RouteContext {","    let step: Int","    let data: WizardData","}","","\/\/ Each step sends progress","router.context(WizardContext(step: currentStep, data: collectedData))","","\/\/ Final step terminates","router.terminate(WizardContext(step: finalStep, data: completeData))"],"syntax":"swift"},{"anchor":"Memory-Management","type":"heading","level":2,"text":"Memory Management"},{"inlineContent":[{"text":"Context closures can cause retain cycles. Always use weak references:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handleContext(context)","}","","\/\/ ✅ Correct with view model",".routerContext(MyContext.self) { [weak viewModel] context in","    viewModel?.process(context)","}","","\/\/ ❌ Wrong for class references - causes retain cycle","router.add(context: MyContext.self) { context in","    self.handleContext(context)  \/\/ Strong reference to self","}"],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/routecontextguide"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ContextModel"],"generated":true,"anchor":"Route-Context","title":"Route Context"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide"},"metadata":{"modules":[{"name":"SwiftRouting"}],"role":"article","title":"Route Context","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://SwiftRouting/documentation/SwiftRouting/ContextModel":{"kind":"symbol","abstract":[{"type":"text","text":"Defines context observation capabilities for router types."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContextModel"}],"title":"ContextModel","url":"\/documentation\/swiftrouting\/contextmodel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ContextModel"}],"role":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ContextModel"},"doc://SwiftRouting/documentation/SwiftRouting":{"type":"topic","role":"collection","url":"\/documentation\/swiftrouting","abstract":[{"text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI.","type":"text"}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","title":"SwiftRouting","kind":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/Troubleshooting":{"url":"\/documentation\/swiftrouting\/troubleshooting","title":"Troubleshooting","kind":"article","type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting","role":"collectionGroup","abstract":[{"text":"Diagnose and fix common issues encountered when using SwiftRouting.","type":"text"}]},"doc://SwiftRouting/documentation/SwiftRouting/RouteContext":{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","url":"\/documentation\/swiftrouting\/routecontext","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RouteContext"}],"abstract":[{"type":"text","text":"A type that can be used to pass data between routes and trigger navigation flow completions."}],"type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouteContext"}],"role":"symbol","title":"RouteContext"},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"type":"topic","title":"FAQ","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","url":"\/documentation\/swiftrouting\/faq","abstract":[{"type":"text","text":"Answers to common questions about SwiftRouting usage and design decisions."}],"kind":"article","role":"collectionGroup"}}}