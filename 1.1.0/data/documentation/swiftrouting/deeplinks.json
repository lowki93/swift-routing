ragraph","inlineContent":[{"type":"text","text":"Pushes intermediate routes from "},{"type":"codeVoice","code":"path"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigates to the final route with the specified type (only if "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"nil"},{"type":"text","text":")"}]}]}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Step 5 is skipped when "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", making "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" and "},{"type":"codeVoice","code":".updateRoot(_:)"},{"type":"text","text":" useful for reset scenarios without a final destination."}]}],"style":"note"},{"type":"heading","level":3,"anchor":"Complete-Example","text":"Complete Example"},{"type":"codeListing","syntax":"swift","code":["\/\/ Deep link: reset to dashboard, build path, then push detail as sheet",".present(","    .orderDetail(id: orderId),","    root: .dashboard,","    path: [.orders, .orderList]",")"]},{"type":"paragraph","inlineContent":[{"text":"This will:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Close any presented modals","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pop to root","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Set ","type":"text"},{"type":"codeVoice","code":".dashboard"},{"text":" as the new root","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Push ","type":"text"},{"code":".orders","type":"codeVoice"},{"text":" then ","type":"text"},{"code":".orderList","type":"codeVoice"},{"text":" onto the stack","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Present ","type":"text"},{"type":"codeVoice","code":".orderDetail(id:)"},{"text":" as a sheet","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Async-Deep-Link-Handling","text":"Async Deep Link Handling"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"deeplink(from:)","type":"codeVoice"},{"text":" method is ","type":"text"},{"code":"async","type":"codeVoice"},{"text":", allowing you to fetch data before navigation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    switch route {","    case .product(let productId):","        \/\/ Fetch product details before navigating","        let product = try await productService.fetch(id: productId)","        return .push(.productDetail(product))","        ","    case .user(let userId):","        \/\/ Validate user exists","        guard await userService.exists(id: userId) else {","            return nil  \/\/ Return nil to ignore invalid deep links","        }","        return .push(.profile(userId: userId))","        ","    default:","        return nil","    }","}"]},{"type":"heading","level":2,"anchor":"Composing-Deeplink-Handlers-Nested-Route-Logic","text":"Composing Deeplink Handlers (Nested Route Logic)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For larger apps, compose deep link handling by feature instead of keeping all cases in one switch."},{"type":"text","text":" "},{"type":"text","text":"This works well with nested route structures."}]},{"type":"codeListing","syntax":"swift","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let child): \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview: \"overview\"","        case .edit(let userId): \"edit(\\(userId))\"","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create feature-level handlers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum ProfileDeeplinkID: Hashable, Sendable {","    case profile(userId: String)","    case editProfile(userId: String)","}","","struct ProfileDeeplinkHandler: DeeplinkHandler {","    typealias R = ProfileDeeplinkID","    typealias D = AppRoute","","    func deeplink(from route: ProfileDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .profile(let userId):","            return .push(.profile(.overview), path: [.home])","        case .editProfile(let userId):","            return .push(.profile(.edit(userId: userId)))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Then compose at the app level:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum AppDeeplinkID: Hashable, Sendable {","    case home","    case profile(ProfileDeeplinkID)","    case reset","}","","struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkID","    typealias D = AppRoute","","    private let profileHandler = ProfileDeeplinkHandler()","","    func deeplink(from route: AppDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let profileID):","            return try await profileHandler.deeplink(from: profileID)","        case .reset:","            return .popToRoot()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Benefits:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"keeps handlers small and feature-focused","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"mirrors your nested route architecture","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"makes deeplink behavior easier to test"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Tab-Based-Deep-Links","text":"Tab-Based Deep Links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For apps with tab navigation, implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler"},{"type":"text","text":" and return a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink"},{"type":"text","text":". The "},{"type":"codeVoice","code":"deeplink"},{"type":"text","text":" property accepts any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute"},{"type":"text","text":", including reset scenarios with "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct AppTabDeeplinkHandler: TabDeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias T = HomeTab","    typealias D = HomeRoute","","    func deeplink(from route: DeeplinkIdentifier) async throws -> TabDeeplink<HomeTab, HomeRoute>? {","        switch route {","        case .profile(let userId):","            return TabDeeplink(","                tab: .profile,","                deeplink: .push(.profile(userId: userId))","            )","            ","        case .search(let query):","            return TabDeeplink(","                tab: .search,","                deeplink: .push(.searchResults(query: query), path: [.search])","            )","            ","        case .resetHome:","            return TabDeeplink(tab: .home, deeplink: .popToRoot())","            ","        default:","            return nil","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"handle(tabDeeplink:)"},{"type":"text","text":" method switches