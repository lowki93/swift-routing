ory → Product",".push(","    .product(id: productId),","    path: [","        .category(id: categoryId),","        .subcategory(id: subcategoryId)","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the back button works correctly through the entire hierarchy."}]},{"type":"heading","level":2,"anchor":"Resetting-Navigation","text":"Resetting Navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".popToRoot()"},{"text":" to reset navigation without navigating to a specific route:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Simply reset to root",".popToRoot()","","\/\/ Reset and change the root route",".popToRoot(root: .dashboard)","","\/\/ Update root only (no popToRoot, no path navigation)",".updateRoot(.newHome)"]},{"type":"paragraph","inlineContent":[{"text":"These are useful for logout flows, session resets, or returning users to a clean state.","type":"text"}]},{"type":"heading","level":2,"anchor":"Error-Handling","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" from "},{"type":"codeVoice","code":"deeplink(from:)"},{"type":"text","text":" to ignore invalid deep links:"}]},{"type":"codeListing","syntax":"swift","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    guard isValidRoute(route) else {","        return nil  \/\/ Silently ignore","    }","    ","    \/\/ Or throw for error handling","    guard let data = try await fetchData(for: route) else {","        throw DeeplinkError.notFound","    }","    ","    return .push(.detail(data))","}"]}]}],"seeAlsoSections":[{"title":"Deep Linking","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRouteGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Tab