{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Learn how to navigate between routes using the Router.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"type":"text","text":" is your primary interface for programmatic navigation. Every "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","isActive":true,"type":"reference"},{"type":"text","text":" creates its own router, accessible via the SwiftUI environment."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Accessing the Router","anchor":"Accessing-the-Router"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" property wrapper to access the router:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        Button(\"Navigate\") {","            router.push(HomeRoute.detail(id: 42))","        }","    }","}"]},{"type":"heading","level":2,"text":"Push Navigation","anchor":"Push-Navigation"},{"inlineContent":[{"text":"Push adds a route to the navigation stack with a standard slide animation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Push a new route","router.push(HomeRoute.detail(id: 42))","","\/\/ Using NavigationLink","NavigationLink(route: HomeRoute.detail(id: 42)) {","    Text(\"View Details\")","}"]},{"type":"heading","level":3,"text":"NavigationLink Behavior","anchor":"NavigationLink-Behavior"},{"inlineContent":[{"type":"codeVoice","code":"NavigationLink(route:)"},{"type":"text","text":" is push-only (stack navigation), because it uses"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationLink(value:)"},{"type":"text","text":" with route values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important notes:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"It must be used inside a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":" configured with a matching "},{"type":"codeVoice","code":"RouteDestination"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It does not perform modal presentation, even if the route has a modal ","type":"text"},{"code":"routingType","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"For modal flows, prefer ","type":"text"},{"code":"router.present(...)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"router.cover(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Modal Presentations","anchor":"Modal-Presentations"},{"type":"heading","level":3,"text":"Sheet","anchor":"Sheet"},{"inlineContent":[{"type":"text","text":"Present a route as a modal sheet:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ With navigation stack (default)","router.present(HomeRoute.settings)","","\/\/ Without navigation stack","router.present(HomeRoute.settings, withStack: false)"]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"withStack: false"},{"type":"text","text":" when the presented destination needs direct sheet modifiers such as:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".presentationDetents([.medium])",".presentationDragIndicator(.visible)"]},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"withStack: true"},{"type":"text","text":" (default), the route is wrapped in a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":", which can make these modifiers less predictable on the final destination view."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Full-Screen Cover","anchor":"Full-Screen-Cover"},{"inlineContent":[{"text":"Present a route as a full-screen cover:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.cover(HomeRoute.onboarding)"]},{"type":"heading","level":2,"text":"Navigating Back","anchor":"Navigating-Back"},{"type":"heading","level":3,"text":"Back One Step","anchor":"Back-One-Step"},{"inlineContent":[{"text":"Remove the top route from the stack:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.back()"]},{"type":"heading","level":3,"text":"Pop to Root","anchor":"Pop-to-Root"},{"inlineContent":[{"text":"Return to the root of the navigation stack:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.popToRoot()"]},{"type":"heading","level":3,"text":"Close Modal","anchor":"Close-Modal"},{"inlineContent":[{"type":"text","text":"Dismiss a presented sheet or cover:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.close()"]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"close()","type":"codeVoice"},{"text":" only works on routers that are presented (sheets or covers).","type":"text"}]}],"type":"aside","style":"note"},{"type":"heading","level":2,"text":"Updating the Root","anchor":"Updating-the-Root"},{"inlineContent":[{"type":"text","text":"Replace the current root route:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.update(root: HomeRoute.dashboard)"]},{"inlineContent":[{"text":"This is useful for scenarios like switching between logged-in and logged-out states.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Using routingType","anchor":"Using-routingType"},{"inlineContent":[{"type":"text","text":"Instead of calling specific methods, you can use "},{"code":"route(_:)","type":"codeVoice"},{"type":"text","text":" which respects the route’s "},{"code":"routingType","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ This will use the route's defined routingType","router.route(HomeRoute.settings)","","\/\/ Equivalent to checking routingType and calling the appropriate method","switch route.routingType {","case .push: router.push(route)","case .sheet: router.present(route)","case .cover: router.cover(route)","case .root: router.update(root: route)","}"]},{"inlineContent":[{"type":"text","text":"For routes that require sheet presentation customizations ("},{"type":"codeVoice","code":"presentationDetents"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentationDragIndicator"},{"type":"text","text":"), prefer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var routingType: RoutingType { .sheet(withStack: false) }"]},{"type":"heading","level":2,"text":"Router Properties","anchor":"Router-Properties"},{"inlineContent":[{"text":"The router provides useful properties for UI decisions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check if this router is presented as a modal","if router.isPresented {","    Button(\"Close\") { router.close() }","}","","\/\/ Get the current route","let current = router.currentRoute","","\/\/ Check navigation depth","if router.routeCount > 1 {","    Button(\"Back\") { router.back() }","}"]},{"type":"heading","level":2,"text":"Injecting Router into ViewModels","anchor":"Injecting-Router-into-ViewModels"},{"inlineContent":[{"type":"text","text":"For MVVM architectures, inject the router using "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class DetailViewModel: ObservableObject {","    private let router: any RouterModel","    ","    init(router: any RouterModel) {","        self.router = router","    }","    ","    func goToSettings() {","        router.present(HomeRoute.settings)","    }","}","","struct DetailView: View {","    @Environment(\\.router) private var router","    @StateObject private var viewModel: DetailViewModel","    ","    init() {","        \/\/ Note: Initialize in onAppear or use a factory","    }","    ","    var body: some View {","        \/\/ ...","    }","}"]},{"type":"heading","level":2,"text":"App-Level Convenience Overloads (Optional)","anchor":"App-Level-Convenience-Overloads-Optional"},{"inlineContent":[{"text":"If your app uses one main route enum (for example ","type":"text"},{"type":"codeVoice","code":"HomeRoute"},{"text":"), you can add","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterModel"},{"text":" overloads to improve call-site ergonomics:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public extension RouterModel {","    @_disfavoredOverload","    func push(_ homeRoute: HomeRoute) {","        push(homeRoute)","    }","","    @_disfavoredOverload","    func update(root homeRoute: HomeRoute) {","        update(root: homeRoute)","    }","}"]},{"inlineContent":[{"type":"text","text":"Before:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.push(HomeRoute.profile)","router.update(root: HomeRoute.home)"]},{"inlineContent":[{"type":"text","text":"After:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.push(.profile)","router.update(root: .home)"]},{"inlineContent":[{"type":"text","text":"Use this pattern for your main route type only, to keep overload resolution predictable."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Closing Child Routers","anchor":"Closing-Child-Routers"},{"inlineContent":[{"type":"text","text":"When handling deep links or resetting navigation, close all presented modals:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["router.closeChildren()"]},{"inlineContent":[{"type":"text","text":"This dismisses any sheets or covers presented from this router."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Targeting the Frontmost Router","anchor":"Targeting-the-Frontmost-Router"},{"inlineContent":[{"type":"text","text":"Inside a "},{"type":"codeVoice","code":"RoutingView"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":" always gives you the router for that view."},{"type":"text","text":" "},{"type":"text","text":"But at the "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" App level — where no environment is available — you hold a reference to"},{"type":"text","text":" "},{"type":"text","text":"the root router directly. In that case, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()"},{"type":"text","text":" to target whichever"},{"type":"text","text":" "},{"type":"text","text":"router is actually on screen at the moment the action fires:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","  @State var rootRouter = Router(configuration: .default)","","  var body: some Scene {","    WindowGroup {","      ContentView()","        .environment(rootRouter)","        .onOpenURL { url in","          Task { @MainActor in","            rootRouter.deepestRouter()?.terminate(MyContext())","          }","        }","    }","  }","}"]},{"inlineContent":[{"code":"deepestRouter()","type":"codeVoice"},{"text":" traverses the router tree depth-first, following the last live child at each","type":"text"},{"text":" ","type":"text"},{"text":"level until it reaches a leaf with no active children. If no child is active, it returns the","type":"text"},{"text":" ","type":"text"},{"text":"receiver itself.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" at dispatch time, not at setup time."},{"type":"text","text":" "},{"type":"text","text":"If a modal is on screen when the action fires, "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" returns that modal’s router"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" unwinds through the correct presenter."}]}],"type":"aside","style":"important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/navigationbasics"]}],"seeAlsoSections":[{"title":"Navigation","generated":true,"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel"],"anchor":"Navigation"}],"metadata":{"role":"article","roleHeading":"Article","title":"Navigation Basics","modules":[{"name":"SwiftRouting"}]},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],["doc:\/\/SwiftRouting\/documentation\/SwiftRouting","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration"]]},"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","interfaceLanguage":"swift"},"references":{"doc://SwiftRouting/documentation/SwiftRouting/RouterModel":{"kind":"symbol","url":"\/documentation\/swiftrouting\/routermodel","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterModel","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","abstract":[{"text":"Defines navigation capabilities within a ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" or other components.","type":"text"}],"title":"RouterModel","type":"topic","navigatorTitle":[{"text":"RouterModel","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting/Router":{"type":"topic","abstract":[{"type":"text","text":"Manages programmatic navigation for both stack-based and split-view contexts."}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","navigatorTitle":[{"text":"Router","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swiftrouting\/router","role":"symbol","title":"Router","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Router","kind":"identifier"}]},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouterModel":{"title":"BaseRouterModel","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Defines the base navigation capabilities shared by all router types."}],"navigatorTitle":[{"kind":"identifier","text":"BaseRouterModel"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BaseRouterModel"}],"type":"topic","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouterModel","url":"\/documentation\/swiftrouting\/baseroutermodel"},"doc://SwiftRouting/documentation/SwiftRouting":{"title":"SwiftRouting","abstract":[{"type":"text","text":"A lightweight, type-safe navigation framework built on top of NavigationStack for SwiftUI."}],"role":"collection","url":"\/documentation\/swiftrouting","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting","type":"topic","kind":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/FAQ":{"kind":"article","title":"FAQ","type":"topic","role":"collectionGroup","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ","abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"url":"\/documentation\/swiftrouting\/faq"},"doc://SwiftRouting/documentation/SwiftRouting/BaseRouter/deepestRouter()":{"url":"\/documentation\/swiftrouting\/baserouter\/deepestrouter()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deepestRouter"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12SwiftRouting6RouterC","kind":"typeIdentifier","text":"Router"},{"kind":"text","text":"?"}],"title":"deepestRouter()","abstract":[],"kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/BaseRouter\/deepestRouter()","role":"symbol","type":"topic"},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","title":"RoutingView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoutingView","kind":"identifier"}],"abstract":[{"text":"Creates a navigation container with its own ","type":"text"},{"type":"codeVoice","code":"Router"},{"text":".","type":"text"}],"url":"\/documentation\/swiftrouting\/routingview","type":"topic","role":"symbol"},"doc://SwiftRouting/documentation/SwiftRouting/Migration":{"role":"collectionGroup","abstract":[{"text":"Adopt SwiftRouting in an existing SwiftUI app with minimal disruption.","type":"text"}],"url":"\/documentation\/swiftrouting\/migration","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Migration","type":"topic","kind":"article","title":"Migrating from NavigationStack"}}}