ate:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct HomeView: View {","    @Environment(\\.router) private var router","    ","    var body: some View {","        VStack {","            Text(\"Welcome Home\")","            ","            \/\/ Push navigation","            Button(\"View Details\") {","                router.push(HomeRoute.detail(id: 42))","            }","            ","            \/\/ Present as sheet","            Button(\"Open Settings\") {","                router.present(HomeRoute.settings)","            }","        }","    }","}"]},{"text":"Navigation Methods","type":"heading","anchor":"Navigation-Methods","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","type":"reference","isActive":true},{"text":" provides several navigation methods:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"push(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pushes a route onto the navigation stack"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"present(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents a route as a modal sheet","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cover(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents a route as a full-screen cover","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"back()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Navigates back one step"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"popToRoot()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returns to the root of the s