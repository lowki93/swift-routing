,{"type":"heading","anchor":"DeeplinkRoute-Structure","text":"DeeplinkRoute Structure","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","type":"reference"},{"text":" defines how to navigate to a destination. Use factory methods for common scenarios:","type":"text"}]},{"type":"codeListing","code":["\/\/ Push a route onto the navigation stack",".push(.detail(id: 1))","","\/\/ Push with intermediate routes (builds navigation hierarchy)",".push(.detail(id: 1), path: [.list, .category(id: 5)])","","\/\/ Push with a new root",".push(.detail(id: 1), root: .home, path: [.list])","","\/\/ Present as a sheet",".present(.settings)",".present(.settings, withStack: false)  \/\/ Without navigation stack","","\/\/ Present as a full-screen cover",".cover(.onboarding)","","\/\/ Reset navigation without navigating to a new route",".popToRoot()",".popToRoot(root: .home)  \/\/ Reset and update root","","\/\/ Update root without additional navigation",".updateRoot(.dashboard)"],"syntax":"swift"},{"type":"heading","anchor":"Factory-Methods","text":"Factory Methods","level":3},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Factory"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".push(_:root:path:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Push a route onto the navigation stack"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".present(_:withStack:root:path:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Present as a sheet","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".cover(_:root:path:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Present as a full-screen cover"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".popToRoot(root:)"}],"type"