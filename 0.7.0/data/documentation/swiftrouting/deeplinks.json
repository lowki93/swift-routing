pToRoot()"},{"type":"text","text":"), the final navigation step is skipped. The "},{"type":"codeVoice","code":"type"},{"type":"text","text":" parameter is set automatically by factory methods."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","anchor":"Handling-Deep-Links","text":"Handling Deep Links","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the router’s "},{"type":"codeVoice","code":"handle(deeplink:)"},{"type":"text","text":" method:"}]},{"type":"codeListing","code":["struct ContentView: View {","    var body: some View {","        RoutingView(destination: HomeRoute.self, root: .home) {","            HomeRootView()","        }","    }","}","","struct HomeRootView: View {","    @Environment(\\.router) private var router","    let handler = AppDeeplinkHandler()","","    var body: some View {","        HomeView()","            .onOpenURL { url in","                Task {","                    guard let identifier = DeeplinkIdentifier(url: url) else { return }","                    guard let deeplink = try await handler.deeplink(from: identifier) else { return }","                    router.handle(deeplink: deeplink)","                }","            }","    }","}"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"The route type returned by "},{"type":"codeVoice","code":"DeeplinkHandler"},{"type":"text","text":" ("},{"type":"codeVoice","code":"D"},{"type":"text","text":") must match the route type used by "},{"type":"codeVoice","code":"RoutingView(destination:root:)"},{"type":"text","text":"."}]}],"name":"Note"},{"type":"heading","anchor":"What-handledeeplink-Does","text":"What handle(deeplink:) Does","level":3},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Closes all presented modals ("},{"type":"codeVoice","code":"closeChildren()"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"text":"Pops to the root (","type":"text"},{"code":"popToRoot()","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally updates the root route (if "},{"type":"codeVoice","code":"root"},{"type":"text","text":" is set)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pushes intermediate routes from "},{"type":"codeVoice","code":"path"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Navigates to the final route with the specified type (only if "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"nil"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Step 5 is skipped when "},{"type":"codeVoice","code":"route"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", making "},{"type":"codeVoice","code":".popToRoot()"},{"type":"text","text":" and "},{"type":"codeVoice","code":".updateRoot(_:)"},{"type":"text","text":" useful for reset scenarios without a final destination."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","anchor":"Complete-Example","text":"Complete Example","level":3},{"type":"codeListing","code":["\/\/ Deep link: reset to dashboard, build path, then push detail as sheet",".present(","    .orderDetail(id: orderId),","    root: .dashboard,","    path: [.orders, .orderList]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This will:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Close any presented modals"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pop to root","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":".dashboard"},{"type":"text","text":" as the new root"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Push "},{"code":".orders","type":"codeVoice"},{"type":"text","text":" then "},{"code":".orderList","type":"codeVoice"},{"type":"text","text":" onto the stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Present "},{"type":"codeVoice","code":".orderDetail(id:)"},{"type":"text","text":" as a sheet"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Async-Deep-Link-Handling","text":"Async Deep Link Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"deeplink(from:)","type":"codeVoice"},{"type":"text","text":" method is "},{"code":"async","type":"codeVoice"},{"type":"text","text":", allowing you to fetch data before navigation:"}]},{"type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    switch route {","    case .product(let productId):","        \/\/ Fetch product details before navigating","        let product = try await productService.fetch(id: productId)","        return .push(.productDetail(product))","        ","    case .user(let userId):","        \/\/ Validate user exists","        guard await userService.exists(id: userId) else {","            return nil  \/\/ Return nil to ignore invalid deep links","        }","        return .push(.profile(userId: userId))","        ","    default:","        return nil","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Composing-Deeplink-Handlers-Nested-Route-Logic","text":"Composing Deeplink Handlers (Nested Route Logic)","level":2},{"type":"paragraph","inlineContent":[{"text":"For larger apps, compose deep link handling by feature instead of keeping all cases in one switch.","type":"text"},{"text":" ","type":"text"},{"text":"This works well with nested route structures.","type":"text"}]},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case profile(ProfileRoute)","","    var name: String {","        switch self {","        case .home: \"home\"","        case .profile(let child): \"profile.\\(child.name)\"","        }","    }","}","","enum ProfileRoute: Route {","    case overview","    case edit(userId: String)","","    var name: String {","        switch self {","        case .overview: \"overview\"","        case .edit(let userId): \"edit(\\(userId))\"","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create feature-level handlers:","type":"text"}]},{"type":"codeListing","code":["enum ProfileDeeplinkID: Hashable, Sendable {","    case profile(userId: String)","    case editProfile(userId: String)","}","","struct ProfileDeeplinkHandler: DeeplinkHandler {","    typealias R = ProfileDeeplinkID","    typealias D = AppRoute","","    func deeplink(from route: ProfileDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .profile(let userId):","            return .push(.profile(.overview), path: [.home])","        case .editProfile(let userId):","            return .push(.profile(.edit(userId: userId)))","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then compose at the app level:"}]},{"type":"codeListing","code":["enum AppDeeplinkID: Hashable, Sendable {","    case home","    case profile(ProfileDeeplinkID)","    case reset","}","","struct AppDeeplinkHandler: DeeplinkHandler {","    typealias R = AppDeeplinkID","    typealias D = AppRoute","","    private let profileHandler = ProfileDeeplinkHandler()","","    func deeplink(from route: AppDeeplinkID) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let profileID):","            return try await profileHandler.deeplink(from: profileID)","        case .reset:","            return .popToRoot()","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Benefits:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"keeps handlers small and feature-focused","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"mirrors your nested route architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"makes deeplink behavior easier to test"}]}]}]},{"type":"heading","anchor":"Tab-Based-Deep-Links","text":"Tab-Based Deep Links","level":2},{"type":"paragraph","inlineContent":[{"text":"For apps with tab navigation, implement ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplinkHandler","isActive":true,"type":"reference"},{"text":" and return a ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabDeeplink","isActive":true,"type":"reference"},{"text":". The ","type":"text"},{"code":"deeplink","type":"codeVoice"},{"text":" property accepts any ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkRoute","isActive":true,"type":"reference"},{"text":", including reset scenarios with ","type":"text"},{"code":".popToRoot()","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct AppTabDeeplinkHandler: TabDeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias T = HomeTab","    typealias D = HomeRoute","","    func deeplink(from route: DeeplinkIdentifier) async throws -> TabDeeplink<HomeTab, HomeRoute>? {","        switch route {","        case .profile(let userId):","            return TabDeeplink(","                tab: .profile,","                deeplink: .push(.profile(userId: userId))","            )","            ","        case .search(let query):","            return TabDeeplink(","                tab: .search,","                deeplink: .push(.searchResults(query: query), path: [.search