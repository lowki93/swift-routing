xt":" to access the tab router."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","anchor":"Building-Navigation-Paths","text":"Building Navigation Paths","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For complex deep links, build a path of intermediate routes:"}]},{"type":"codeListing","code":["\/\/ Deep link to: Home → Category → Subcategory → Product",".push(","    .product(id: productId),","    path: [","        .category(id: categoryId),","        .subcategory(id: subcategoryId)","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This ensures the back button works correctly through the entire hierarchy.","type":"text"}]},{"type":"heading","anchor":"Resetting-Navigation","text":"Resetting Navigation","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".popToRoot()"},{"text":" to reset navigation without navigating to a specific route:","type":"text"}]},{"type":"codeListing","code":["\/\/ Simply reset to root",".popToRoot()","","\/\/ Reset and change the root route",".popToRoot(root: .dashboard)","","\/\/ Update root only (no popToRoot, no path navigation)",".updateRoot(.newHome)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"These are useful for logout flows, session resets, or returning users to a clean state.","type":"text"}]},{"type":"heading","anchor":"Error-Handling","text":"Error Handling","level":2},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"deeplink(from:)"},{"text":" to ignore invalid deep links:","type":"text"}]},{"type":"codeListing","code":["func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<HomeRoute>? {","    guard isValidRoute(route) else {","        return nil  \/\/ Silently ignore","    }","    ","    \/\/ Or throw for error handling","    guard let data = try await fetchDat