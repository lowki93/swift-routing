{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"SwiftRouting provides first-class support for "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"},{"type":"text","text":". All three columns (sidebar, content, detail) share the same split-type "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" — column selection is driven by typed, "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values, and only the detail column has a navigation stack, bound directly to that shared router’s "},{"type":"codeVoice","code":"path"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A split-type "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true,"type":"reference"},{"type":"text","text":" is created automatically and injected into the environment via "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":". It conforms to "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel","isActive":true,"type":"reference"},{"type":"text","text":", giving you typed bindings and programmatic selection alongside the regular "},{"type":"codeVoice","code":"push"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"present"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"cover"},{"type":"text","text":" API."}],"type":"paragraph"},{"text":"2-Column Layout (Sidebar + Detail)","anchor":"2-Column-Layout-Sidebar-+-Detail","type":"heading","level":2},{"inlineContent":[{"text":"The sidebar shows a fixed route; the detail column is derived from a typed selection:","type":"text"}],"type":"paragraph"},{"code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","}"],"type":"codeListing","syntax":"swift"},{"text":"3-Column Layout (Sidebar + Content + Detail)","anchor":"3-Column-Layout-Sidebar-+-Content-+-Detail","type":"heading","level":2},{"inlineContent":[{"text":"Add a ","type":"text"},{"code":"content:","type":"codeVoice"},{"text":" closure to introduce a middle column. The sidebar drives the content column, and the content column drives the detail column:","type":"text"}],"type":"paragraph"},{"code":["RoutingSplitView(destination: AppRoute.self, sidebar: .sidebar) { (type: PlayerType) in","    AppRoute.players(type)","} detail: { (player: Player) in","    AppRoute.player(player)","}"],"type":"codeListing","syntax":"swift"},{"text":"Driving Selections","anchor":"Driving-Selections","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/detailBinding(as:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/contentBinding(as:)","isActive":true},{"type":"text","text":" to wire a "},{"type":"codeVoice","code":"List"},{"type":"text","text":" selection directly, or call "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(detail:)","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/select(content:)","isActive":true},{"type":"text","text":" programmatically. Both paths behave identically – the binding calls "},{"type":"codeVoice","code":"select(detail:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"select(content:)"},{"type":"text","text":" internally, so a selection made by tapping a "},{"type":"codeVoice","code":"List"},{"type":"text","text":" row logs a "},{"type":"codeVoice","code":".navigation"},{"type":"text","text":" event just like a programmatic call would."}],"type":"paragraph"},{"code":["struct SidebarScreen: View {","    @Environment(\\.router) var router","    let items: [PlayerType] = PlayerType.allCases","","    var body: some View {","        List(items, selection: router.detailBinding(as: PlayerType.self)) { item in","            NavigationLink(item.label, value: item)","        }","        .onFirstAppear {","            guard !router.isCompact else { return }","            router.select(detail: items.first)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/hasContentColumn","isActive":true},{"type":"text","text":" to branch between driving the content or the detail column from the same sidebar code path:"}],"type":"paragraph"},{"code":["if router.hasContentColumn {","    router.select(content: playerType)","} else {","    router.select(detail: playerType)","}"],"type":"codeListing","syntax":"swift"},{"text":"Compact Mode (iPhone)","anchor":"Compact-Mode-iPhone","type":"heading","level":2},{"inlineContent":[{"text":"On iPhone, ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" collapses into a single-column stack. Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/isCompact","type":"reference","isActive":true},{"text":" to skip auto-selection and let the user tap to navigate instead:","type":"text"}],"type":"paragraph"},{"code":[".onFirstAppear {","    guard !router.isCompact else { return }","    router.select(detail: items.first)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"isCompact"},{"type":"text","text":" reflects "},{"type":"codeVoice","code":"horizontalSizeClass"},{"type":"text","text":", so it also updates during iPad multitasking."}],"type":"paragraph"},{"text":"Navigating Within a Column","anchor":"Navigating-Within-a-Column","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"router.push(_:)"},{"type":"text","text":" works like everywhere else in SwiftRouting, but since all columns share the same split "},{"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","isActive":true},{"type":"text","text":", it always pushes onto the one navigation stack — rendered only in the detail column. Pushing from the sidebar or content column doesn’t open a stack there; it appears in the detail column instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"router.present(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".cover(_:)"},{"type":"text","text":" are also router-wide, not per-column: calling them from any column presents the same sheet\/cover over the whole "},{"type":"codeVoice","code":"RoutingSplitView"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Deep Linking","anchor":"Deep-Linking","type":"heading","level":2},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplinkHandler","type":"reference"},{"text":" to convert an external input into a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitDeeplink","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router\/handle(splitDeeplink:)","type":"reference"},{"text":" to apply it:","type":"text"}],"type":"paragraph"},{"code":["struct PlayerSplitDeeplinkHandler: SplitDeeplinkHandler {","    func deeplink(from route: DeeplinkIdentifier) async throws -> SplitDeeplink<PlayerType, Player, AppRoute>? {","        switch route {","        case .player(let player):","            SplitDeeplink(content: player.type, detail: player)","        default:","            nil","        }","    }","}","","router.handle(splitDeeplink: splitDeeplink)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"handle(splitDeeplink:)","type":"codeVoice"},{"text":" selects ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" (3-column layout only), then ","type":"text"},{"code":"detail","type":"codeVoice"},{"text":", then applies the optional ","type":"text"},{"code":"deeplink","type":"codeVoice"},{"text":" within the detail column’s own navigation stack — the content column has no stack of its own, so ","type":"text"},{"code":"deeplink","type":"codeVoice"},{"text":" can only push into ","type":"text"},{"code":"detail","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"SplitModel Reference","anchor":"SplitModel-Reference","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"detailSelection","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type-erased current selection for the detail column"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contentSelection"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type-erased current selection for the content column (3-column only)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"isCompact","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the split view is currently collapsed to a single column"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"hasContentColumn"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this router was created with a "},{"type":"codeVoice","code":"content:"},{"type":"text","text":" closure"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"detailBinding(as:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Typed "},{"type":"codeVoice","code":"Binding<T?>"},{"type":"text","text":" for the detail column selection"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contentBinding(as:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed ","type":"text"},{"code":"Binding<T?>","type":"codeVoice"},{"text":" for the content column selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"select(detail:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Programmatically drive the detail column selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"select(content:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Programmatically drive the content column selection","type":"text"}]}]]],"type":"table"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/swiftrouting\/splitnavigation"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingSplitView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitModel"],"anchor":"Split-Navigation","title":"Split Navigation","generated":true}],"metadata":{"roleHeading":"Article","role":"article","title":"Split Navigation","modules":[{"name":"SwiftRouting"}]},"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/SplitNavigation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Learn how to implement sidebar-based split navigation with SwiftRouting."}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"sections":[],"kind":"article","references":{"doc://SwiftRouting/documentation/SwiftRouting":{"tit