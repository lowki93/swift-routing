{"abstract":[{"text":"Answers to common questions about SwiftRouting usage and design decisions.","type":"text"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics"],"title":"Related","anchor":"Related"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/faq"]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting"],"title":"Support","anchor":"Support","generated":true}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"FAQ","modules":[{"name":"SwiftRouting"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article addresses frequently asked questions about routing patterns, API choices, and known limitations."}]},{"type":"thematicBreak"},{"type":"heading","text":"When should I use sheet vs cover?","anchor":"When-should-I-use-sheet-vs-cover","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"present(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cover(_:)"},{"type":"text","text":" create a child router and present a modal, but they differ in appearance and dismissal behavior:"}]},{"type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"present(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"cover(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"SwiftUI modifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".sheet"}],"type":"paragraph"}],[{"inlineContent":[{"code":".fullScreenCover","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Partial screen, card style"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full screen","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Dismiss gesture"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Swipe down"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Not dismissable by gesture"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Use case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quick actions, pickers, forms"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Onboarding, auth, immersive flows","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":"present(_:)","type":"codeVoice"},{"text":" when:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The user needs to stay aware of the context behind (e.g. selecting an item from a list)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The flow is short and dismissable (form, picker, confirmation)","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use "},{"code":"cover(_:)","type":"codeVoice"},{"type":"text","text":" when:"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The flow takes over the full experience (onboarding, login, camera)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You want to prevent accidental swipe-to-dismiss","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both support navigation stacks inside them via the "},{"type":"codeVoice","code":"withStack"},{"type":"text","text":" parameter on "},{"type":"codeVoice","code":"present(_:)"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ Sheet with its own NavigationStack (default)","router.present(AppRoute.form)","","\/\/ Sheet without a NavigationStack (single view only)","router.present(AppRoute.form, withStack: false)","","\/\/ Full-screen cover (always has its own stack)","router.cover(AppRoute.onboarding)"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"How do I share a router between views?","anchor":"How-do-I-share-a-router-between-views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/NavigationBasics","type":"reference","isActive":true},{"type":"text","text":" for accessing the router via "},{"code":"@Environment(\\.router)","type":"codeVoice"},{"type":"text","text":", and "},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DefiningRoutes","type":"reference","isActive":true},{"type":"text","text":" for injecting it into ViewModels via a "},{"code":"RouteDestination","type":"codeVoice"},{"type":"text","text":" wrapper."}]},{"type":"thematicBreak"},{"type":"heading","text":"Why use RouteContext instead of callbacks?","anchor":"Why-use-RouteContext-instead-of-callbacks","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Callbacks (closures passed as parameters) are a common pattern for passing data back from a child view, but they come with drawbacks in a deep navigation hierarchy:"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Callbacks:"}],"type":"strong"}]},{"type":"codeListing","code":["\/\/ Every layer must forward the closure manually","router.push(AppRoute.picker(onSelect: { user in","    self.selectedUser = user","}))"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Couples the route to the callback signature"}]}]},{"content":[{"inlineContent":[{"text":"Must be threaded through every intermediate view","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hard to refactor when the hierarchy changes","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"RouteContext:","type":"text"}],"type":"strong"}]},{"type":"codeListing","code":["\/\/ Parent registers once",".routerContext(UserSelectionContext.self) { context in","    selectedUser = context.selectedUser","}","","\/\/ Child sends when done, regardless of depth","router.terminate(UserSelectionContext(selectedUser: user))"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Decoupled: sender and receiver don’t reference each other"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Propagates up through the entire router hierarchy automatically","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Works the same whether the child is one or five levels deep","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enables "},{"type":"codeVoice","code":"terminate(_:)"},{"type":"text","text":" to handle both data passing and navigation in one call"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Use callbacks for simple, same-level communication. Use ","type":"text"},{"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","type":"reference","isActive":true},{"text":" when data needs to travel up multiple levels or when the navigation flow should complete on context delivery.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"Known Limitations and Unsupported Cases","anchor":"Known-Limitations-and-Unsupported-Cases","level":2},{"type":"heading","text":"Multiple simultaneous modals","anchor":"Multiple-simultaneous-modals","level":3},{"type":"paragraph","inlineContent":[{"text":"SwiftRouting supports one sheet or cover at a time per router. Presenting a second modal while one is already active is not supported and will replace the current presentation.","type":"text"}]},{"type":"codeListing","code":["\/\/ ❌ Unsupported — only one modal per router at a time","router.present(AppRoute.sheet1)","router.present(AppRoute.sheet2) \/\/ replaces sheet1"],"syntax":"swift"},{"type":"heading","text":"Mixing route types across RoutingView boundaries","anchor":"Mixing-route-types-across-RoutingView-boundaries","level":3},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"text":" is bound to a single ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination"},{"text":" type. You cannot push a route from one enum into a ","type":"text"},{"type":"codeVoice","code":"RoutingView"},{"text":" configured for another.","type":"text"}]},{"type":"codeListing","code":["\/\/ ❌ Wrong — SettingsRoute pushed into a HomeRoute RoutingView","router.push(SettingsRoute.profile)"],"syntax":"swift"},{"type":"heading","text":"Back navigation with a count greater than the stack size","anchor":"Back-navigation-with-a-count-greater-than-the-stack-size","level":3},{"type":"paragraph","inlineContent":[{"text":"Calling ","type":"text"},{"code":"back()","type":"codeVoice"},{"text":" on an empty stack or with a count exceeding the current path length has no effect. SwiftRouting does not crash in this case, but the