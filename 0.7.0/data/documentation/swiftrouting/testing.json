{"abstract":[{"type":"text","text":"Learn how to write unit tests for your navigation logic."}],"topicSections":[{"identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/TabRouterModel","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/DeeplinkHandler","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext"],"anchor":"Related","title":"Related"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/testing"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"SwiftRouting is designed with testability in mind. The protocol-based architecture allows you to mock routers and verify navigation behavior without running UI tests.","type":"text"}],"type":"paragraph"},{"anchor":"Testing-Strategies","level":2,"type":"heading","text":"Testing Strategies"},{"anchor":"Strategy-1-RouterSpy","level":3,"type":"heading","text":"Strategy 1: RouterSpy"},{"inlineContent":[{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" has grown a fair amount of surface (push, present, cover, context handling, split selections…), so hand-rolling a mock for every test is tedious and easy to let drift out of sync with the protocol. Add the companion package instead:"}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/lowki93\/swift-routing.git\", .upToNextMajor(from: \"0.2.0\"))","]"],"type":"codeListing"},{"syntax":"swift","code":[".product(name: \"SwiftRoutingTestSupport\", package: \"swift-routing\")"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"RouterSpy"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"RouterModel"},{"type":"text","text":" and records every call instead of performing real navigation:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftRoutingTestSupport","","let spy = RouterSpy(root: AppRoute.home)","spy.push(AppRoute.profile(userId: \"123\"))","","#expect(spy.pushedRoutes.count == 1)","#expect((spy.pushedRoutes.first as? AppRoute) == .profile(userId: \"123\"))"],"type":"codeListing"},{"inlineContent":[{"text":"Available recorded state: ","type":"text"},{"code":"pushedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"presentedRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"coveredRoutes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"updatedRoots","type":"codeVoice"},{"text":", ","type":"text"},{"code":"routedDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"backCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popToRootCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"closeCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"closeChildrenCallCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"terminatedContexts","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dispatchedContexts","type":"codeVoice"},{"text":", ","type":"text"},{"code":"addedContextTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"removedContextTypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"detailSelections","type":"codeVoice"},{"text":", ","type":"text"},{"code":"contentSelections","type":"codeVoice"},{"text":" — plus live ","type":"text"},{"code":"currentRoute","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"pathCount","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"detailSelection","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"contentSelection","type":"codeVoice"},{"text":" that update as calls happen.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"codeVoice","code":"tabRouter(for:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"findRouterInTabRouter(for:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"deepestRouter()"},{"type":"text","text":" always return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on "},{"type":"codeVoice","code":"RouterSpy"},{"type":"text","text":" — there’s no real router hierarchy behind it. Test code that depends on those against a real "},{"type":"codeVoice","code":"Router"},{"type":"text","text":" instead."}]}]},{"text":"Strategy 2: Test ViewModel Navigation","level":3,"anchor":"Strategy-2-Test-ViewModel-Navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Inject the spy into your ViewModel:"}],"type":"paragraph"},{"code":["@MainActor","final class ProfileViewModel {","    private let router: any RouterModel","    private let userId: String","    ","    init(router: any RouterModel, userId: String) {","        self.router = router","        self.userId = userId","    }","    ","    func editProfile() {","        router.push(ProfileRoute.edit(userId: userId))","    }","    ","    func openSettings() {","        router.present(ProfileRoute.settings)","    }","    ","    func logout() {","        router.popToRoot()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Test the navigation behavior:"}],"type":"paragraph"},{"code":["import Testing","","@Suite(\"ProfileViewModel Navigation\")","struct ProfileViewModelTests {","    ","    @Test","    @MainActor","    func editProfile_pushesEditRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.editProfile()","        ","        #expect(spy.pushedRoutes.count == 1)","        let pushedRoute = spy.pushedRoutes.first as? ProfileRoute","        #expect(pushedRoute == .edit(userId: \"123\"))","    }","    ","    @Test","    @MainActor","    func openSettings_presentsSettingsRoute() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.openSettings()","        ","        #expect(spy.presentedRoutes.count == 1)","        let presentedRoute = spy.presentedRoutes.first?.route as? ProfileRoute","        #expect(presentedRoute == .settings)","    }","    ","    @Test","    @MainActor","    func logout_popsToRoot() {","        let spy = RouterSpy(root: ProfileRoute.overview)","        let viewModel = ProfileViewModel(router: spy, userId: \"123\")","        ","        viewModel.logout()","        ","        #expect(spy.popToRootCallCount == 1)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Testing RouteContext","anchor":"Testing-RouteContext"},{"type":"heading","level":3,"text":"Testing Context Sending","anchor":"Testing-Context-Sending"},{"code":["@Test","@MainActor","func selectUser_terminatesWithContext() {","    let spy = RouterSpy(root: AppRoute.userPicker)","    let viewModel = UserPickerViewModel(router: spy)","    let user = User(id: \"1\", name: \"John\")","    ","    viewModel.selectUser(user)","    ","    #expect(spy.terminatedContexts.count == 1)","    let context = spy.terminatedContexts.first as? UserSelectionContext","    #expect(context?.selectedUser.id == \"1\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Testing Context Reception","anchor":"Testing-Context-Reception"},{"inlineContent":[{"type":"text","text":"For testing context handlers, use a real "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"code":["@Test","@MainActor","func contextHandler_receivesContext() async {","    let router = Router(configuration: .default)","    var receivedUser: User?","    ","    router.add(context: UserSelectionContext.self) { context in","        receivedUser = context.selectedUser","    }","    ","    let user = User(id: \"1\", name: \"John\")","    router.context(UserSelectionContext(selectedUser: user))","    ","    #expect(receivedUser?.id == \"1\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Testing Deep Links","anchor":"Testing-Deep-Links"},{"type":"heading","level":3,"text":"Testing DeeplinkHandler","anchor":"Testing-DeeplinkHandler"},{"code":["struct TestDeeplinkHandler: DeeplinkHandler {","    typealias R = DeeplinkIdentifier","    typealias D = AppRoute","    ","    func deeplink(from route: DeeplinkIdentifier) async throws -> DeeplinkRoute<AppRoute>? {","        switch route {","        case .home:","            return .push(.home)","        case .profile(let userId):","            return .push(.profile(userId: userId))","        case .settings:","            return .present(.settings)","        default:","            return nil","        }","    }","}","","@Suite(\"DeeplinkHandler\")","struct DeeplinkHandlerTests {","    ","    @Test","    func homeIdentifier_returnsPushHome() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .home)","        ","        #expect(deeplink?.route == .home)","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func profileIdentifier_returnsPushWithUserId() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .profile(userId: \"123\"))","        ","        #expect(deeplink?.route == .profile(userId: \"123\"))","        #expect(deeplink?.type == .push)","    }","    ","    @Test","    func settingsIdentifier_returnsPresent() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .settings)","        ","        #expect(deeplink?.route == .settings)","        #expect(deeplink?.type == .sheet(withStack: true))","    }","    ","    @Test","    func unknownIdentifier_returnsNil() async throws {","        let handler = TestDeeplinkHandler()","        ","        let deeplink = try await handler.deeplink(from: .unknown)","        ","        #expect(deeplink == nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Testing DeeplinkRoute Factories","anchor":"Testing-DeeplinkRoute-Factories"},{"type":"codeListing","syntax":"swift","code":["@Suite(\"DeeplinkRoute Factories\")","struct DeeplinkRouteFactoryTests {","    ","    @Test","    func push_createsCorrectDeeplink() {","        let deeplink: DeeplinkRoute<AppRoute> = .push(.home, path: [.list])","        ","        #expect(deeplink.route == .home)","        #expect(deeplink.type == .push)","        #expect(deeplink.path.count == 1)","    }","    ","    @Test","    func popToRoot_hasNilRoute() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot()","        ","        #expect(deeplink.route == nil)","    }","    ","    @Test","    func popToRootWithRoot_setsRoot() {","        let deeplink: DeeplinkRoute<AppRoute> = .popToRoot(root: .dashboard)","        ","        #expect(deeplink.root == .dashboard)","        #expect(deeplink.route == nil)","    }","}"]},{"type":"heading","anchor":"Testing-TabRouter-Navigation","text":"Testing TabRouter Navigation","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TabRouterSpy"},{"type":"text","text":", from the same "},{"type":"codeVoice","code":"SwiftRoutingTestSupport"},{"type":"text","text":" package, conforms to "},{"type":"codeVoice","code":"TabRouterModel"},{"type":"text","text":" the same way:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftRoutingTestSupport","","@Test","@MainActor","func crossTabNavigation_pushesToCorrectTab() {","    let spy = TabRouterSpy(root: AppRoute.home)","    let viewModel = HomeViewModel(tabRouter: spy)","    ","    viewModel.goToProfile(userId: \"123\")","    ","    #expect(spy.pushedRoutes.count == 1)","    let call = spy.pushedRoutes.first","    #expect((call?.route as? AppRoute) == .profile(userId: \"123\"))","    #expect((call?.tab as? AppTab) == .profile)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available recorded state: "},{"type":"codeVoice","code":"changedTabs"},{"type":"text","text":", "},{"type":"codeVoice","code":"pushedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"presentedRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"coveredRoutes"},{"type":"text","text":", "},{"type":"codeVoice","code":"updatedRoots"},{"type":"text","text":", "},{"type":"codeVoice","code":"popToRootTabs"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Best-Practices","text":"Best Practices","level":2},{"type":"heading","anchor":"Use-Protocol-Types","text":"Use Protocol Types","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always inject "},{"type":"codeVoice","code":"any RouterModel"},{"type":"text","text":" or "},{"type":"codeVoice","code":"any TabRouterModel"},{"type":"text","text":" instead of concrete types:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Good: Protocol type enables mocking","init(router: any RouterModel) { ... }","","\/\/ Avoid: Concrete type is harder to test","init(router: Router) { ... }"]},{"type":"heading","anchor":"Test-Navigation-Intent-Not-Implementation","text":"Test Navigation Intent, Not Implementation","level":3},{"type":"paragraph","inlineContent":[{"text":"Focus on ","type":"text"},{"inlineContent":[{"type":"text","text":"what"}],"type":"emphasis"},{"text":" navigation should happen, not ","type":"text"},{"inlineContent":[{"type":"text","text":"how"}],"type":"emphasis"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Good: Tests the intent","#expect(spy.pushedRoutes.contains { ($0 as? AppRoute) == .profile(userId: \"123\") })","","\/\/ Avoid: Testing implementation details","#expect(spy.pathCount == 2)"]},{"type":"heading","anchor":"Prefer-RouterSpy-Over-Hand-Rolled-Mocks","text":"Prefer RouterSpy Over Hand-Rolled Mocks","level":3},{"type":"paragraph","inlineContent":[{"code":"RouterModel","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"TabRouterModel","type":"codeVoice"},{"text":" have grown a fair amount of surface, and a hand-rolled mock silently drifts out of sync every time the protocol changes. ","type":"text"},{"code":"RouterSpy","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"TabRouterSpy","type":"codeVoice"},{"text":" are tested against the real protocols, so use them instead of writing your own unless a test needs custom behavior a spy can’t express.","type":"text"}]},{"type":"heading","anchor":"Test-Async-Handlers","text":"Test Async Handlers","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep link handlers are async. Use Swift Testing’s async support:"}]},{"type":"codeListing","syntax":"swift","code":["@Test","func asyncDeeplinkHandler() async throws {","    let handler = MyDeeplinkHandler()","    let result = try await handler.deeplink(from: .someIdentifier)","    #expect(result != nil)","}"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Testing"},"metadata":{"modules":[{"name":"SwiftRouting"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Testing Navigation"},"references":{"doc://SwiftRouting/documentation/SwiftRouting/Router":{"type":"topic","abstract":[{"type":"text","text":"Manages programmatic navigation for both stack-based and split-view contexts."}],"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Router","navigatorTitle":[{"text":"Router","kind":"identifier"}],"kind":"symbol","url":"\