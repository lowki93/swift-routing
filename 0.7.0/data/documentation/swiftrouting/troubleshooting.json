{"seeAlsoSections":[{"generated":true,"anchor":"Support","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/FAQ"],"title":"Support"}],"identifier":{"url":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Troubleshooting","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"Troubleshooting","role":"collectionGroup","modules":[{"name":"SwiftRouting"}],"roleHeading":"API Collection"},"kind":"article","topicSections":[{"anchor":"Related","identifiers":["doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Configuration","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContext","doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouterModel"],"title":"Related"}],"abstract":[{"type":"text","text":"Diagnose and fix common issues encountered when using SwiftRouting."}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This article covers the most common errors and unexpected behaviors you may encounter, along with their causes and solutions."}],"type":"paragraph"},{"text":"Route Not Found","anchor":"Route-Not-Found","type":"heading","level":2},{"text":"Symptom","anchor":"Symptom","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A route is pushed but no view appears, or an error message is displayed:"}],"type":"paragraph"},{"code":["Route 'DetailRoute' are not define in 'HomeRoute'"],"type":"codeListing","syntax":null},{"text":"Cause","anchor":"Cause","type":"heading","level":3},{"inlineContent":[{"text":"SwiftRouting renders an error view when the resolved route cannot be cast to the expected ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteDestination"},{"text":" type. This typically happens when a route from one enum is pushed into a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"text":" configured for a different destination.","type":"text"}],"type":"paragraph"},{"text":"Solution","anchor":"Solution","type":"heading","level":3},{"inlineContent":[{"text":"Ensure the pushed route matches the destination type of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView"},{"text":" it targets:","type":"text"}],"type":"paragraph"},{"code":["\/\/ ✅ Correct — route and destination match","router.push(HomeRoute.detail(id: 42))","","\/\/ ❌ Wrong — route type doesn't match the active RoutingView","router.push(SettingsRoute.profile)"],"type":"codeListing","syntax":"swift"},{"text":"ErrorView Behavior","anchor":"ErrorView-Behavior","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When a route cannot be resolved, an error view is rendered. Its behavior depends on "},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/Configuration","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"code":"shouldCrashOnRouteNotFound","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Behavior","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Displays the error message inline as ","type":"text"},{"code":"Text","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Crashes the app with "},{"type":"codeVoice","code":"fatalError"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" during development to catch routing mismatches immediately. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","type":"reference"},{"type":"text","text":" for setup details."}],"type":"paragraph"},{"text":"Context Not Received","anchor":"Context-Not-Received","type":"heading","level":2},{"inlineContent":[{"text":"If a context is sent but no observer is triggered, check:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The observer is registered ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" the context is sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The observer is registered on the "},{"type":"strong","inlineContent":[{"type":"text","text":"parent"}]},{"type":"text","text":" router, not the child."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The context type matches exactly on both the sender and the observer side.","type":"text"}]}]}]},{"code":["\/\/ Parent — register before navigation","router.add(context: UserSelectionContext.self) { [weak self] context in","    self?.selectedUser = context.selectedUser","}","","\/\/ Child — send context","router.context(UserSelectionContext(selectedUser: user))"],"syntax":"swift","type":"codeListing"},{"text":"Memory Leaks with Contexts","anchor":"Memory-Leaks-with-Contexts","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Retain cycles occur when closures capture "},{"type":"codeVoice","code":"self"},{"type":"text","text":" strongly. Always use "},{"type":"codeVoice","code":"[weak self]"},{"type":"text","text":" when referencing class instances:"}],"type":"paragraph"},{"code":["\/\/ ❌ Retain cycle","router.add(context: MyContext.self) { context in","    self.handle(context)","}","","\/\/ ✅ Correct","router.add(context: MyContext.self) { [weak self] context in","    self?.handle(context)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Observers registered outside of a view lifecycle (e.g., in a ViewModel) must be removed explicitly. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RouteContextGuide","type":"reference"},{"text":" for the full memory management guide.","type":"text"}],"type":"paragraph"},{"text":"Visualizing the Router Hierarchy","anchor":"Visualizing-the-Router-Hierarchy","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When it’s unclear which router owns which tab\/sheet\/cover, what the full navigation stack looks like, or which "},{"code":"RouteContext","type":"codeVoice"},{"type":"text","text":" observers are registered on which router, print the whole hierarchy to the console. Both variants are only available in "},{"code":"DEBUG","type":"codeVoice"},{"type":"text","text":" builds – calls are compiled out entirely in release, so there’s no need to remove them before shipping."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"printRouter(trigger:)"},{"text":" to print the tree on appear and again whenever a value changes, for example the current route:","type":"text"}],"type":"paragraph"},{"code":["content.printRouter(trigger: router.currentRoute)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This prints the tree starting from the top-most router, for example. Every stack-based router gets a "},{"type":"codeVoice","code":"root:"},{"type":"text","text":" line, and a "},{"type":"codeVoice","code":"path:"},{"type":"text","text":" line for anything pushed on top of it (omitted when nothing has been pushed) – so you’re not just seeing the current route in isolation. A split router also gets "},{"type":"codeVoice","code":"content:"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"detail:"},{"type":"text","text":" lines for its column selections, since "},{"type":"codeVoice","code":"current:"},{"type":"text","text":" alone only shows whichever one currently “wins” (an explicit push, then detail, then content):"}],"type":"paragraph"},{"code":["router(app) — current: home","   root: home","├─ tabRouter(hometab) — current: home","│  ├─ router(tab(home)) — current: profile(userId: \"42\")","│  │     root: home","│  │     path: [profile(userId: \"42\")]","│  │     contexts: [UserSelectionContext(profile(userId: \"42\"))]","│  └─ router(tab(settings)) — current: settings","│        root: settings","├─ router(split(sidebar)) — current: player(id: \"42\")","│     root: sidebar","│     content: players(type: .forward)","│     detail: player(id: \"42\")","└─ router(presented(sheet)) — current: onboarding","      root: onboarding"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"printRouterOnChange()"},{"type":"text","text":" to re-print whenever a router in the hierarchy logs a meaningful event (push, present, tab change, router creation\/destruction…), without picking a specific value to watch — including at the very top of the app, before any child router exists yet. This is the noisier of the two variants; routine or redundant events (view appearance, going back, context execution…) are filtered out to keep it from firing multiple times for the same conceptual change:"}],"type":"paragraph"},{"code":["content.printRouterOnChange()"],"syntax":"swift","type":"codeListing"},{"text":"Placement relative to `.environment(\\.router, ...)`","anchor":"Placement-relative-to-environmentrouter-","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Like any modifier reading "},{"type":"codeVoice","code":"@Environment(\\.router)"},{"type":"text","text":", "},{"type":"codeVoice","code":"printRouter*()"},{"type":"text","text":" only sees the router injected by an "},{"type":"codeVoice","code":".environment(\\.router, ...)"},{"type":"text","text":" call that comes "},{"type":"strong","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" it in the modifier chain (i.e. applied further out). If "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" comes first, the modifier is outside its reach and silently falls back to the disconnected default router — it never crashes, it just never prints anything meaningful:"}],"type":"paragraph"},{"code":["\/\/ ❌ Wrong — .environment() is \"inside\" printRouterOnChange(); the modifier","\/\/ never sees the real router and instead observes the inert default one.","ChoiceScreen()","    .environment(\\.router, Router(configuration: .default))","    .printRouterOnChange()","","\/\/ ✅ Correct — .environment() is the outermost modifier, so it covers","\/\/ printRouterOnChange() too.","ChoiceScreen()","    .printRouterOnChange()","    .environment(\\.router, Router(configuration: .default))"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftRouting\/documentation\/SwiftRouting"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftrouting\/troubleshooting"]}],"references":{"doc://SwiftRouting/documentation/SwiftRouting/ConfigurationGuide":{"title":"Configuration and Logging","type":"topic","role":"collectionGroup","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/ConfigurationGuide","kind":"article","abstract":[{"text":"Learn how to configure SwiftRouting and customize logging behavior.","type":"text"}],"url":"\/documentation\/swiftrouting\/configurationguide"},"doc://SwiftRouting/documentation/SwiftRouting/RoutingView":{"navigatorTitle":[{"text":"RoutingView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftRouting\/documentation\/SwiftRouting\/RoutingView","title":"RoutingView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Routi